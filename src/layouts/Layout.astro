---
import { Icon } from "@lucide/astro";
import MetaTags from "#/components/MetaTags.astro";
import "#/styles/theme.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const year = new Date().getFullYear();
const SOCIALS = [
  { label: "GitHub", href: "https://github.com/jwstn" },
  { label: "Bluesky", href: "https://bsky.app/profile/jwstn.bsky.social" },
] as const;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const navItems = [
  { label: "Projects", href: "/projects" },
  { label: "Blog", href: "/blog" },
  { label: "Gallery", href: "/gallery" },
  { label: "Music", href: "/music" },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<html lang="en" class="theme-isometric">
  <head>
    <MetaTags title={title} description={description} />
  </head>
  <body class="bg-background text-foreground font-body">
    <a class="iso-skip" href="#iso-main">Skip to content</a>

    <header class="iso-header">
      <div class="iso-shell">
        <div class="iso-plate iso-slab iso-rise">
          <a class="iso-key iso-key--logo" href="/" aria-current={path === "/" ? "page" : undefined}>
            jwstn.dev
          </a>

          <button
            class="iso-burger"
            id="iso-burger"
            type="button"
            aria-expanded="false"
            aria-controls="iso-mobile-nav"
            aria-label="Open menu"
          >
            <span class="iso-burger-icon" aria-hidden="true"></span>
          </button>

          <nav class="iso-keys iso-keys--desktop" aria-label="Main navigation">
            {
              navItems.map((item) => (
                <a
                  class="iso-key"
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <nav class="iso-keys iso-keys--desktop" aria-label="Social links">
            {
              SOCIALS.map((s) => (
                <a class="iso-key iso-key--ghost" href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label} <Icon name="external-link" size={12} />
                </a>
              ))
            }
          </nav>
        </div>

        <div class="iso-mobile-panel" id="iso-mobile-nav" hidden>
          <nav class="iso-mobile-keys" aria-label="Main navigation">
            {
              navItems.map((item) => (
                <a
                  class="iso-key"
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <nav class="iso-mobile-keys iso-mobile-keys--social" aria-label="Social links">
            {
              SOCIALS.map((s) => (
                <a class="iso-key iso-key--ghost" href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label} <Icon name="external-link" size={12} />
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </header>

    <main id="iso-main" class="iso-main">
      <slot />
    </main>

    <footer class="iso-footer">
      <div class="iso-shell">
        <p class="iso-copyright">&copy; {year} jwstn</p>
      </div>
    </footer>


    <script>
      // Mobile navigation: a burger on the control-panel plate. Event
      // delegation keeps it working across view transitions; state resets on
      // every page load.
      const panel = () => document.getElementById("iso-mobile-nav");
      const burger = () => document.getElementById("iso-burger");

      const setOpen = (open: boolean) => {
        const p = panel();
        const b = burger();
        if (!p || !b) return;
        p.hidden = !open;
        b.setAttribute("aria-expanded", String(open));
        b.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        b.classList.toggle("is-open", open);
        // the header plate's back bar follows the menu state (never hover)
        document.querySelector(".iso-header")?.classList.toggle("is-menu-open", open);
      };

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest("#iso-burger")) {
          setOpen(panel()?.hidden ?? true);
          return;
        }
        if (panel()?.hidden === false) {
          if (target.closest("#iso-mobile-nav a")) {
            setOpen(false);
            return;
          }
          // anywhere outside the open panel closes it
          if (!target.closest("#iso-mobile-nav")) setOpen(false);
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || panel()?.hidden !== false) return;
        setOpen(false);
        burger()?.focus();
      });

      // desktop widths don't use the panel; close it if the viewport grows
      const desktop = window.matchMedia("(min-width: 48rem)");
      desktop.addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });

      document.addEventListener("astro:page-load", () => setOpen(false));
    </script>
  </body>
</html>
