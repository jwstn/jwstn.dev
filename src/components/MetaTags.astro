---
// Shared <head> partial for all non-classic themes. Themes import this from
// their Layout and add their own fonts/theme.css next to it.
import "#/styles/base.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  /** Set false if the theme's animations misbehave with view transitions. */
  transitions?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, transitions = true } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
<meta name="supported-color-schemes" content="light dark" />

<link rel="canonical" href={canonicalURL} />
<title>{title}</title>
<meta name="title" content={title} />
{description && <meta name="description" content={description} />}
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="twitter:card" content="summary" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
{description && <meta property="twitter:description" content={description} />}

{transitions && <ClientRouter />}

<script is:inline>
  // Apply light/dark mode before first paint. Uses the same localStorage key
  // ("theme") as the classic theme, falling back to the OS preference.
  // Wrapped in an IIFE: view transitions re-execute inline scripts, and a bare
  // top-level const would collide with itself on the second run.
  (() => {
    const applyMode = (mode) => {
      document.documentElement.classList.toggle("dark", mode === "dark");
    };
    const currentMode = () => {
      const saved = localStorage.getItem("theme");
      if (saved) return saved;
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    };
    applyMode(currentMode());
    document.addEventListener("astro:page-load", () => applyMode(currentMode()));
  })();
</script>
