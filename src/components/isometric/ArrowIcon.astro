---
interface Props {
  size?: number;
}
const { size = 16 } = Astro.props;
---
<span class="iso-icon" aria-hidden="true" style={`width:${size}px;height:${size}px`}>
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3 8h10M9 4l4 4-4 4"></path>
  </svg>
</span>

<style>
  .iso-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .iso-icon svg {
    width: 100%;
    height: 100%;
  }
</style>
