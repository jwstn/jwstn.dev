---
import { SOCIALS } from "#/lib/content";
import MetaTags from "#/themes/shared/MetaTags.astro";
import ThemeSwitcher from "#/themes/shared/ThemeSwitcher.astro";
import type { LayoutProps } from "#/themes/types";
import "./theme.css";

const { title, description } = Astro.props as LayoutProps;
const year = new Date().getFullYear();

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" || path === "" : path.startsWith(href));

const nav = [
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/gallery", label: "Gallery" },
];
---

<html lang="en" class="theme-claymorphism">
  <head>
    <MetaTags title={title} description={description} />
  </head>
  <body>
    <div class="clay-backdrop" aria-hidden="true">
      <div class="clay-blob clay-blob-1"></div>
      <div class="clay-blob clay-blob-2"></div>
      <div class="clay-blob clay-blob-3"></div>
    </div>

    <header class="clay-header">
      <nav class="clay-nav" aria-label="Primary">
        <a class="clay-brand" href="/">jwstn.dev</a>
        {
          nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
        {
          SOCIALS.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="clay-footer">
      <div class="clay clay-footer-slab">
        <p>&copy; {year} jwstn — shaped in Cologne</p>
        <p class="clay-footer-links">
          {
            SOCIALS.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            ))
          }
        </p>
      </div>
    </footer>

    <ThemeSwitcher />
  </body>
</html>
