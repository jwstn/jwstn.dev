---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { GalleryProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { albums } = Astro.props as GalleryProps;
---

<Layout
  title="Gallery | jwstn.dev"
  description="Photographs by JW — from a Japan trip in 2026 to the seasons back home in Germany."
>
  <section class="clay-article">
    <p class="clay-stamp clay-rise clay-d1">photographs</p>
    <h1 class="clay-h1 clay-rise clay-d2">Gallery</h1>
    <p class="clay-lede clay-rise clay-d3">
      In March 2026 I travelled to Japan with a camera and came home with far too many photos. The
      camera hasn't really been put down since — these albums are the keepsakes, each shot pressed
      into its own clay frame.
    </p>
  </section>

  <ul class="clay-grid">
    {
      albums.map((album, i) => (
        <li class="clay clay-card squish clay-rise" class:list={["clay-d1", "clay-d2", "clay-d3"][i % 3]}>
          {album.data.photos[0] && (
            <div class="clay clay-frame clay-cover">
              <Image
                src={album.data.photos[0].image}
                alt=""
                widths={[480, 800, 1200]}
                sizes="(min-width: 68rem) 20rem, (min-width: 40rem) 42vw, 90vw"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <h2>
            <a class="clay-card-link" href={`/gallery/${album.data.slug}/`}>
              {album.data.title}
            </a>
          </h2>
          <p class="clay-meta">
            <FormattedDate date={album.data.pubDate} />
            <span>
              {album.data.photos.length} photograph{album.data.photos.length === 1 ? "" : "s"}
            </span>
          </p>
        </li>
      ))
    }
  </ul>
</Layout>
