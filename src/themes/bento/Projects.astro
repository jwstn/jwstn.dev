---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectsProps } from "#/themes/types";
import Icon from "./Icon.astro";
import Layout from "./Layout.astro";

const { projects } = Astro.props as ProjectsProps;

// Bento spans by importance: most recent = the big 2×2 cell, then 2×1 each,
// the oldest settles into the full-width flat row card.
const spanFor = (i: number) =>
  i === 0 ? "bento-c2 bento-r2" : i === projects.length - 1 ? "bento-c4 bento-rowcard" : "bento-c2";
---

<Layout
  title="Projects | jwstn.dev"
  description="Things JW has built — a vinyl collectors' forum, a terminal Spotify client, an ASL & DGS trainer, and one very personal note app."
>
  <section class="bento-pagehead">
    <p class="bento-kicker">Work</p>
    <h1 class="bento-h1">Projects.</h1>
    <p class="bento-lede">
      Four builds, shipped or in flight. Most are works in progress on purpose — each one is a
      place to test a technology properly, and the most recent gets the big cell.
    </p>
  </section>

  <ul class="bento-grid">
    {
      projects.map((project, i) => {
        const isWip = project.data.title.includes("(WIP)");
        const wide = i === projects.length - 1;
        return (
          <li class={`bento-card bento-lift ${spanFor(i)}`}>
            <div class={wide ? "bento-rowcard-head" : "bento-card-top"}>
              <span class="bento-ico"><Icon name="folder" /></span>
              <p class="bento-kicker">Project 0{i + 1}</p>
            </div>
            <div class={wide ? "bento-rowcard-body" : undefined}>
              <h2 class="bento-card-title">
                <a href={`/projects/${project.id}/`}>{project.data.title}</a>
              </h2>
              <p class="bento-card-desc">{project.data.description}</p>
              <ul class="bento-chips">
                {project.data.tags.map((tag) => (
                  <li class="bento-chip">{tag}</li>
                ))}
              </ul>
              <p class="bento-card-meta">
                <FormattedDate date={project.data.pubDate} />
                {isWip && <span class="bento-wip">WIP</span>}
                <a href={project.data.href} target="_blank" rel="noopener noreferrer">
                  Visit ↗
                </a>
              </p>
            </div>
          </li>
        );
      })
    }
  </ul>
</Layout>
