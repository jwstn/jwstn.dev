---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { AlbumProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { album } = Astro.props as AlbumProps;
const { title, photos, pubDate } = album.data;
const count = photos.length;

// Mosaic rhythm on the 4-col desktop grid: wide, narrow, narrow — then the
// wide cell slides to the other side, and repeats.
const isWide = (i: number) => [2, 1, 1, 1, 1, 2][i % 6] === 2;
---

<Layout title={`${title} | jwstn.dev`} description={`${title} — ${count} photographs by JW.`}>
  <a class="bento-back" href="/gallery" aria-label="Back to the gallery">← Back to the gallery</a>

  <section class="bento-pagehead">
    <p class="bento-kicker">Album</p>
    <h1 class="bento-h1">{title}</h1>
    <p class="bento-lede">
      {count} photograph{count === 1 ? "" : "s"}, each in its own cell.
    </p>
    <p class="bento-card-meta bento-albummeta">
      <FormattedDate date={pubDate} />
    </p>
  </section>

  <ul class="bento-grid">
    {
      photos.map((photo, i) => {
        const wide = isWide(i);
        return (
          <li class:list={["bento-shot", wide && "bento-shot-wide"]}>
            <figure class="bento-shotcard">
              <div class="bento-cover">
                <Image
                  src={photo.image}
                  alt={photo.title}
                  widths={[480, 800, 1200, 1600]}
                  sizes={
                    wide
                      ? "(min-width: 64rem) 36rem, (min-width: 40rem) 45vw, 92vw"
                      : "(min-width: 64rem) 17.5rem, (min-width: 40rem) 45vw, 92vw"
                  }
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption>
                <span class="bento-shot-title">{photo.title}</span>
                {photo.caption && <span class="bento-shot-caption">{photo.caption}</span>}
              </figcaption>
            </figure>
          </li>
        );
      })
    }
  </ul>
</Layout>
