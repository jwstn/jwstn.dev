---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { GalleryProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { albums } = Astro.props as GalleryProps;

// Newest album gets the tall 2×2 cell, the rest fill 2×1 cells beside it.
const spanFor = (i: number) => (i === 0 ? "bento-c2 bento-r2" : "bento-c2");
---

<Layout
  title="Gallery | jwstn.dev"
  description="Photographs by JW — from a Japan trip in 2026 to the seasons back home in Germany."
>
  <section class="bento-pagehead">
    <p class="bento-kicker">Light</p>
    <h1 class="bento-h1">Gallery.</h1>
    <p class="bento-lede">
      In 2026 the camera went to Japan and came home with far too many photos and no regrets. It
      hasn't really been put down since — these albums are the overflow, plus the seasons back
      home in Germany.
    </p>
  </section>

  <ul class="bento-grid">
    {
      albums.map((album, i) => {
        const cover = album.data.photos[0];
        return (
          <li class={spanFor(i)}>
            <a
              class="bento-card bento-frame bento-lift"
              href={`/gallery/${album.data.slug}/`}
              aria-label={`Open the album ${album.data.title}`}
            >
              {cover && (
                <div class="bento-cover">
                  <Image
                    src={cover.image}
                    alt=""
                    widths={[640, 1024, 1600]}
                    sizes="(min-width: 64rem) 36rem, (min-width: 40rem) 92vw, 92vw"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="bento-bar">
                <p class="bento-kicker">Album 0{i + 1}</p>
                <h2 class="bento-bar-title">{album.data.title}</h2>
                <p class="bento-bar-meta">
                  <FormattedDate date={album.data.pubDate} /> · {album.data.photos.length} photo
                  {album.data.photos.length === 1 ? "" : "s"}
                </p>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>
</Layout>
