---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <a class="bento-back" href="/blog" aria-label="Back to all posts">← All posts</a>

  <section class="bento-pagehead">
    <p class="bento-kicker">Blog</p>
    <h1 class="bento-h1">{title}</h1>
    {description && <p class="bento-lede">{description}</p>}
  </section>

  <div class="bento-grid">
    {
      heroImage && (
        <div class="bento-card bento-frame bento-heroimg bento-c4">
          <div class="bento-cover">
            <Image
              src={heroImage}
              alt=""
              widths={[640, 1024, 1600]}
              sizes="(min-width: 64rem) 72rem, 92vw"
              decoding="async"
            />
          </div>
        </div>
      )
    }

    <article class="bento-card bento-c3">
      <div class="bento-prose">
        <Content />
      </div>
    </article>

    <aside class="bento-card bento-c1 bento-aside" aria-label="Post details">
      <p class="bento-kicker">Details</p>
      <dl class="bento-facts">
        <div class="bento-fact">
          <dt>Published</dt>
          <dd>
            <FormattedDate date={pubDate} />
          </dd>
        </div>
        {
          updatedDate && (
            <div class="bento-fact">
              <dt>Updated</dt>
              <dd>
                <FormattedDate date={updatedDate} />
              </dd>
            </div>
          )
        }
        <div class="bento-fact">
          <dt>More</dt>
          <dd>
            <a class="bento-btn" href="/blog">
              All posts
            </a>
          </dd>
        </div>
      </dl>
    </aside>
  </div>
</Layout>
