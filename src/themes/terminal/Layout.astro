---
import { SOCIALS } from "#/lib/content";
import MetaTags from "#/themes/shared/MetaTags.astro";
import ThemeSwitcher from "#/themes/shared/ThemeSwitcher.astro";
import type { LayoutProps } from "#/themes/types";
import "./theme.css";

// transitions={false}: the boot-sequence typing effect should replay on every
// visit, so this theme opts out of Astro view transitions (full page loads).
const { title, description } = Astro.props as LayoutProps;
const year = new Date().getFullYear();
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const navItems = [
  { label: "projects/", href: "/projects" },
  { label: "blog/", href: "/blog" },
  { label: "gallery/", href: "/gallery" },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<html lang="en" class="theme-terminal">
  <head>
    <MetaTags title={title} description={description} transitions={false} />
  </head>
  <body class="bg-background text-foreground font-mono">
    <a class="term-skip" href="#term-main">skip to main output</a>

    <header class="term-header">
      <div class="term-header-inner">
        <div class="term-titlebar">
          <span class="term-winctl" aria-hidden="true">● ● ●</span>
          <p class="term-title">jwstn@jwstn.dev — ~/www — zsh</p>
          <span class="term-titlemeta" aria-hidden="true">80×24 · crt</span>
        </div>
        <nav class="term-nav" aria-label="Main navigation">
          <span class="term-ps1" aria-hidden="true">jwstn@dev:~$</span>
          <a class="term-nav-link" href="/" aria-current={path === "/" ? "page" : undefined}>jwstn.dev</a>
          {
            navItems.map((item) => (
              <a class="term-nav-link" href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
          {
            SOCIALS.map((s) => (
              <a
                class="term-nav-link term-nav-social"
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {s.label.toLowerCase()} ↗
              </a>
            ))
          }
          <span class="term-cursor" aria-hidden="true"></span>
        </nav>
      </div>
    </header>

    <main id="term-main" class="term-main">
      <slot />
    </main>

    <footer class="term-footer">
      <div class="term-footer-inner">
        <p class="term-cmdline">
          <span class="term-ps1" aria-hidden="true">jwstn@dev:~$</span>
          <span>logout</span>
        </p>
        <p class="term-footer-copy">© {year} jwstn — connection to jwstn.dev closed. [exit 0]</p>
        <nav class="term-footer-socials" aria-label="Social links">
          {
            SOCIALS.map((s) => (
              <a class="term-footer-link" href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label} ↗
              </a>
            ))
          }
        </nav>
      </div>
    </footer>

    <ThemeSwitcher />
  </body>
</html>
