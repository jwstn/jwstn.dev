---
import { Image } from "astro:assets";
import Divider from "./Divider.astro";
import FormattedDate from "#/components/FormattedDate.astro";
import Layout from "./Layout.astro";
import type { GalleryProps } from "#/themes/types";

const { albums } = Astro.props as GalleryProps;
---

<Layout
  title="Gallery | jwstn.dev"
  description="Pictures by JW — camera acquired in Japan, March 2026. ls the albums: japan, spring and summer 2026."
>
  <section aria-label="Gallery">
    <p class="term-cmdline">
      <span class="term-ps1" aria-hidden="true">jwstn@dev:~$</span>
      <span>ls -la ~/gallery</span>
      <span class="term-cmt" aria-hidden="true"># camera: acquired in Japan, March 2026</span>
    </p>
    <h1 class="term-pagetitle">
      ~/gallery <span class="term-cmt term-pagetitle-count">{albums.length} albums</span>
    </h1>
    <Divider />

    <div class="term-stack">
      {
        albums.map((album, i) => (
          <a
            class="term-window term-album term-reveal"
            style={`--d: ${0.15 + i * 0.12}s`}
            href={`/gallery/${album.data.slug}/`}
          >
            <div class="term-titlebar">
              <span class="term-winctl" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="term-winname">{album.data.slug}/</span>
              <span class="term-windate">
                <FormattedDate date={album.data.pubDate} />
              </span>
            </div>
            <div class="term-strip">
              {album.data.photos.slice(0, 4).map((photo) => (
                <Image
                  src={photo.image}
                  alt={photo.title}
                  widths={[160, 320]}
                  sizes="(min-width: 48rem) 9rem, 22vw"
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </div>
            <div class="term-album-info">
              <h2 class="term-album-name">{album.data.title}</h2>
              <p class="term-album-meta">{album.data.photos.length} photos</p>
              <p class="term-album-cta">cd {album.data.slug}/ →</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
