---
import Footer from "#/components/Footer.astro";
import BaseHead from "#/components/Head.astro";
import Header from "#/components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "#/consts";
import ThemeSwitcher from "#/themes/shared/ThemeSwitcher.astro";
import type { LayoutProps } from "#/themes/types";

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props as LayoutProps;
---

<html lang="en" class="theme-classic">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="bg-background w-dvw min-h-dvh">
    <Header />
    <slot />
    <Footer />
    <ThemeSwitcher />
  </body>
</html>
