---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import CardContent from "#/components/ui/card/content.astro";
import CardDescription from "#/components/ui/card/description.astro";
import CardHeader from "#/components/ui/card/header.astro";
import Card from "#/components/ui/card/index.astro";
import CardTitle from "#/components/ui/card/title.astro";
import type { BlogProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { posts } = Astro.props as BlogProps;
---

<Layout title="Blog | jwstn.dev" description="Occasional writing by JW.">
  <main class="typeset">
    <section class="space-y-8">
      {
        posts.map((post) => (
          <Card>
            <a href={`/blog/${post.id}/`} class="no-underline">
              <CardHeader>
                <CardTitle>{post.data.title}</CardTitle>
                <CardDescription>
                  <FormattedDate date={post.data.pubDate} />
                </CardDescription>
              </CardHeader>
              <CardContent>
                {post.data.heroImage && <Image width={720} height={360} src={post.data.heroImage} alt="" />}
              </CardContent>
            </a>
          </Card>
        ))
      }
    </section>
  </main>
</Layout>
