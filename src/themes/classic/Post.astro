---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <main class="max-w-full m-0 w-[calc(100%-2em)]">
    <article>
      <div class="w-full">
        {
          heroImage && (
            <Image class="block mx-auto rounded-md shadow" width={1020} height={510} src={heroImage} alt="" />
          )
        }
      </div>
      <div class="typeset typeset-docs">
        <div class="mb-4 px-0 py-4 text-center leading-4">
          <div class="mb-2 text-muted-foreground">
            <FormattedDate date={pubDate} />
            {
              updatedDate && (
                <div class="italic">
                  Last updated on <FormattedDate date={updatedDate} />
                </div>
              )
            }
          </div>
          <h1 class="mb-2">{title}</h1>
          <hr />
        </div>
        <Content />
      </div>
    </article>
  </main>
</Layout>
