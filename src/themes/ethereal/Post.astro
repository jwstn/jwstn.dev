---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} — jwstn.dev`} description={description}>
  <article class="eth-article">
    <p class="eth-fade">
      <a class="eth-back" href="/blog">&larr; Blog</a>
    </p>

    <header class="eth-fade">
      <p class="eth-kicker">A note</p>
      <h1 class="eth-article-title">{title}</h1>
      <p class="eth-meta">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <span>
              <span aria-hidden="true"> · </span>Revised <FormattedDate date={updatedDate} />
            </span>
          )
        }
      </p>
    </header>

    {
      heroImage && (
        <figure class="eth-memory eth-memory-full eth-heroimg eth-fade eth-fade-2">
          <Image
            src={heroImage}
            alt=""
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 61rem) 40rem, (min-width: 40rem) 90vw, calc(100vw - 2.75rem)"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }

    <div class="eth-prose eth-fade eth-fade-2">
      <Content />
    </div>
  </article>
</Layout>
