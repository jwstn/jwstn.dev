---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { AlbumProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { album } = Astro.props as AlbumProps;
const { title, pubDate, photos } = album.data;

const photoCount = `${photos.length} photograph${photos.length === 1 ? "" : "s"}`;
---

<Layout title={`${title} — jwstn.dev`} description={`Photographs from ${title} — by JW.`}>
  <p class="eth-fade">
    <a class="eth-back" href="/gallery">&larr; Gallery</a>
  </p>

  <header class="eth-fade">
    <p class="eth-kicker">An album</p>
    <h1 class="eth-display">{title}</h1>
    <p class="eth-meta">
      <FormattedDate date={pubDate} />
      <span aria-hidden="true"> · </span>
      {photoCount}
    </p>
  </header>

  <div class="eth-mistline eth-fade" aria-hidden="true"></div>

  <div class="eth-plates eth-fade eth-fade-2">
    {
      photos.map((photo) => (
        <figure class="eth-plate">
          <div class="eth-memory eth-memory-full">
            <Image
              src={photo.image}
              alt={photo.title}
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 61rem) 44rem, (min-width: 40rem) 90vw, calc(100vw - 2.75rem)"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="eth-plate-caption">
            <span class="eth-plate-title">{photo.title}</span>
            {photo.caption && <span class="eth-plate-note">{photo.caption}</span>}
          </figcaption>
        </figure>
      ))
    }
  </div>
</Layout>
