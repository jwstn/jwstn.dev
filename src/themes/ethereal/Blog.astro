---
import FormattedDate from "#/components/FormattedDate.astro";
import type { BlogProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { posts } = Astro.props as BlogProps;
---

<Layout
  title="Blog — jwstn.dev"
  description="Notes by JW, written slowly — pieces on building with Effect, photographs, and lessons from the workbench."
>
  <header class="eth-fade">
    <p class="eth-kicker">Notes set adrift</p>
    <h1 class="eth-display">Blog</h1>
  </header>

  {
    posts.length === 0 ? (
      <section class="eth-panel eth-empty eth-fade eth-fade-2" aria-label="No posts published yet">
        <h2 class="eth-empty-title">Nothing has drifted in yet.</h2>
        <p class="eth-lede">
          The page is quiet air. Notes take their time here — I only write something down once it has
          stopped moving, the way mist settles on a morning field.
        </p>
        <ul class="eth-driftlist">
          <li class="eth-driftrow">
            <span class="eth-drift-title">On Effect, and a new way to write a program</span>
            <span class="eth-drift-status">taking shape</span>
          </li>
          <li class="eth-driftrow">
            <span class="eth-drift-title">A camera in Japan, 2026</span>
            <span class="eth-drift-status">gathering light</span>
          </li>
        </ul>
        <p class="eth-empty-note">
          When a piece is ready it will appear here first — quietly, the way fog arrives.
        </p>
      </section>
    ) : (
      <ol class="eth-list eth-fade eth-fade-2">
        {posts.map((post) => (
          <li>
            <a class="eth-panel eth-row" href={`/blog/${post.id}/`}>
              <span class="eth-row-title">{post.data.title}</span>
              <p class="eth-row-desc">{post.data.description}</p>
              <span class="eth-row-meta">
                <FormattedDate date={post.data.pubDate} />
                {post.data.updatedDate && (
                  <span>Revised <FormattedDate date={post.data.updatedDate} /></span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</Layout>
