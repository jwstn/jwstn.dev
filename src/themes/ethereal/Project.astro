---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { project, Content } = Astro.props as ProjectProps;
const { title, description, pubDate, href, tags } = project.data;
---

<Layout title={`${title} — jwstn.dev`} description={description}>
  <article class="eth-article">
    <p class="eth-fade">
      <a class="eth-back" href="/projects">&larr; Projects</a>
    </p>

    <header class="eth-fade">
      <p class="eth-kicker">A work in progress</p>
      <h1 class="eth-article-title">{title}</h1>
      <p class="eth-meta">
        <FormattedDate date={pubDate} />
        <span aria-hidden="true"> · </span>
        <a href={href} target="_blank" rel="noopener noreferrer">Visit the work ↗</a>
      </p>
    </header>

    <div class="eth-prose eth-fade eth-fade-2">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <div class="eth-chips eth-chips-end" aria-label="Tags">
          {tags.map((tag) => (
            <span class="eth-chip">{tag}</span>
          ))}
        </div>
      )
    }
  </article>
</Layout>
