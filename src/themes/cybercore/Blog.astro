---
import FormattedDate from "#/components/FormattedDate.astro";
import Layout from "./Layout.astro";
import type { BlogProps } from "#/themes/types";

const { posts } = Astro.props as BlogProps;
---

<Layout
  title="Blog | jwstn.dev"
  description="The mission log — transmissions by JW. Currently 0 entries: the buffer is open, nothing has been logged yet."
>
  <section class="cy-pagehead" aria-label="Blog">
    <p class="cy-kicker cy-reveal">// transmission record — newest first</p>
    <h1 class="cy-title cy-bootglitch cy-glitch">Mission log</h1>
    <p class="cy-count">{posts.length} entries logged</p>
    <div class="cy-tape" aria-hidden="true"></div>
  </section>

  {
    posts.length === 0 ? (
      <div class="cy-frame cy-reveal" style="--d: 0.12s">
        <p class="cy-panel-head">
          log buffer <span class="cy-stamp cy-stamp--hazard">[EMPTY]</span>
        </p>
        <div class="cy-panel-body">
          <ul class="cy-readouts">
            <li class="cy-readout">
              <span class="cy-readout-key">entries logged</span>
              <span class="cy-readout-rule" aria-hidden="true" />
              <span class="cy-readout-val">0</span>
            </li>
            <li class="cy-readout">
              <span class="cy-readout-key">last transmission</span>
              <span class="cy-readout-rule" aria-hidden="true" />
              <span class="cy-readout-val">—</span>
            </li>
            <li class="cy-readout">
              <span class="cy-readout-key">buffer status</span>
              <span class="cy-readout-rule" aria-hidden="true" />
              <span class="cy-readout-val">open — awaiting first entry</span>
            </li>
          </ul>
          <h2 class="cy-empty-code cy-glitch">no entries logged</h2>
          <p class="cy-empty-text">
            The log is mounted and recording, but no transmission has been filed yet. Drafts are in
            processing; when one clears review it will be written to this buffer, newest first. Until then
            the archive stands ready.
          </p>
          <p class="cy-actions">
            <a class="cy-btn" href="/projects/">proceed to mission archive →</a>
            <a class="cy-btn cy-btn--ghost" href="/gallery/">view recon imagery →</a>
          </p>
        </div>
      </div>
    ) : (
      <ul class="cy-loglist">
        {posts.map((post, i) => (
          <li class="cy-frame cy-reveal" style={`--d: ${0.12 + i * 0.1}s`}>
            <a class="cy-loglist-link" href={`/blog/${post.id}/`}>
              <h2 class="cy-loglist-title">{post.data.title}</h2>
              <p class="cy-loglist-meta">
                logged <FormattedDate date={post.data.pubDate} />
                {post.data.updatedDate && (
                  <>
                    — revised <FormattedDate date={post.data.updatedDate} />
                  </>
                )}
              </p>
              <p class="cy-loglist-meta">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Layout>
