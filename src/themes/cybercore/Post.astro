---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import Layout from "./Layout.astro";
import type { PostProps } from "#/themes/types";

// Unreachable for now (the blog collection is empty), but kept complete:
// this is exactly how a logged transmission would render.
const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <article aria-label={title}>
    <section class="cy-pagehead" aria-label="Log entry header">
      <p class="cy-kicker cy-reveal">// log entry — {post.id}</p>
      <h1 class="cy-title cy-bootglitch cy-glitch">{title}</h1>
    </section>

    <div class="cy-reveal" style="--d: 0.1s">
      <div class="cy-frame">
        <p class="cy-panel-head">transmission record</p>
        <div class="cy-panel-body">
          <ul class="cy-readouts">
            <li class="cy-readout">
              <span class="cy-readout-key">logged</span>
              <span class="cy-readout-rule" aria-hidden="true"></span>
              <span class="cy-readout-val"><FormattedDate date={pubDate} /></span>
            </li>
            {
              updatedDate && (
                <li class="cy-readout">
                  <span class="cy-readout-key">revised</span>
                  <span class="cy-readout-rule" aria-hidden="true" />
                  <span class="cy-readout-val">
                    <FormattedDate date={updatedDate} />
                  </span>
                </li>
              )
            }
            <li class="cy-readout">
              <span class="cy-readout-key">abstract</span>
              <span class="cy-readout-rule" aria-hidden="true"></span>
              <span class="cy-readout-val">{description}</span>
            </li>
          </ul>
          {
            heroImage && (
              <Image
                src={heroImage}
                alt=""
                widths={[800, 1200, 1600]}
                sizes="(min-width: 72rem) 46rem, 92vw"
                class="cy-heroimg"
              />
            )
          }
        </div>
      </div>
    </div>

    <div class="cy-tape" aria-hidden="true"></div>

    <div class="cy-prose cy-reveal" style="--d: 0.16s">
      <Content />
    </div>

    <p>
      <a class="cy-backlink" href="/blog/">← return to mission log</a>
    </p>
  </article>
</Layout>
