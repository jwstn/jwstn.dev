---
import FormattedDate from "#/components/FormattedDate.astro";
import Layout from "./Layout.astro";
import type { ProjectProps } from "#/themes/types";

const { project, Content } = Astro.props as ProjectProps;
const { title, description, pubDate, href, tags } = project.data;

const status = title.startsWith("(WIP)") ? "wip" : "active";
const fileTitle = title.replace(/^\(WIP\)\s*/, "");
---

<Layout title={`${fileTitle} | jwstn.dev`} description={description}>
  <article aria-label={fileTitle}>
    <section class="cy-pagehead" aria-label="Mission file header">
      <p class="cy-kicker cy-reveal">// mission file — {project.id}</p>
      <h1 class="cy-title cy-bootglitch cy-glitch">{fileTitle}</h1>
    </section>

    <div class="cy-reveal" style="--d: 0.1s">
      <div class="cy-frame">
        <p class="cy-panel-head">
          dossier <span class={`cy-stamp cy-stamp--${status}`}>[{status === "wip" ? "WIP" : "ACTIVE"}]</span>
        </p>
        <div class="cy-panel-body">
          <ul class="cy-readouts">
            <li class="cy-readout">
              <span class="cy-readout-key">logged</span>
              <span class="cy-readout-rule" aria-hidden="true"></span>
              <span class="cy-readout-val"><FormattedDate date={pubDate} /></span>
            </li>
            <li class="cy-readout">
              <span class="cy-readout-key">classification</span>
              <span class="cy-readout-rule" aria-hidden="true"></span>
              <span class="cy-readout-val">{status === "wip" ? "work in progress" : "active build"}</span>
            </li>
            <li class="cy-readout">
              <span class="cy-readout-key">abstract</span>
              <span class="cy-readout-rule" aria-hidden="true"></span>
              <span class="cy-readout-val">{description}</span>
            </li>
          </ul>
          <ul class="cy-chips" aria-label="Tags">
            {tags.map((tag) => <li>{tag}</li>)}
          </ul>
          <p class="cy-actions">
            <a class="cy-btn" href={href} target="_blank" rel="noopener noreferrer">external link ↗</a>
          </p>
        </div>
      </div>
    </div>

    <div class="cy-tape" aria-hidden="true"></div>

    <div class="cy-prose cy-reveal" style="--d: 0.16s">
      <Content />
    </div>

    <p>
      <a class="cy-backlink" href="/projects/">← return to archive</a>
    </p>
  </article>
</Layout>
