---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { GalleryProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { albums } = Astro.props as GalleryProps;
---

<Layout title="Gallery | jwstn.dev" description="Pictures JW took with a camera bought in Japan.">
  <main class="n-main">
    <header class="n-page-head">
      <p class="n-kicker n-rise" style="--d: 0s">// sector_03 &middot; optics</p>
      <h1 class="n-page-title n-rise" style="--d: 0.08s">Gallery</h1>
      <p class="n-page-lede n-rise" style="--d: 0.16s">
        On my trip to Japan in March 2026 I finally bought a camera &mdash; I&rsquo;d wanted one for years. Every
        frame since then lands in these albums.
      </p>
    </header>

    <ul class="n-album-grid">
      {
        albums.map((album) => {
          const cover = album.data.photos[0];
          return (
            <li>
              <a class="n-panel n-album" href={`/gallery/${album.data.slug}/`}>
                <span class="n-album-frame">
                  <Image
                    class="n-album-img"
                    src={cover.image}
                    alt={cover.title}
                    widths={[480, 800]}
                    sizes="(min-width: 24rem) 22rem, 92vw"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="n-album-body">
                  <span class="n-card-title n-aberr">{album.data.title}</span>
                  <span class="n-project-meta">
                    <FormattedDate date={album.data.pubDate} />
                    <span>{album.data.photos.length} frames</span>
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </main>
</Layout>
