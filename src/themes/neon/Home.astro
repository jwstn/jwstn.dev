---
import type { HomeProps } from "#/themes/types";
import Layout from "./Layout.astro";

const {} = Astro.props as HomeProps;
---

<Layout
  title="Welcome | jwstn.dev"
  description="JW's personal site — full-stack projects from Cologne, the odd transmission, and photos from the Japan 2026 camera trip."
>
  <main class="n-main">
    <section class="n-hero">
      <p class="n-kicker n-rise" style="--d: 0s">// signal incoming — cologne, de</p>
      <h1 class="n-hero-title">
        <span class="n-rise" style="--d: 0.08s">JW &middot; full-stack dev,</span>
        <span class="n-grad n-rise" style="--d: 0.16s">Cologne on the wire</span>
      </h1>
      <p class="n-hero-sub n-rise" style="--d: 0.24s">
        I build web applications with <a href="https://tanstack.com/" target="_blank" rel="noopener noreferrer">TanStack</a>.
        On the test bench so far: <a href="https://effect.website/" target="_blank" rel="noopener noreferrer">Effect</a> &mdash;
        amazing fun, and proof there&rsquo;s more than one way to wire a program. Still queued for a ride:
        <a href="https://hono.dev/" target="_blank" rel="noopener noreferrer">Hono</a> and
        <a href="https://elysiajs.com/" target="_blank" rel="noopener noreferrer">Elysia</a>. When the console dims,
        I&rsquo;m behind a camera picked up in Japan in March 2026.
      </p>
      <p class="n-status n-rise" style="--d: 0.32s">
        <span class="n-dot" aria-hidden="true"></span>
        systems nominal &middot; 4 projects in the grid &middot; blog frequency: quiet
      </p>

      <ul class="n-districts n-rise" style="--d: 0.4s">
        <li>
          <a class="n-panel n-card" href="/projects/">
            <span class="n-card-index">01</span>
            <h2 class="n-card-title n-aberr">Projects</h2>
            <p class="n-card-blurb">
              Four builds lit up on the board &mdash; a vinyl forum, a terminal jukebox, a note app with history, and
              an ASL trainer.
            </p>
            <span class="n-card-cta">enter sector &rarr;</span>
          </a>
        </li>
        <li>
          <a class="n-panel n-card" href="/gallery/">
            <span class="n-card-index">02</span>
            <h2 class="n-card-title n-aberr">Gallery</h2>
            <p class="n-card-blurb">
              Frames from a camera bought on my Japan trip in March 2026 &mdash; cherry blossoms, highland cows and
              the best boy.
            </p>
            <span class="n-card-cta">open feed &rarr;</span>
          </a>
        </li>
        <li>
          <a class="n-panel n-card" href="/blog/">
            <span class="n-card-index">03</span>
            <h2 class="n-card-title n-aberr">Blog</h2>
            <p class="n-card-blurb">
              Transmission log currently dark. The antenna&rsquo;s up &mdash; the first broadcast lands here when
              it&rsquo;s ready.
            </p>
            <span class="n-card-cta">check frequency &rarr;</span>
          </a>
        </li>
      </ul>
    </section>
  </main>
</Layout>
