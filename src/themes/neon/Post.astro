---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <main class="n-main">
    <p class="n-back">
      <a class="n-btn" href="/blog/">&larr; sector_02 &middot; all transmissions</a>
    </p>

    <header class="n-page-head">
      <p class="n-kicker n-rise" style="--d: 0s">// transmission</p>
      <h1 class="n-page-title n-rise" style="--d: 0.08s">{title}</h1>
      <p class="n-project-meta" style="margin-top: 0.8rem;">
        <FormattedDate date={pubDate} />
        {updatedDate && <span>&middot; last rerun <FormattedDate date={updatedDate} /></span>}
      </p>
      <div class="n-beam" aria-hidden="true"></div>
    </header>

    <article class="n-panel n-article">
      {description && <p class="n-lede">{description}</p>}
      {
        heroImage && (
          <Image
            class="n-hero-img"
            src={heroImage}
            alt=""
            widths={[800, 1024, 1280]}
            sizes="(min-width: 72rem) 68rem, 92vw"
          />
        )
      }

      <div class="n-prose">
        <Content />
      </div>
    </article>
  </main>
</Layout>
