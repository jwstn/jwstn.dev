---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectsProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { projects } = Astro.props as ProjectsProps;
---

<Layout title="Projects | jwstn.dev" description="Projects JW has built.">
  <main class="n-main">
    <header class="n-page-head">
      <p class="n-kicker n-rise" style="--d: 0s">// sector_01 &middot; build log</p>
      <h1 class="n-page-title n-rise" style="--d: 0.08s">Projects</h1>
      <p class="n-page-lede n-rise" style="--d: 0.16s">
        Everything currently humming on my grid &mdash; from a vinyl forum to a terminal jukebox. Wiring details on
        each panel.
      </p>
    </header>

    <ul class="n-project-grid">
      {
        projects.map((project, index) => (
          <li>
            <a class="n-panel n-card" href={`/projects/${project.id}/`}>
              <span class="n-card-index">PROJECT_{String(index + 1).padStart(2, "0")}</span>
              <h2 class="n-card-title n-aberr">{project.data.title}</h2>
              <p class="n-project-desc">{project.data.description}</p>
              <ul class="n-chip-row">
                {project.data.tags.map((tag) => (
                  <li class="n-chip">{tag}</li>
                ))}
              </ul>
              <p class="n-project-meta">
                <FormattedDate date={project.data.pubDate} />
                <span class="n-project-cta">open file &rarr;</span>
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
