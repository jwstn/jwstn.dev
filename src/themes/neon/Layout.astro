---
import { SOCIALS } from "#/lib/content";
import MetaTags from "#/themes/shared/MetaTags.astro";
import ThemeSwitcher from "#/themes/shared/ThemeSwitcher.astro";
import type { LayoutProps } from "#/themes/types";
import "./theme.css";

// Rendered by the route dispatchers: <T.Layout title=... description=...>
// The page components are fragments that land in the <slot />.
const { title, description } = Astro.props as LayoutProps;
const year = new Date().getFullYear();
---

<html lang="en" class="theme-neon">
  <head>
    <MetaTags title={title} description={description} />
  </head>
  <body class="n-body">
    <div class="n-city" aria-hidden="true"></div>

    <header class="n-header">
      <div class="n-header-inner">
        <a class="n-brand" href="/">
          jwstn<span class="n-brand-tld">.dev</span>
        </a>
        <nav class="n-nav" aria-label="Primary">
          <a class="n-nav-link" href="/projects/">Projects</a>
          <a class="n-nav-link" href="/blog/">Blog</a>
          <a class="n-nav-link" href="/gallery/">Gallery</a>
          {
            SOCIALS.map((s) => (
              <a class="n-nav-link n-nav-social" href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <slot />

    <footer class="n-footer">
      <div class="n-beam" aria-hidden="true"></div>
      <div class="n-footer-inner">
        <p>&copy; {year} jwstn — broadcasting from Cologne</p>
        <p class="n-footer-links">
          {
            SOCIALS.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            ))
          }
        </p>
      </div>
    </footer>

    <ThemeSwitcher />
  </body>
</html>
