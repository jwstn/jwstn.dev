---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { project, Content } = Astro.props as ProjectProps;
const { title, description, pubDate, href, tags } = project.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <main class="n-main">
    <p class="n-back">
      <a class="n-btn" href="/projects/">&larr; sector_01 &middot; all projects</a>
    </p>

    <header class="n-page-head">
      <p class="n-kicker n-rise" style="--d: 0s">// project file</p>
      <h1 class="n-page-title n-rise" style="--d: 0.08s">{title}</h1>
      <p class="n-project-meta" style="margin-top: 0.8rem;">
        <FormattedDate date={pubDate} />
      </p>
      <div class="n-beam" aria-hidden="true"></div>
    </header>

    <article class="n-panel n-article">
      <p class="n-lede">{description}</p>
      <ul class="n-chip-row">
        {tags.map((tag) => <li class="n-chip">{tag}</li>)}
      </ul>
      <a class="n-btn n-btn-solid" href={href} target="_blank" rel="noopener noreferrer">launch project &#8599;</a>

      <div class="n-prose">
        <Content />
      </div>
    </article>
  </main>
</Layout>
