---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} — jwstn.dev`} description={description}>
  <article class="neu-article">
    <p class="neu-backrow neu-rise">
      <a class="neu-pill" href="/blog">&larr; Blog</a>
    </p>

    <header class="neu-pagehead neu-rise">
      <p class="neu-kicker">Note</p>
      <h1 class="neu-display neu-display-page">{title}</h1>
      <div class="neu-chips neu-head-chips">
        <span class="neu-chip">
          <FormattedDate date={pubDate} />
        </span>
        {
          updatedDate && (
            <span class="neu-chip">
              Revised <FormattedDate date={updatedDate} />
            </span>
          )
        }
      </div>
    </header>

    {
      heroImage && (
        <figure class="neu-frame neu-heroimg neu-rise neu-rise-2">
          <div class="neu-well">
            <Image
              src={heroImage}
              alt=""
              widths={[480, 800, 1200]}
              sizes="(min-width: 66rem) 42rem, calc(100vw - 3.5rem)"
              loading="eager"
              decoding="async"
            />
          </div>
        </figure>
      )
    }

    <div class="neu-prose neu-rise neu-rise-2">
      <Content />
    </div>
  </article>
</Layout>
