---
import FormattedDate from "#/components/FormattedDate.astro";
import type { BlogProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { posts } = Astro.props as BlogProps;
---

<Layout
  title="Blog — jwstn.dev"
  description="Notes by JW — on Effect, photographs from Japan, and building things slowly. Nothing pressed in yet."
>
  <header class="neu-pagehead neu-rise">
    <p class="neu-kicker">Notes</p>
    <h1 class="neu-display">Blog</h1>
  </header>

  <div class="neu-dots" aria-hidden="true"><span></span><span></span><span></span></div>

  {
    posts.length === 0 ? (
      <section class="neu-empty neu-rise neu-rise-2" aria-label="No posts published yet">
        <h2 class="neu-empty-title">Nothing pressed in yet</h2>
        <p class="neu-lede">
          The blog is still a smooth surface — no post has been set into it. Notes on Effect,
          photographs from the Japan 2026 trip, and a few lessons from the workbench are being
          written slowly; when one is worth keeping it will appear here, dated and quietly
          raised from the field.
        </p>
        <div class="neu-grooves" aria-hidden="true">
          <span class="neu-groove" />
          <span class="neu-groove" />
          <span class="neu-groove" />
        </div>
        <p class="neu-empty-note">reserved for a first entry</p>
      </section>
    ) : (
      <ol class="neu-postlist neu-rise neu-rise-2">
        {posts.map((post) => (
          <li>
            <a class="neu-card" href={`/blog/${post.id}/`}>
              <h2 class="neu-card-title">{post.data.title}</h2>
              <p class="neu-card-desc">{post.data.description}</p>
              <div class="neu-card-meta">
                <span class="neu-chip">
                  <FormattedDate date={post.data.pubDate} />
                </span>
                {post.data.updatedDate && (
                  <span class="neu-chip">
                    Revised <FormattedDate date={post.data.updatedDate} />
                  </span>
                )}
              </div>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</Layout>
