---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { project, Content } = Astro.props as ProjectProps;
const { title, description, pubDate, href, tags } = project.data;
---

<Layout title={`${title} — jwstn.dev`} description={description}>
  <article class="neu-article">
    <p class="neu-backrow neu-rise">
      <a class="neu-pill" href="/projects">&larr; Projects</a>
    </p>

    <header class="neu-pagehead neu-rise">
      <p class="neu-kicker">Project</p>
      <h1 class="neu-display neu-display-page">{title}</h1>
      <div class="neu-chips neu-head-chips">
        <span class="neu-chip">
          <FormattedDate date={pubDate} />
        </span>
        <a class="neu-pill" href={href} target="_blank" rel="noopener noreferrer">
          Visit the project ↗
        </a>
      </div>
    </header>

    <div class="neu-prose neu-rise neu-rise-2">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <ul class="neu-chips neu-endtags">
          {tags.map((tag) => (
            <li class="neu-chip">{tag}</li>
          ))}
        </ul>
      )
    }
  </article>
</Layout>
