---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectsProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { projects } = Astro.props as ProjectsProps;
---

<Layout
  title="Projects — jwstn.dev"
  description="Four selected works by JW — a vinyl collectors' forum, a terminal Spotify client, a sign-language trainer, and a very personal note app."
>
  <header class="neu-pagehead neu-rise">
    <p class="neu-kicker">The Shelf</p>
    <h1 class="neu-display">Projects</h1>
    <p class="neu-lede">
      Four works in progress — each one raised slightly above the surface, each one still being
      shaped. A collectors' forum, a terminal client, a language trainer, and one very personal
      note app.
    </p>
  </header>

  <div class="neu-dots" aria-hidden="true"><span></span><span></span><span></span></div>

  <ul class="neu-grid neu-grid--projects neu-rise neu-rise-2">
    {
      projects.map((project) => (
        <li>
          <a class="neu-card" href={`/projects/${project.id}/`}>
            <h2 class="neu-card-title">{project.data.title}</h2>
            <p class="neu-card-desc">{project.data.description}</p>
            <div class="neu-card-meta">
              <span class="neu-chip">
                <FormattedDate date={project.data.pubDate} />
              </span>
            </div>
            {project.data.tags.length > 0 && (
              <ul class="neu-chips neu-card-tags">
                {project.data.tags.map((tag) => (
                  <li class="neu-chip">{tag}</li>
                ))}
              </ul>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
