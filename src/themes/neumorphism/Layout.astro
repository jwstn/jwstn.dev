---
import { SOCIALS } from "#/lib/content";
import MetaTags from "#/themes/shared/MetaTags.astro";
import ThemeSwitcher from "#/themes/shared/ThemeSwitcher.astro";
import type { LayoutProps } from "#/themes/types";
import "./theme.css";

const { title, description } = Astro.props as LayoutProps;
const year = new Date().getFullYear();

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" || path === "" : path.startsWith(href));

const nav = [
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/gallery", label: "Gallery" },
];
---

<html lang="en" class="theme-neumorphism">
  <head>
    <MetaTags title={title} description={description} />
  </head>
  <body>
    <a class="neu-skip" href="#neu-main">Skip to content</a>

    <header class="neu-header">
      <div class="neu-topbar">
        <a class="neu-brand" href="/">jwstn.dev</a>
        <ul class="neu-socials">
          {
            SOCIALS.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav class="neu-nav" aria-label="Primary">
        {
          nav.map((item) => (
            <a
              class="neu-nav-link"
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="neu-main">
      <slot />
    </main>

    <footer class="neu-footer">
      <div class="neu-footer-panel">
        <p class="neu-footer-copy">&copy; {year} jwstn — Cologne</p>
        <ul class="neu-footer-socials">
          {
            SOCIALS.map((s) => (
              <li>
                <a class="neu-mini" href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>

    <ThemeSwitcher />
  </body>
</html>
