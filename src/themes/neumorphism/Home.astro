---
import type { HomeProps } from "#/themes/types";
import Layout from "./Layout.astro";

Astro.props as HomeProps;

const facts = ["Cologne", "TanStack", "Effect", "Japan 2026"];

const tiles = [
  {
    href: "/projects",
    title: "Projects",
    note: "Four works, all still in progress.",
  },
  {
    href: "/blog",
    title: "Blog",
    note: "A smooth, empty panel — nothing pressed in yet.",
  },
  {
    href: "/gallery",
    title: "Gallery",
    note: "Japan 2026, a German summer, the spring at home.",
  },
];
---

<Layout
  title="jwstn.dev — JW, full-stack developer in Cologne"
  description="JW builds web applications with TanStack, experiments with Effect, and takes his camera everywhere — most recently to Japan."
>
  <section class="neu-hero neu-rise">
    <p class="neu-kicker">JW · Full-Stack Developer · Cologne</p>
    <h1 class="neu-display">
      Quiet software,<br />
      <em>built to be touched.</em>
    </h1>
    <p class="neu-lede">
      Most of my days go into web applications with
      <a href="https://tanstack.com/" target="_blank" rel="noopener noreferrer">TanStack</a> — it
      covers so much of what a modern app needs that
      <a href="https://hono.dev/" target="_blank" rel="noopener noreferrer">Hono</a> and
      <a href="https://elysiajs.com/" target="_blank" rel="noopener noreferrer">Elysia</a> are still
      waiting their turn on the shelf. What did stick is
      <a href="https://effect.website/" target="_blank" rel="noopener noreferrer">Effect</a> — the
      most fun I've had in a while, relearning how a program can be written. When the keyboard
      rests, the camera comes out: in 2026 it travelled to Japan, and it hasn't really been put
      down since.
    </p>
    <ul class="neu-chips neu-head-chips">
      {
        facts.map((fact) => (
          <li class="neu-chip">{fact}</li>
        ))
      }
    </ul>
  </section>

  <div class="neu-dots" aria-hidden="true"><span></span><span></span><span></span></div>

  <section class="neu-rise neu-rise-2" aria-labelledby="neu-tiles-h">
    <h2 id="neu-tiles-h" class="neu-kicker">Around the site</h2>
    <div class="neu-grid neu-grid--tiles">
      {
        tiles.map((tile) => (
          <a class="neu-card" href={tile.href}>
            <span class="neu-tile-go" aria-hidden="true">
              →
            </span>
            <h3 class="neu-tile-title">{tile.title}</h3>
            <p class="neu-tile-note">{tile.note}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
