---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { AlbumProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { album } = Astro.props as AlbumProps;
const { title, pubDate, photos } = album.data;

const photoCount = `${photos.length} photograph${photos.length === 1 ? "" : "s"}`;
---

<Layout
  title={`${title} — jwstn.dev`}
  description={`Photographs from ${title} — by JW.`}
>
  <p class="neu-backrow neu-rise">
    <a class="neu-pill" href="/gallery">&larr; Gallery</a>
  </p>

  <header class="neu-pagehead neu-rise">
    <p class="neu-kicker">Album</p>
    <h1 class="neu-display neu-display-page">{title}</h1>
    <div class="neu-chips neu-head-chips">
      <span class="neu-chip">
        <FormattedDate date={pubDate} />
      </span>
      <span class="neu-chip">{photoCount}</span>
    </div>
  </header>

  <div class="neu-photos neu-rise neu-rise-2">
    {
      photos.map((photo) => (
        <figure class="neu-frame">
          <div class="neu-well">
            <Image
              src={photo.image}
              alt={photo.title}
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 66rem) 56rem, calc(100vw - 4rem)"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="neu-frame-cap">
            <span class="neu-frame-title">{photo.title}</span>
            {photo.caption && <span class="neu-frame-note">{photo.caption}</span>}
          </figcaption>
        </figure>
      ))
    }
  </div>
</Layout>
