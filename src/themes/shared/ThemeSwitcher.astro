---
// Floating theme picker + light/dark toggle, included by EVERY theme's Layout.
// Styles hook into the per-theme raw vars with neutral fallbacks, so themes
// only need to define --background/--foreground/--primary/--border to make it
// fit in. Themes may additionally define --sw-bg/--sw-fg/--sw-border/--sw-accent
// for finer control.
import { THEMES } from "#/themes/registry";

const current = Astro.locals.theme;
---

<div id="theme-switcher" data-current={current}>
  <button type="button" id="theme-switcher-mode" title="Toggle light/dark mode" aria-label="Toggle light/dark mode">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
      ></path>
    </svg>
  </button>
  <label>
    <span class="visually-hidden">Theme</span>
    <select id="theme-switcher-select" aria-label="Choose theme">
      {
        THEMES.map((t) => (
          <option value={t.id} selected={t.id === current}>
            {t.label}
          </option>
        ))
      }
    </select>
  </label>
</div>

<style>
  #theme-switcher {
    --sw-bg: var(--background, #111);
    --sw-fg: var(--foreground, #eee);
    --sw-border: var(--border, transparent);
    --sw-accent: var(--primary, #8b5cf6);

    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 100;
    display: flex;
    align-items: stretch;
    gap: 0;
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid var(--sw-border);
    background: color-mix(in oklab, var(--sw-bg) 82%, transparent);
    color: var(--sw-fg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 24px rgb(0 0 0 / 0.25);
    font-size: 0.8rem;
    line-height: 1;
  }

  #theme-switcher button {
    display: grid;
    place-items: center;
    padding: 0.5rem 0.6rem;
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
  }

  #theme-switcher button svg {
    width: 1rem;
    height: 1rem;
  }

  #theme-switcher button:hover {
    background: color-mix(in oklab, var(--sw-accent) 25%, transparent);
  }

  #theme-switcher label {
    display: flex;
    align-items: center;
    padding: 0 0.25rem 0 0;
  }

  #theme-switcher select {
    appearance: none;
    background: transparent;
    color: inherit;
    border: none;
    padding: 0.5rem 0.6rem;
    font: inherit;
    cursor: pointer;
    outline: none;
  }

  #theme-switcher select option {
    color: #111;
    background: #fff;
  }

  #theme-switcher:focus-within {
    outline: 2px solid var(--sw-accent);
    outline-offset: 2px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  // Event delegation on document so listeners survive view-transition DOM swaps.
  const COOKIE = "site-theme";
  const ONE_YEAR = 60 * 60 * 24 * 365;

  document.addEventListener("change", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLSelectElement) || target.id !== "theme-switcher-select") {
      return;
    }
    document.cookie = `${COOKIE}=${encodeURIComponent(target.value)}; path=/; max-age=${ONE_YEAR}; samesite=lax`;
    window.location.reload();
  });

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement) || target.id !== "theme-switcher-mode") {
      return;
    }
    const root = document.documentElement;
    const dark = root.classList.toggle("dark");
    localStorage.setItem("theme", dark ? "dark" : "light");
  });
</script>
