---
import FormattedDate from "#/components/FormattedDate.astro";
import type { BlogProps } from "#/themes/types";
import Hanko from "./Hanko.astro";
import RawEdge from "./RawEdge.astro";
import Layout from "./Layout.astro";

const { posts } = Astro.props as BlogProps;

const marks = ["i.", "ii.", "iii.", "iv.", "v.", "vi.", "vii.", "viii."];
---

<Layout
  title="Journal — jwstn.dev"
  description="Occasional writing by JW — kept only when something proves worth keeping."
>
  <header>
    <p class="wb-kicker">Steeped slowly</p>
    <h1 class="wb-display">Journal</h1>
  </header>

  <RawEdge />

  {
    posts.length === 0 ? (
      <section class="wb-empty" aria-label="No entries published yet">
        <div class="wb-bowl" aria-hidden="true"></div>
        <h2 class="wb-empty-title">The bowl is still empty.</h2>
        <p class="wb-lede">
          Nothing written so far has proved worth keeping — so nothing is kept. Two notes are
          being written slowly, though: one on building with
          <a href="https://effect.website/" target="_blank" rel="noopener noreferrer">Effect</a>,
          and one on carrying a camera through Japan. They will arrive when they are ready, not
          before.
        </p>
        <p class="wb-empty-note">
          When a piece is done, it will appear here the way tea appears in a bowl — quietly,
          without ceremony.
          <Hanko tilt={-4}>nothing steeped yet</Hanko>
        </p>
      </section>
    ) : (
      <ol class="wb-index">
        {posts.map((post, i) => (
          <li>
            <a class="wb-row-link" href={`/blog/${post.id}/`}>
              <span class="wb-row-num" aria-hidden="true">
                {marks[i] ?? "·"}
              </span>
              <span class="wb-row-main">
                <span class="wb-row-title">{post.data.title}</span>
                <span class="wb-row-desc">{post.data.description}</span>
              </span>
            </a>
            <p class="wb-row-meta">
              <Hanko tilt={-2.5}>
                <FormattedDate date={post.data.pubDate} />
              </Hanko>
              {post.data.updatedDate && (
                <span class="wb-revised">
                  revised <FormattedDate date={post.data.updatedDate} />
                </span>
              )}
            </p>
          </li>
        ))}
      </ol>
    )
  }
</Layout>
