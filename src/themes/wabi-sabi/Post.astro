---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Hanko from "./Hanko.astro";
import RawEdge from "./RawEdge.astro";
import Layout from "./Layout.astro";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} — jwstn.dev`} description={description}>
  <article class="wb-article">
    <p class="wb-backrow">
      <a class="wb-back" href="/blog">Back to the journal</a>
    </p>

    <header>
      <h1 class="wb-article-title">{title}</h1>
      <p class="wb-article-meta">
        <Hanko tilt={-2.5}>
          <FormattedDate date={pubDate} />
        </Hanko>
        {updatedDate && (
          <span class="wb-revised">
            revised <FormattedDate date={updatedDate} />
          </span>
        )}
      </p>
      <p class="wb-lede">{description}</p>
    </header>

    {
      heroImage && (
        <div class="wb-heroimg">
          <Image
            src={heroImage}
            alt={title}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 62rem) 40rem, (min-width: 40rem) 66vw, calc(100vw - 3rem)"
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    <RawEdge short />

    <div class="wb-prose">
      <Content />
    </div>
  </article>
</Layout>
