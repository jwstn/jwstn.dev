---
import type { HomeProps } from "#/themes/types";
import RawEdge from "./RawEdge.astro";
import Layout from "./Layout.astro";

Astro.props as HomeProps;

const contents = [
  {
    href: "/projects",
    title: "Projects",
    note: "Four things on the workbench — vinyl records, a terminal for Spotify, sign language, and a todo app that is mine.",
  },
  {
    href: "/blog",
    title: "Journal",
    note: "The bowl is empty. Nothing has been steeped worth keeping — yet.",
  },
  {
    href: "/gallery",
    title: "Gallery",
    note: "Photographs with margins: Japan 2026, a German summer, spring at home.",
  },
];

const marks = ["i.", "ii.", "iii."];
---

<Layout
  title="jwstn.dev — JW, full-stack developer in Cologne"
  description="JW builds web applications with TanStack, experiments with Effect, and carries a camera everywhere — most recently to Japan."
>
  <section class="wb-hero">
    <div class="wb-hero-text">
      <p class="wb-kicker">JW · full-stack developer · Cologne</p>
      <h1 class="wb-display">
        Nothing here is finished —<br />
        <em>that is rather the point.</em>
      </h1>
      <p class="wb-lede">
        Most of my days go into web applications with
        <a href="https://tanstack.com/" target="_blank" rel="noopener noreferrer">TanStack</a>.
        <a href="https://hono.dev/" target="_blank" rel="noopener noreferrer">Hono</a> and
        <a href="https://elysiajs.com/" target="_blank" rel="noopener noreferrer">Elysia</a> are still
        waiting their turn on the shelf — but
        <a href="https://effect.website/" target="_blank" rel="noopener noreferrer">Effect</a>
        got picked up, and it has quietly rearranged how I think a program is written. The rest of
        the time, a camera: in 2026 it travelled to Japan, and it has not really been put away since.
      </p>
    </div>

    <div class="wb-hero-ma" aria-hidden="true">
      <svg class="wb-enso" viewBox="0 0 100 100" focusable="false">
        <circle
          cx="50"
          cy="50"
          r="37"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          pathLength="100"
          stroke-dasharray="84 16"
          stroke-dashoffset="5"
          transform="rotate(58 50 50)"></circle>
        <circle
          cx="50"
          cy="50"
          r="37"
          fill="none"
          stroke="currentColor"
          stroke-width="4.5"
          stroke-linecap="round"
          pathLength="100"
          stroke-dasharray="16 84"
          stroke-dashoffset="5"
          transform="rotate(58 50 50)"
          opacity="0.9"></circle>
      </svg>
      <p class="wb-ma-note">ma — the space<br />that lets things breathe</p>
    </div>
  </section>

  <RawEdge />

  <section aria-labelledby="wb-contents-h">
    <h2 id="wb-contents-h" class="wb-kicker">Kept, for now</h2>
    <ol class="wb-index">
      {
        contents.map((c, i) => (
          <li>
            <a class="wb-row-link" href={c.href}>
              <span class="wb-row-num" aria-hidden="true">
                {marks[i]}
              </span>
              <span class="wb-row-main">
                <span class="wb-row-title">{c.title}</span>
                <span class="wb-row-desc">{c.note}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>
