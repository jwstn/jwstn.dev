---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectProps } from "#/themes/types";
import Hanko from "./Hanko.astro";
import RawEdge from "./RawEdge.astro";
import Layout from "./Layout.astro";

const { project, Content } = Astro.props as ProjectProps;
const { title, description, pubDate, href, tags } = project.data;
---

<Layout title={`${title} — jwstn.dev`} description={description}>
  <article class="wb-article">
    <p class="wb-backrow">
      <a class="wb-back" href="/projects">Back to the workbench</a>
    </p>

    <header>
      <h1 class="wb-article-title">{title}</h1>
      <p class="wb-article-meta">
        <Hanko tilt={-2.5}>
          <FormattedDate date={pubDate} />
        </Hanko>
        <a href={href} target="_blank" rel="noopener noreferrer">visit the work ↗</a>
      </p>
    </header>

    <RawEdge short />

    <div class="wb-prose">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <ul class="wb-tags wb-tags-end" aria-label="Technologies used">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </article>
</Layout>
