---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { GalleryProps } from "#/themes/types";
import Hanko from "./Hanko.astro";
import RawEdge from "./RawEdge.astro";
import Layout from "./Layout.astro";

const { albums } = Astro.props as GalleryProps;
---

<Layout
  title="Gallery — jwstn.dev"
  description="Photographs by JW, each given room to breathe — Japan 2026, a German summer, spring at home."
>
  <header>
    <p class="wb-kicker">The quiet record</p>
    <h1 class="wb-display">Gallery</h1>
    <p class="wb-lede">
      Photographs are kept the way keepsakes are: in thin ink frames, on paper mats, each one
      hung a little off the centre line. Nothing fills the whole wall.
    </p>
  </header>

  <RawEdge />

  <ul class="wb-albums">
    {
      albums.map((album) => (
        <li class="wb-album">
          <a class="wb-album-link" href={`/gallery/${album.data.slug}/`}>
            <figure class="wb-frame">
              {
                album.data.photos[0] && (
                  <span class="wb-cover">
                    <Image
                      src={album.data.photos[0].image}
                      alt={`Cover photograph from the album ${album.data.title}`}
                      widths={[480, 800, 1200]}
                      sizes="(min-width: 62rem) 30rem, (min-width: 40rem) 60vw, calc(100vw - 3rem)"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                )
              }
            </figure>
            <p class="wb-album-caption">
              <span class="wb-album-title">{album.data.title}</span>
              <Hanko tilt={2}>
                <FormattedDate date={album.data.pubDate} />
              </Hanko>
              <span class="wb-album-count">
                {album.data.photos.length}
                {album.data.photos.length === 1 ? " photograph" : " photographs"}
              </span>
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
