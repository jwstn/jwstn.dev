---
// A torn ink thread — the theme's "raw edge" divider between sections.
// Two overlapping hand-wobbled strokes; both stretch with the page but
// keep a uniform stroke width (vector-effect).
interface Props {
  /** render a shorter thread, left-aligned — for quieter breaks */
  short?: boolean;
  class?: string;
}

const { short = false, class: cls } = Astro.props as Props;
---

<div class:list={["wb-edge", short && "wb-edge--short", cls]} aria-hidden="true">
  <svg viewBox="0 0 1200 24" preserveAspectRatio="none" focusable="false">
    <path
      d="M0 12 C 70 8 110 17 180 13 S 300 6 370 14 S 490 20 560 12 S 680 7 750 15 S 870 20 940 12 S 1060 8 1130 15 S 1180 17 1200 12"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"></path>
    <path
      d="M0 18 C 90 21 150 15 240 19 S 380 23 470 17 S 610 13 700 20 S 840 24 930 17 S 1080 14 1200 19"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
      opacity="0.4"></path>
  </svg>
</div>
