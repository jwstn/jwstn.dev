---
import type { HomeProps } from "#/themes/types";
import CassetteScene from "./CassetteScene.astro";
import Layout from "./Layout.astro";

Astro.props as HomeProps;

const doors = [
  { href: "/projects/", num: "01", ref: "REF N1\u00b7E01", title: "Projects", cta: "Open assemblies \u2192" },
  { href: "/blog/", num: "02", ref: "REF N1\u00b7E02", title: "Blog", cta: "Inspect the sheet \u2192" },
  { href: "/gallery/", num: "03", ref: "REF N1\u00b7E03", title: "Gallery", cta: "View plates \u2192" },
];
---

<Layout
  title="jwstn.dev — JW, full-stack developer in Cologne"
  description="This is a personal page that I use to display recent projects and add a blog post (sometimes)."
>
  <div class="iso-shell">
    <section class="iso-hero">
      <div class="iso-hero-inner">
        <p class="iso-kicker iso-rise">Portfolio &mdash; DWG №26 &middot; Rev A</p>
        <h1 class="iso-h1 iso-rise iso-rise--2">
          Hey, I'm <span class="iso-name">JW</span>! a Full-Stack Developer from Cologne, Germany
        </h1>
        <p class="iso-hero-copy iso-rise iso-rise--3">
          I'm focusing on building web applications with <a
            href="https://tanstack.com/"
            target="_blank"
            rel="noopener noreferrer">TanStack</a
          >. Since it provides most of the features you need to build a web app, even some more complex ones,
          with server actions or middleware, I didn't get the chance to test out any backend frameworks like <a
            href="https://hono.dev/"
            target="_blank"
            rel="noopener noreferrer">Hono</a
          > or <a href="https://elysiajs.com/" target="_blank" rel="noopener noreferrer">Elysia</a>. But what I got
          around to test out is <a href="https://effect.website/" target="_blank" rel="noopener noreferrer"
            >Effect</a
          >, which has been amazing fun so far and proved to be a great opportunity to learn a new way of programming.
        </p>
        <div class="iso-actions iso-rise iso-rise--4">
          <a class="iso-btn" href="/projects/">View projects →</a>
          <a class="iso-btn iso-btn--ghost" href="/gallery/">Open the gallery →</a>
        </div>
        <p class="iso-dim iso-rise iso-rise--4" aria-hidden="true">
          <span class="iso-dim-arrow iso-dim-arrow--l"></span>
          <span class="iso-dim-rule"></span>
          <span>Cologne, DE &mdash; 50.938° N &middot; 6.960° E</span>
          <span class="iso-dim-rule"></span>
          <span class="iso-dim-arrow iso-dim-arrow--r"></span>
        </p>
      </div>

      <CassetteScene />
    </section>

    <section aria-label="Parts list">
      <h2 class="iso-sectionlabel">Parts list &mdash; where everything is filed</h2>
      <ul class="iso-doors">
        {
          doors.map((door, i) => (
            <li>
              <a
                class="iso-slab iso-door iso-rise"
                class:list={[i === 1 && "iso-rise--2", i === 2 && "iso-rise--3"]}
                href={door.href}
              >
                <span class="iso-door-tab" aria-hidden="true">
                  {door.num}
                </span>
                <span class="iso-door-ref" aria-hidden="true">
                  {door.ref}
                </span>
                <h3 class="iso-door-title">{door.title}</h3>
                <span class="iso-door-cta">{door.cta}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
