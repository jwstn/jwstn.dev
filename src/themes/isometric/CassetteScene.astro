---
/**
 * The cassette player model from JW's three.js project (casette-player-model):
 * walkman + tape shelf, orbitable, tapes draggable into the deck. Ported from
 * that repo's player.js / cassette.js / shelf.js / textures.js (same author).
 *
 * Sizing follows this component's container; the scene only renders while
 * visible. Touch devices get a static view (no orbit/drag) so the page still
 * scrolls naturally.
 */
---

<figure class="iso-cassette iso-rise iso-rise--3" data-cassette>
  <div
    class="iso-cassette-stage"
    data-cassette-stage
    role="img"
    aria-label="Interactive 3D model of a blue cassette player beside a wooden shelf of eight mixtapes. Drag a tape into the player, or drag empty space to orbit."
  >
    <p class="iso-cassette-fallback">3D view unavailable — this browser has no WebGL.</p>
  </div>
</figure>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";
  import { RoomEnvironment } from "three/addons/environments/RoomEnvironment.js";
  import { createCassette } from "./three/cassette.js";
  import { createCassettePlayer } from "./three/player.js";
  import { createShelf } from "./three/shelf.js";

  const TAPE_DEFS = [
    { title: "summer drive mix · 1986", accent: "#c8402c" },
    { title: "night city ambient", accent: "#1f8a7d" },
    { title: "roadhouse soul vol. 2", accent: "#8a5aa0" },
    { title: "workout hits · 1985", accent: "#c9a227" },
    { title: "dawn patrol · demos", accent: "#3f7fbf" },
    { title: "jazz café after hours", accent: "#a0522d" },
    { title: "static & rain", accent: "#5a6b7a" },
    { title: "midnight radio", accent: "#cf5b8e" },
  ];

  function init(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>("[data-cassette-stage]");
    if (!stage) return;

    const coarse = window.matchMedia("(pointer: coarse)").matches;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    } catch {
      root.classList.add("is-fallback");
      return;
    }

    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    stage.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
    camera.position.set(1.35, 6.9, 13.1);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.target.set(1.25, 0.85, -1.5);
    controls.enableDamping = true;
    controls.dampingFactor = 0.06;
    controls.enablePan = false;
    controls.minDistance = 8;
    controls.maxDistance = 28;
    controls.minPolarAngle = 0.5;
    controls.maxPolarAngle = Math.PI / 2 + 0.02;

    if (coarse) {
      // Keep the page scrollable on touch; the scene is a static showpiece there.
      controls.enabled = false;
      renderer.domElement.style.touchAction = "pan-y";
    }

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
    scene.environmentIntensity = 0.55;

    const key = new THREE.DirectionalLight(0xfff0dc, 2.6);
    key.position.set(6, 12, 8);
    key.castShadow = true;
    key.shadow.mapSize.set(2048, 2048);
    key.shadow.camera.left = -12;
    key.shadow.camera.right = 12;
    key.shadow.camera.top = 12;
    key.shadow.camera.bottom = -12;
    key.shadow.camera.near = 2;
    key.shadow.camera.far = 45;
    key.shadow.bias = -0.0004;
    key.shadow.normalBias = 0.03;
    key.shadow.radius = 4;
    scene.add(key);

    const fill = new THREE.DirectionalLight(0xbcd2ff, 0.65);
    fill.position.set(-7, 4, 6);
    scene.add(fill);

    const rim = new THREE.DirectionalLight(0xdfe8ff, 1.0);
    rim.position.set(-2, 7, -8);
    scene.add(rim);

    // Shadow catcher only — the drafting-paper background shows through.
    const ground = new THREE.Mesh(new THREE.PlaneGeometry(60, 60), new THREE.ShadowMaterial({ opacity: 0.24 }));
    ground.rotation.x = -Math.PI / 2;
    ground.receiveShadow = true;
    scene.add(ground);

    const player = createCassettePlayer();
    player.root.position.set(-1.25, 0, 0.8);
    player.root.rotation.y = 0.18;
    scene.add(player.root);

    const shelf = createShelf();
    shelf.group.position.set(1.45, 0, -4.4);
    shelf.group.rotation.y = -0.18;
    scene.add(shelf.group);

    const tapes = TAPE_DEFS.map((def, i) => {
      const tape = createCassette(def);
      tape.group.userData.tape = tape;
      tape.homeSlot = i;
      scene.add(tape.group);
      return tape;
    });

    const slotJitter = (i: number) => (i % 2 ? 0.05 : -0.04);
    function slotWorld(i: number) {
      return shelf.group.localToWorld(shelf.slots[i].position.clone());
    }
    function slotPose(i: number) {
      return {
        pos: slotWorld(i),
        rot: new THREE.Euler(0, shelf.group.rotation.y - Math.PI / 2 + slotJitter(i), 0),
      };
    }
    function placeInSlot(tape: (typeof tapes)[number], i: number) {
      const { pos, rot } = slotPose(i);
      tape.group.position.copy(pos);
      tape.group.rotation.copy(rot);
    }

    // tape 0 starts inside the player, the rest stand on the shelf
    player.install(tapes[0], true);
    tapes.slice(1).forEach((tape, j) => placeInSlot(tape, j + 1));

    // ---------- world-space tweens ----------
    type Tween = {
      tape: (typeof tapes)[number];
      from: THREE.Vector3;
      fromRot: THREE.Euler;
      to: THREE.Vector3;
      toRot: THREE.Euler;
      t: number;
      dur: number;
      arc: number;
      onDone: (() => void) | null;
    };
    const tweens: Tween[] = [];

    function flyTo(
      tape: (typeof tapes)[number],
      toPos: THREE.Vector3,
      toRot: THREE.Euler,
      dur = 0.55,
      arc = 1.2,
      onDone: (() => void) | null = null,
    ) {
      tweens.push({
        tape,
        from: tape.group.position.clone(),
        fromRot: tape.group.rotation.clone(),
        to: toPos.clone(),
        toRot: toRot.clone(),
        t: 0,
        dur,
        arc,
        onDone,
      });
    }
    function stepTweens(dt: number) {
      for (let i = tweens.length - 1; i >= 0; i--) {
        const tw = tweens[i];
        tw.t += dt;
        const k = Math.min(1, tw.t / tw.dur);
        const e = k * k * (3 - 2 * k);
        const g = tw.tape.group;
        g.position.lerpVectors(tw.from, tw.to, e);
        g.position.y += tw.arc * 4 * (k - k * k);
        g.rotation.set(
          tw.fromRot.x + (tw.toRot.x - tw.fromRot.x) * e,
          tw.fromRot.y + (tw.toRot.y - tw.fromRot.y) * e,
          tw.fromRot.z + (tw.toRot.z - tw.fromRot.z) * e,
        );
        if (k >= 1) {
          g.position.copy(tw.to);
          g.rotation.copy(tw.toRot);
          tweens.splice(i, 1);
          tw.onDone?.();
        }
      }
    }
    function cancelTweens(tape: (typeof tapes)[number]) {
      for (let i = tweens.length - 1; i >= 0; i--) {
        if (tweens[i].tape === tape) tweens.splice(i, 1);
      }
    }

    // ---------- drag & drop ----------
    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();
    const dragPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -2.05);
    const dragPoint = new THREE.Vector3();
    const dragTarget = { pos: new THREE.Vector3(), rot: new THREE.Euler() };
    let drag: { tape: (typeof tapes)[number]; hover: string | null; autoOpened: boolean } | null = null;

    function setPointer(event: PointerEvent) {
      const rect = renderer.domElement.getBoundingClientRect();
      pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
      raycaster.setFromCamera(pointer, camera);
    }

    function dropZone() {
      const hits = raycaster.intersectObjects([player.insertTarget, shelf.zone], false);
      if (!hits.length) return null;
      return hits[0].object === player.insertTarget ? "player" : "shelf";
    }

    function clampDragPoint() {
      dragPoint.x = THREE.MathUtils.clamp(dragPoint.x, -6.5, 6.5);
      dragPoint.z = THREE.MathUtils.clamp(dragPoint.z, -5.5, 5.5);
    }

    const tmpWorld = new THREE.Vector3();
    function slotOccupied(i: number, excludeTape: (typeof tapes)[number]) {
      const sp = slotWorld(i);
      return tapes.some((t) => {
        if (t === excludeTape) return false;
        t.group.getWorldPosition(tmpWorld);
        return tmpWorld.distanceTo(sp) < 0.45;
      });
    }

    function nearestFreeSlot(pos: THREE.Vector3, excludeTape: (typeof tapes)[number]) {
      let best = -1;
      let bestDist = Number.POSITIVE_INFINITY;
      for (let i = 0; i < shelf.slots.length; i++) {
        if (slotOccupied(i, excludeTape)) continue;
        const d = pos.distanceTo(slotWorld(i));
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      }
      return best;
    }

    function sendHome(tape: (typeof tapes)[number]) {
      if (tape.group.parent !== scene) scene.attach(tape.group);
      let i = tape.homeSlot;
      if (i < 0 || slotOccupied(i, tape)) i = nearestFreeSlot(tape.group.position, tape);
      if (i < 0) i = 0;
      tape.homeSlot = i;
      const { pos, rot } = slotPose(i);
      flyTo(tape, pos, rot, 0.7, 1.6);
    }

    function startDrag(tape: (typeof tapes)[number]) {
      cancelTweens(tape);
      controls.enabled = false;
      if (player.debug.installed === tape) player.remove();
      drag = { tape, hover: null, autoOpened: false };
      dragTarget.pos.copy(tape.group.position);
      dragTarget.rot.copy(tape.group.rotation);
      renderer.domElement.style.cursor = "grabbing";
    }

    function moveDrag(event: PointerEvent) {
      if (!drag) return;
      setPointer(event);
      if (!raycaster.ray.intersectPlane(dragPlane, dragPoint)) return;
      clampDragPoint();
      const zone = dropZone();
      drag.hover = zone;
      if (zone === "player") {
        if (!player.doorOpen) {
          player.setDoorOpen(true);
          drag.autoOpened = true;
        }
        const bay = player.root.localToWorld(new THREE.Vector3(0, 2.0, 0));
        dragTarget.pos.lerpVectors(dragPoint, bay, 0.5);
        dragTarget.pos.y = 2.0;
        dragTarget.rot.set(-Math.PI / 2, player.root.rotation.y, 0);
      } else {
        if (drag.autoOpened) {
          player.setDoorOpen(false);
          drag.autoOpened = false;
        }
        if (zone === "shelf") {
          const i = nearestFreeSlot(dragPoint, drag.tape);
          if (i >= 0) {
            const { pos, rot } = slotPose(i);
            dragTarget.pos.lerpVectors(dragPoint, pos, 0.6);
            dragTarget.pos.y = pos.y + 1.1;
            dragTarget.rot.copy(rot);
          } else {
            dragTarget.pos.copy(dragPoint);
            dragTarget.pos.y = 2.05;
            dragTarget.rot.set(-Math.PI / 2, 0, 0);
          }
        } else {
          dragTarget.pos.copy(dragPoint);
          dragTarget.pos.y = 2.05;
          dragTarget.rot.set(-Math.PI / 2, 0, 0);
        }
      }
    }

    function endDrag(event: PointerEvent) {
      if (!drag) return;
      const tape = drag.tape;
      setPointer(event);
      const zone = dropZone();
      const autoOpened = drag.autoOpened;
      drag = null;
      controls.enabled = true;
      renderer.domElement.style.cursor = "";
      if (autoOpened && zone !== "player") player.setDoorOpen(false);

      if (zone === "player" && !player.busy) {
        const res = player.install(tape);
        if (res.ok) {
          if (res.previous && res.previous !== tape) sendHome(res.previous);
          return;
        }
      }
      if (zone === "shelf" && raycaster.ray.intersectPlane(dragPlane, dragPoint)) {
        clampDragPoint();
        const i = nearestFreeSlot(dragPoint, tape);
        if (i >= 0) {
          tape.homeSlot = i;
          const { pos, rot } = slotPose(i);
          flyTo(tape, pos, rot, 0.45, 0.9);
          return;
        }
      }
      sendHome(tape);
    }

    function pick(event: PointerEvent) {
      setPointer(event);
      const candidates = [...player.pressables, ...player.clickBlockers, ...tapes.map((t) => t.group)];
      const hits = raycaster.intersectObjects(candidates, true);
      if (!hits.length) return null;
      const first = hits[0].object;
      let owner: THREE.Object3D | null = first;
      while (owner && !owner.userData.tape) owner = owner.parent;
      if (owner?.userData.tape) {
        const tape = owner.userData.tape;
        if (player.installed === tape && !player.doorOpen) return null;
        return { tape };
      }
      if (first.userData.action) return { action: first.userData.action as string };
      return null;
    }

    const onPointerDown = (event: PointerEvent) => {
      if (coarse) return;
      const hit = pick(event);
      if (!hit) return;
      if (hit.action) {
        player.press(hit.action);
        return;
      }
      if (hit.tape) {
        startDrag(hit.tape);
        moveDrag(event);
      }
    };
    const onPointerMove = (event: PointerEvent) => {
      if (coarse) return;
      if (drag) {
        moveDrag(event);
        return;
      }
      const hit = pick(event);
      renderer.domElement.style.cursor = hit ? (hit.tape ? "grab" : "pointer") : "";
    };
    const onPointerUp = (event: PointerEvent) => {
      if (drag) endDrag(event);
    };

    renderer.domElement.addEventListener("pointerdown", onPointerDown);
    renderer.domElement.addEventListener("pointermove", onPointerMove);
    window.addEventListener("pointerup", onPointerUp);

    // ---------- sizing & lifecycle ----------
    function resize() {
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    const observer = new ResizeObserver(resize);
    observer.observe(stage);
    resize();

    let visible = true;
    const io = new IntersectionObserver((entries) => {
      visible = entries[0]?.isIntersecting ?? true;
    });
    io.observe(root);

    let dead = false;
    const clock = new THREE.Clock();
    renderer.setAnimationLoop(() => {
      if (dead || !visible) return;
      const dt = Math.min(clock.getDelta(), 0.05);
      const t = clock.elapsedTime;

      if (drag) {
        const g = drag.tape.group;
        const k = 1 - Math.exp(-dt * 14);
        g.position.lerp(dragTarget.pos, k);
        g.rotation.x += (dragTarget.rot.x - g.rotation.x) * k;
        g.rotation.y += (dragTarget.rot.y - g.rotation.y) * k;
        g.rotation.z += (dragTarget.rot.z - g.rotation.z) * k;
        if (drag.hover !== "player") g.position.y += Math.sin(t * 6) * 0.03;
      }

      stepTweens(dt);
      player.update(dt, t);
      controls.update();
      renderer.render(scene, camera);
    });

    document.addEventListener(
      "astro:before-swap",
      () => {
        dead = true;
        window.removeEventListener("pointerup", onPointerUp);
        observer.disconnect();
        io.disconnect();
        renderer.setAnimationLoop(null);
        renderer.dispose();
        pmrem.dispose();
      },
      { once: true },
    );

    if (import.meta.env.DEV) {
      (window as unknown as Record<string, unknown>).__isoCassette = { player, tapes, shelf, camera, scene };
    }
  }

  // Idempotent boot: runs once per page load and again after view transitions.
  function boot() {
    const el = document.querySelector<HTMLElement>("[data-cassette]:not([data-ready])");
    if (!el) return;
    el.dataset.ready = "1";
    try {
      init(el);
    } catch (error) {
      el.classList.add("is-fallback");
      console.warn("[cassette] scene failed to start:", error);
    }
  }

  boot();
  document.addEventListener("astro:page-load", boot);
</script>
