---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectProps } from "#/themes/types";
import Layout from "./Layout.astro";
import IsoButton from "./IsoButton.astro";

const { project, Content } = Astro.props as ProjectProps;
const { title, description, pubDate, href, tags } = project.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <div class="iso-shell iso-stack">
    <p class="iso-backrow">
      <a class="iso-btn iso-btn--ghost" href="/projects/">← All assemblies</a>
    </p>

    <article class="iso-article">
      <header>
        <p class="iso-kicker">Project &mdash; DWG {project.id.toUpperCase()}</p>
        <h1 class="iso-article-title">{title}</h1>
        <div class="iso-meta-row">
          <span class="iso-chip">
            Rev <FormattedDate date={pubDate} />
          </span>
        </div>
        {
          tags.length > 0 && (
            <ul class="iso-stamps iso-meta-row" aria-label="Technologies used">
              {tags.map((tag) => (
                <li class="iso-stamp">{tag}</li>
              ))}
            </ul>
          )
        }
        {
          description && (
            <p class="iso-note iso-note--margin">
              <span class="iso-note-label">General note</span>
              {description}
            </p>
          )
        }
      </header>

      <div class="iso-prose">
        <Content />
      </div>

      <div class="iso-block-actions">
        <IsoButton href={href} external>View live assembly ↗</IsoButton>
        <IsoButton href="/projects/" variant="ghost">← Back to the plan</IsoButton>
      </div>
    </article>
  </div>
</Layout>
