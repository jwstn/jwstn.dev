---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { AlbumProps } from "#/themes/types";
import Layout from "./Layout.astro";
import IsoButton from "./IsoButton.astro";

const { album } = Astro.props as AlbumProps;
const { title, photos, pubDate } = album.data;
---

<Layout title={`${title} | jwstn.dev`} description={`${title} — ${photos.length} photographic plates by JW.`}>
  <div class="iso-shell iso-stack">
    <p class="iso-backrow">
      <IsoButton href="/gallery/" variant="ghost">← All plates</IsoButton>
    </p>

    <header class="iso-pagehead">
      <h1 class="iso-pagehead-title">{title}</h1>
      <p class="iso-pagehead-meta">
        <FormattedDate date={pubDate} /> · {photos.length} exposures
      </p>
    </header>

    <ul class="iso-wall" aria-label="Photographs">
      {
        photos.map((photo, i) => {
          const ratio = photo.image.width / photo.image.height;
          const isWide = ratio >= 1.6;
          const isTall = ratio < 0.9;
          return (
            <li class:list={["iso-plate", isWide && "iso-plate--wide", isTall && "iso-plate--tall"]}>
              <figure class="iso-platefig">
                <div class="iso-plane">
                  <Image
                    src={photo.image}
                    alt={photo.title}
                    widths={[640, 960, 1280, 1600, 1920]}
                    sizes="(min-width: 80rem) 26rem, (min-width: 48rem) 40vw, 92vw"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption class="iso-plate-cap">
                  <span class="iso-plate-ref">EXP {String(i + 1).padStart(2, "0")}</span>
                  <span class="iso-plate-title">{photo.title}</span>
                  {photo.caption && <span class="iso-plate-note">{photo.caption}</span>}
                </figcaption>
              </figure>
            </li>
          );
        })
      }
    </ul>

    <p class="iso-backrow">
      <IsoButton href="/gallery/" variant="ghost">← Back to the filing cabinet</IsoButton>
    </p>
  </div>
</Layout>
