---
// Hand-drawn margin arrow. Decorative — always aria-hidden.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg class={`riso-arrow ${className}`} viewBox="0 0 100 44" fill="none" aria-hidden="true">
  <path d="M4 32 C 28 41, 56 35, 82 14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
  <path d="M67 7 L 83.5 13.5 L 75 27.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
