---
import { Image } from "astro:assets";
import type { GalleryProps } from "#/themes/types";
import Arrow from "./Arrow.astro";
import Layout from "./Layout.astro";

const { albums } = Astro.props as GalleryProps;
---

<Layout
  title="Gallery | jwstn.dev"
  description="Photo albums from Cologne and trips beyond — every print in two inks, hover for the full-colour proof."
>
  <article>
    <p class="riso-kicker riso-rise">
      the picture pages · <span class="riso-kicker-ink">hover a print for its full-colour proof</span>
    </p>
    <h1 class="riso-shout riso-shout-big riso-rise d1">
      Gal<span class="riso-shout-ink">lery</span>
    </h1>
    <p class="riso-hand riso-rise d2">
      field notes from a camera that gets carried everywhere
      <Arrow />
    </p>

    <ul class="riso-albums riso-index-lead">
      {
        albums.map((album) => {
          const cover = album.data.photos[0];
          const count = album.data.photos.length;
          return (
            <li class="riso-album riso-rise d2">
              <a href={`/gallery/${album.data.slug}/`}>
                <div class="riso-print riso-album-cover riso-tape">
                  <Image
                    src={cover.image}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 92vw"
                    loading="lazy"
                    decoding="async"
                    alt={cover.title}
                  />
                </div>
                <h2 class="riso-album-title">{album.data.title}</h2>
                <p class="riso-meta">
                  {album.data.pubDate.toLocaleDateString("en-us", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}{" "}
                  · {count} {count === 1 ? "print" : "prints"}
                </p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </article>
</Layout>
