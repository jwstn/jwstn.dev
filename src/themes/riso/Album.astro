---
import { Image } from "astro:assets";
import type { AlbumProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { album } = Astro.props as AlbumProps;
const { title, photos, pubDate } = album.data;
---

<Layout
  title={`${title} | jwstn.dev`}
  description={`${title} — ${photos.length} photos from JW's camera, printed in two inks.`}
>
  <article>
    <a class="riso-back" href="/gallery">← back to the picture pages</a>

    <p class="riso-kicker" style="margin-top: 1.5rem;">
      contact sheet · <span class="riso-kicker-ink">hover any print for the full-colour proof</span>
    </p>
    <h1 class="riso-shout riso-shout-big riso-rise d1" style="margin-bottom: 0.5rem;">
      {title}
    </h1>
    <p class="riso-meta">
      {
        pubDate.toLocaleDateString("en-us", {
          year: "numeric",
          month: "short",
          day: "numeric",
        })
      }
      — {photos.length} {photos.length === 1 ? "print" : "prints"}, taped to the page
    </p>

    <div class="riso-photos">
      {
        photos.map((photo) => (
          <figure class="riso-photo riso-tape">
            <div class="riso-print">
              <Image
                src={photo.image}
                widths={[480, 800, 1200]}
                sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 92vw"
                loading="lazy"
                decoding="async"
                alt={photo.title}
              />
            </div>
            <figcaption>
              <p class="riso-photo-title">{photo.title}</p>
              {photo.caption && <p class="riso-photo-cap">{photo.caption}</p>}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <hr class="riso-rule" />

    <p class="riso-hand">
      that's the whole roll — more sheets back at{" "}
      <a class="riso-index-read" href="/gallery">
        the picture pages
      </a>
    </p>
  </article>
</Layout>
