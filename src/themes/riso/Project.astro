---
import type { ProjectProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { project, Content } = Astro.props as ProjectProps;
const { title, description, pubDate, href, tags } = project.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <article class="riso-article">
    <a class="riso-back" href="/projects">← back to contents</a>

    <p class="riso-kicker" style="margin-top: 1.5rem;">
      project file · <span class="riso-kicker-ink">straight from the sketchbook</span>
    </p>
    <h1 class="riso-article-title">{title}</h1>

    <div class="riso-article-meta">
      <span class="riso-meta">
        {pubDate.toLocaleDateString("en-us", { year: "numeric", month: "short", day: "numeric" })}
      </span>
      <a class="riso-index-read" href={href} target="_blank" rel="noopener noreferrer">
        visit it in the wild ↗
      </a>
    </div>

    <ul class="riso-tags" aria-label="Tags" style="margin-bottom: 1.75rem;">
      {tags.map((tag) => (
        <li>
          <span class="riso-tag">{tag}</span>
        </li>
      ))}
    </ul>

    <p class="riso-lede">{description}</p>

    <div class="riso-prose">
      <Content />
    </div>

    <hr class="riso-rule" />

    <p class="riso-fin">end of file — thanks for reading</p>
    <p class="riso-hand" style="margin-top: 0.5rem;">
      p.s. there are three more of these in <a class="riso-index-read" href="/projects">the contents</a>
    </p>
  </article>
</Layout>
