---
import type { GalleryProps } from "#/themes/types";
import Doodle from "./Doodle.astro";
import Polaroid from "./Polaroid.astro";
import Layout from "./Layout.astro";

const { albums } = Astro.props as GalleryProps;
---

<Layout
  title="Gallery | jwstn.dev"
  description="JW's photo album — polaroids from Cologne walks, spring blossoms and a Japan 2026 trip, taped in by hand."
>
  <article class="sb-page">
    <header class="sb-page-head">
      <p class="sb-stamp">scrapbook section · the photo album</p>
      <h1 class="sb-title">
        The photo album
        <Doodle name="underline" class="sb-doodle-underline" />
      </h1>
      <p class="sb-hand sb-page-hand">
        one polaroid at a time — cologne walks, spring blossoms, japan streets. taped in as the film comes
        back.
      </p>
    </header>

    <ul class="sb-albums">
      {
        albums.map((album, i) => {
          const cover = album.data.photos[0];
          return (
            <li>
              <a class="sb-album-link" href={`/gallery/${album.data.slug}/`}>
                {cover ? (
                  <Polaroid
                    image={cover.image}
                    alt={`Cover of the album "${album.data.title}" — ${cover.title}`}
                    title={album.data.title}
                    caption={`${album.data.photos.length} photos inside`}
                    tape={((i % 4) + 1) as 1 | 2 | 3 | 4}
                    tapeClass={i % 2 === 0 ? "pos-tl" : "pos-tr"}
                    widths={[480, 800]}
                    sizes="(min-width: 72rem) 22rem, (min-width: 40rem) 42vw, 88vw"
                  />
                ) : (
                  <span class="sb-hand">{album.data.title} — an empty page, for now</span>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </article>
</Layout>
