---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectProps } from "#/themes/types";
import Washi from "./Washi.astro";
import Layout from "./Layout.astro";

const { project, Content } = Astro.props as ProjectProps;
const { title, description, pubDate, href, tags } = project.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <article class="sb-article">
    <a class="sb-back" href="/projects">← back to the project pages</a>

    <header class="sb-notebook sb-article-head">
      <Washi variant={2} class="pos-tl" />
      <Washi variant={1} class="pos-tr" />
      <p class="sb-stamp">project page</p>
      <h1 class="sb-title">{title}</h1>
      <p class="sb-hand sb-article-lede">{description}</p>
      <div class="sb-article-meta">
        <span class="sb-stamp">
          <FormattedDate date={pubDate} />
        </span>
        <a class="sb-visit" href={href} target="_blank" rel="noopener noreferrer">visit the project</a>
      </div>
      <ul class="sb-chips">
        {tags.map((tag) => (
          <li class="sb-chip">{tag}</li>
        ))}
      </ul>
    </header>

    <div class="sb-paper sb-article-body sb-prose">
      <Content />
    </div>

    <p class="sb-fin">— taped in by jw. that's the whole page. ✂</p>
  </article>
</Layout>
