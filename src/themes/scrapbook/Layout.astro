---
import { SOCIALS } from "#/lib/content";
import MetaTags from "#/themes/shared/MetaTags.astro";
import ThemeSwitcher from "#/themes/shared/ThemeSwitcher.astro";
import type { LayoutProps } from "#/themes/types";
import "./theme.css";

const { title, description } = Astro.props as LayoutProps;
const year = new Date().getFullYear();

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const nav = [
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/gallery", label: "Gallery" },
];
---

<html lang="en" class="theme-scrapbook">
  <head>
    <MetaTags title={title} description={description} />
  </head>
  <body>
    <a class="sb-skip" href="#sb-main">Skip to content</a>

    <header class="sb-header">
      <a class="sb-logo" href="/">
        <span class="sb-tape v2 pos-logo" aria-hidden="true"></span>
        jwstn.dev
      </a>
      <nav class="sb-nav" aria-label="Main">
        {
          nav.map((item) => (
            <a
              class="sb-nav-link"
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
        {
          SOCIALS.map((s) => (
            <a class="sb-nav-link sb-nav-social" href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="sb-main" id="sb-main">
      <slot />
    </main>

    <footer class="sb-footer">
      <div class="sb-torn" aria-hidden="true"></div>
      <div class="sb-footer-sheet">
        <div class="sb-footer-inner">
          <p class="sb-footer-copy">
            © {year} jwstn
            <span class="sb-footer-note">— taped down with care in Cologne.</span>
          </p>
          <ul class="sb-footer-list">
            {
              SOCIALS.map((s) => (
                <li>
                  <a class="sb-footer-link" href={s.href} target="_blank" rel="noopener noreferrer">
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </footer>

    <ThemeSwitcher />
  </body>
</html>
