---
// Hand-drawn doodles (squiggle underlines, arrows, stars, hearts, scribbles).
// Decorative only: aria-hidden, colored via currentColor.
interface Props {
  name: "arrow" | "underline" | "star" | "heart" | "scribble";
  class?: string;
}

const { name, class: className = "" } = Astro.props;

const viewBoxes: Record<string, string> = {
  arrow: "0 0 64 48",
  underline: "0 0 120 14",
  star: "0 0 24 24",
  heart: "0 0 24 24",
  scribble: "0 0 90 34",
};
---

<svg
  class:list={["sb-doodle", `sb-doodle-${name}`, className]}
  aria-hidden="true"
  viewBox={viewBoxes[name]}
  fill="none"
  stroke="currentColor"
  stroke-width="2.2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === "arrow" && (
    <>
      <path d="M6 42 C 20 38, 38 30, 48 14"></path>
      <path d="M39 10 l10 4 -4 10"></path>
    </>
  )}
  {name === "underline" && <path d="M3 9 Q 13 3 23 9 T 43 9 T 63 9 T 83 9 T 103 9 T 117 8"></path>}
  {name === "star" && (
    <path d="M12 3.5 l2.4 5.3 5.8 .7 -4.3 4 1.1 5.7 -5 -2.8 -5 2.8 1.1 -5.7 -4.3 -4 5.8 -.7z"></path>
  )}
  {name === "heart" && (
    <path
      d="M12 20 C 6 15.5 3.5 11.5 5.4 8.2 7 5.4 10.6 5.2 12 8 c 1.4 -2.8 5 -2.6 6.6 .2 1.9 3.3 -.6 7.3 -6.6 11.8z"
    ></path>
  )}
  {name === "scribble" && (
    <>
      <path d="M5 9 l12 -4 14 5 16 -5 14 5 12 -4"></path>
      <path d="M7 17 l14 -4 12 5 16 -5 14 5 10 -4"></path>
      <path d="M9 25 l12 -4 16 5 12 -5 14 5 10 -4"></path>
    </>
  )}
</svg>
