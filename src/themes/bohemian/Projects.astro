---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectsProps } from "#/themes/types";
import Layout from "./Layout.astro";
import Weave from "./Weave.astro";

const { projects } = Astro.props as ProjectsProps;
---

<Layout
  title="Projects — jwstn.dev"
  description="Four works in progress by JW — a vinyl collectors' forum, a terminal Spotify client, an app for learning sign language, and one very personal note app."
>
  <header class="boh-pagehead boh-fade">
    <p class="boh-stamp">The market</p>
    <h1 class="boh-display">Projects</h1>
    <p class="boh-lede">
      Four goods on the table: a collectors' forum, a terminal client, a language
      trainer, and one very personal note app. All works in progress; all made in
      earnest.
    </p>
  </header>

  <Weave variant="band" class="boh-divider" />

  <ol class="boh-goods boh-fade boh-fade-2">
    {
      projects.map((project, i) => (
        <li class="boh-good">
          <a class="boh-good-link" href={`/projects/${project.id}/`}>
            <Weave variant="thin" class="boh-good-weave" />
            <div class="boh-good-body">
              <p class="boh-good-top">
                <span class="boh-good-no">No. {String(i + 1).padStart(2, "0")}</span>
                <span class="boh-good-date">
                  <FormattedDate date={project.data.pubDate} />
                </span>
              </p>
              <h2 class="boh-good-title">{project.data.title}</h2>
              <p class="boh-good-desc">{project.data.description}</p>
              <p class="boh-good-foot">
                {project.data.tags.map((tag) => (
                  <span class="boh-tag">{tag}</span>
                ))}
              </p>
            </div>
          </a>
        </li>
      ))
    }
  </ol>
</Layout>
