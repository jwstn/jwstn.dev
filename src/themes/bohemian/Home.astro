---
import type { HomeProps } from "#/themes/types";
import Layout from "./Layout.astro";
import Weave from "./Weave.astro";

Astro.props as HomeProps;

const market = [
  {
    href: "/projects",
    title: "Projects",
    note: "Four goods on the table",
  },
  {
    href: "/blog",
    title: "Blog",
    note: "The loom is strung — nothing woven yet",
  },
  {
    href: "/gallery",
    title: "Gallery",
    note: "Three blankets: Japan, a summer, a spring",
  },
];
---

<Layout
  title="jwstn.dev — JW, full-stack developer in Cologne"
  description="JW builds web applications with TanStack, experiments with Effect, and takes his camera everywhere — most recently to Japan."
>
  <section class="boh-hero boh-fade">
    <div class="boh-sun" aria-hidden="true"></div>
    <p class="boh-stamp">JW &middot; full-stack developer &middot; Cologne</p>
    <h1 class="boh-display">
      Made by hand,<br />
      <em>shipped by wire.</em>
    </h1>
    <p class="boh-hero-copy">
      I'm JW, a full-stack developer in Cologne. Most of my days go into web
      applications with
      <a href="https://tanstack.com/" target="_blank" rel="noopener noreferrer">TanStack</a>
      — it covers so much of what a modern app needs that
      <a href="https://hono.dev/" target="_blank" rel="noopener noreferrer">Hono</a>
      and
      <a href="https://elysiajs.com/" target="_blank" rel="noopener noreferrer">Elysia</a>
      are still waiting their turn at the stall. What I did make time for is
      <a href="https://effect.website/" target="_blank" rel="noopener noreferrer">Effect</a>
      — the most fun I've had in a while, relearning how a program can be written.
      When the keyboard rests, the camera comes out; in 2026 it came along to Japan,
      and it hasn't really been put away since.
    </p>
  </section>

  <Weave variant="band" class="boh-divider" />

  <section class="boh-fade boh-fade-2" aria-labelledby="boh-market-h">
    <h2 id="boh-market-h" class="boh-sec-title">
      <span class="boh-stamp boh-stamp--alt">The market</span>
    </h2>
    <ul class="boh-rows">
      {
        market.map((m) => (
          <li>
            <a class="boh-row" href={m.href}>
              <span class="boh-row-diamond" aria-hidden="true" />
              <span class="boh-row-title">{m.title}</span>
              <span class="boh-row-leader" aria-hidden="true" />
              <span class="boh-row-note">{m.note}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
