---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectProps } from "#/themes/types";
import Layout from "./Layout.astro";
import Weave from "./Weave.astro";

const { project, Content } = Astro.props as ProjectProps;
const { title, description, pubDate, href, tags } = project.data;
---

<Layout title={`${title} — jwstn.dev`} description={description}>
  <article class="boh-article">
    <p class="boh-backrow boh-fade">
      <a class="boh-back" href="/projects">&larr; The market</a>
    </p>

    <header class="boh-fade">
      <p class="boh-stamp">A work in progress</p>
      <h1 class="boh-article-title">{title}</h1>
      <p class="boh-meta">
        <FormattedDate date={pubDate} />
        <span aria-hidden="true"> &middot; </span>
        <a class="boh-meta-link" href={href} target="_blank" rel="noopener noreferrer">
          Visit the piece<span aria-hidden="true"> &#8599;</span>
        </a>
      </p>
    </header>

    <Weave variant="band" class="boh-divider" />

    <div class="boh-prose boh-fade boh-fade-2">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <p class="boh-tags-end">
          {tags.map((tag) => (
            <span class="boh-tag">{tag}</span>
          ))}
        </p>
      )
    }

    <Weave variant="fringe" class="boh-divider" />
  </article>
</Layout>
