---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { AlbumProps } from "#/themes/types";
import Layout from "./Layout.astro";
import Weave from "./Weave.astro";

const { album } = Astro.props as AlbumProps;
const { title, pubDate, photos } = album.data;

const photoCount = `${photos.length} photograph${photos.length === 1 ? "" : "s"}`;
---

<Layout
  title={`${title} — jwstn.dev`}
  description={`Photographs from ${title}, woven into a blanket by JW.`}
>
  <p class="boh-backrow boh-fade">
    <a class="boh-back" href="/gallery">&larr; The blanket chest</a>
  </p>

  <header class="boh-article-header boh-fade">
    <p class="boh-stamp">Woven photographs</p>
    <h1 class="boh-article-title">{title}</h1>
    <p class="boh-meta">
      <FormattedDate date={pubDate} />
      <span aria-hidden="true"> &middot; </span>
      {photoCount}
    </p>
  </header>

  <Weave variant="band" class="boh-divider" />

  <div class="boh-quilt boh-fade boh-fade-2">
    {
      photos.map((photo) => (
        <figure class="boh-quilt-square">
          <div class="boh-quilt-window">
            <Image
              src={photo.image}
              alt={photo.title}
              widths={[480, 800, 1200]}
              sizes="(min-width: 70rem) 21rem, (min-width: 48rem) 30vw, calc(100vw - 3.6rem)"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="boh-quilt-caption">
            <span class="boh-quilt-title">{photo.title}</span>
            {photo.caption && <span class="boh-quilt-note">{photo.caption}</span>}
          </figcaption>
        </figure>
      ))
    }
  </div>
</Layout>
