---
// The woven kilim band — this theme's signature divider.
// "band"  = wide section divider (rust stripes, sage hairlines, diamond field)
// "thin"  = narrow strip used to trim cards
// "fringe" = a thread with small diamonds hanging from it (tassel edge)
interface Props {
  variant?: "band" | "thin" | "fringe";
  class?: string;
}

const { variant = "band", class: className } = Astro.props;
---

<div class:list={["boh-weave", `boh-weave--${variant}`, className]} aria-hidden="true"></div>
