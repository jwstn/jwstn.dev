---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { GalleryProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { albums } = Astro.props as GalleryProps;
---

<Layout title="Gallery | jwstn.dev" description="Pictures JW took with the camera he bought in Japan.">
  <div class="y2k-pagehead">
    <p class="y2k-kicker y2k-pop y2k-pop-1">✧ memory bank ✧</p>
    <h1 class="y2k-h1 y2k-chrome-text y2k-pop y2k-pop-2">Gallery</h1>
    <p class="y2k-lede y2k-pop y2k-pop-3">
      On my trip to Japan in March 2026 I finally bought a camera — something I'd wanted for years. These are the
      pictures it has collected since. More film rolls pending.
    </p>
  </div>

  <ul class="y2k-album-grid">
    {
      albums.map((album) => (
        <li>
          <a class="y2k-album-link" href={`/gallery/${album.data.slug}/`}>
            <article class="y2k-card y2k-album-card">
              <div class="y2k-frame">
                <Image
                  src={album.data.photos[0].image}
                  widths={[480, 800]}
                  sizes="(min-width: 720px) 22rem, 100vw"
                  loading="lazy"
                  decoding="async"
                  alt={album.data.photos[0].title}
                />
              </div>
              <div class="y2k-album-meta">
                <h2 class="y2k-album-title">{album.data.title}</h2>
                <span class="y2k-chip">{album.data.photos.length} snapshots</span>
              </div>
              <div class="y2k-album-meta" style="justify-content: flex-start;">
                <span class="y2k-chip">
                  <FormattedDate date={album.data.pubDate} />
                </span>
                <span class="y2k-open-pill" aria-hidden="true">
                  open album →
                </span>
              </div>
            </article>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
