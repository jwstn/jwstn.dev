---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <article class="y2k-detail">
    <a class="y2k-backlink" href="/blog" aria-label="Back to the blog">← back to the blog</a>

    <p class="y2k-kicker" style="margin-top: 1.2rem;">
      ★ blog entry ★
    </p>
    <h1 class="y2k-h1 y2k-chrome-text y2k-pop y2k-pop-1">{title}</h1>

    <div class="y2k-detail-header">
      <span class="y2k-chip">
        <FormattedDate date={pubDate} />
      </span>
      {
        updatedDate && (
          <span class="y2k-chip">
            updated <FormattedDate date={updatedDate} />
          </span>
        )
      }
    </div>

    {
      heroImage && (
        <div class="y2k-frame" style="margin-bottom: 2rem;">
          <Image src={heroImage} alt={title} width={1020} height={510} loading="eager" decoding="async" />
        </div>
      )
    }

    <div class="y2k-prose">
      <Content />
    </div>

    <p style="margin-top: 2.5rem;">
      <a class="y2k-btn" href="/blog">← more transmissions</a>
    </p>
  </article>
</Layout>
