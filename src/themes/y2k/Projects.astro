---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectsProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { projects } = Astro.props as ProjectsProps;
const numbered = projects.map((project, index) => ({ project, index }));
---

<Layout title="Projects | jwstn.dev" description="Things JW has built and is still polishing.">
  <div class="y2k-pagehead">
    <p class="y2k-kicker y2k-pop y2k-pop-1">☆ featured downloads ☆</p>
    <h1 class="y2k-h1 y2k-chrome-text y2k-pop y2k-pop-2">Projects</h1>
    <p class="y2k-lede y2k-pop y2k-pop-3">
      A few builds from the lab — every one of them taught me something, and most of them are still uploading.
    </p>
  </div>

  <ul class="y2k-grid">
    {
      numbered.map(({ project, index }) => (
        <li>
          <a class="y2k-project-link" href={`/projects/${project.id}/`}>
            <article class="y2k-card y2k-project-card">
              <div class="y2k-project-top">
                <span class="y2k-num" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h2 class="y2k-project-title">{project.data.title}</h2>
              </div>
              <p class="y2k-project-desc">{project.data.description}</p>
              <div class="y2k-tags">
                {project.data.tags.map((tag) => (
                  <span class="y2k-tag">{tag}</span>
                ))}
              </div>
              <div class="y2k-project-meta">
                <span class="y2k-chip">
                  <FormattedDate date={project.data.pubDate} />
                </span>
                <span class="y2k-open-pill" aria-hidden="true">
                  open →
                </span>
              </div>
            </article>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
