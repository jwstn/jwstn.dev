---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { BlogProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { posts } = Astro.props as BlogProps;
---

<Layout title="Blog | jwstn.dev" description="Notes from JW's workbench — the first entry is uploading.">
  <div class="y2k-pagehead">
    <p class="y2k-kicker y2k-pop y2k-pop-1">✎ transmissions ✎</p>
    <h1 class="y2k-h1 y2k-chrome-text y2k-pop y2k-pop-2">Blog</h1>
    <p class="y2k-lede y2k-pop y2k-pop-3">
      Notes from the workbench and the road — published whenever something is worth keeping.
    </p>
  </div>

  {
    posts.length === 0 ? (
      <section class="y2k-card y2k-empty y2k-pop y2k-pop-4" aria-label="No posts yet">
        <div class="y2k-empty-orb" aria-hidden="true" />
        <h2>Loading first post…</h2>
        <p>
          The blog module is dialing in. No entries have shipped yet — but the first one is already queued up:
          notes from the Effect lab, or maybe the film rolls from the Japan 2026 trip. Stay connected, this bar
          only moves forward.
        </p>
        <div class="y2k-bar y2k-empty-bar" aria-hidden="true">
          <div class="y2k-bar-fill" style="width: 12%" />
        </div>
        <p class="y2k-empty-readout">first post pending — 12%</p>
        <div class="y2k-empty-actions">
          <a class="y2k-btn y2k-btn-primary" href="/projects">
            see what's building →
          </a>
          <a class="y2k-btn" href="/gallery">
            browse the gallery
          </a>
        </div>
      </section>
    ) : (
      <ul class="y2k-grid">
        {posts.map((post) => (
          <li>
            <a class="y2k-project-link" href={`/blog/${post.id}/`}>
              <article class="y2k-card y2k-project-card">
                {post.data.heroImage && (
                  <div class="y2k-frame">
                    <Image
                      src={post.data.heroImage}
                      alt=""
                      width={1020}
                      height={510}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <h2 class="y2k-project-title">{post.data.title}</h2>
                <p class="y2k-project-desc">{post.data.description}</p>
                <div class="y2k-project-meta">
                  <span class="y2k-chip">
                    <FormattedDate date={post.data.pubDate} />
                    {post.data.updatedDate && (
                      <span> · updated <FormattedDate date={post.data.updatedDate} /></span>
                    )}
                  </span>
                  <span class="y2k-open-pill" aria-hidden="true">
                    read →
                  </span>
                </div>
              </article>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Layout>
