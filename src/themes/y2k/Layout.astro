---
import { SOCIALS } from "#/lib/content";
import MetaTags from "#/themes/shared/MetaTags.astro";
import ThemeSwitcher from "#/themes/shared/ThemeSwitcher.astro";
import type { LayoutProps } from "#/themes/types";
import "./theme.css";

const { title, description } = Astro.props as LayoutProps;
const year = new Date().getFullYear();

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" || path === "" : path.startsWith(href));

const nav = [
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/gallery", label: "Gallery" },
];
---

<html lang="en" class="theme-y2k">
  <head>
    <MetaTags title={title} description={description} />
  </head>
  <body>
    <div class="y2k-scene" aria-hidden="true">
      <div class="y2k-bubble y2k-bubble-1"></div>
      <div class="y2k-bubble y2k-bubble-2"></div>
      <div class="y2k-bubble y2k-bubble-3"></div>
      <div class="y2k-bubble y2k-bubble-4"></div>
      <div class="y2k-bubble y2k-bubble-5"></div>
      <div class="y2k-bubble y2k-bubble-6"></div>
    </div>

    <header class="y2k-header">
      <nav class="y2k-nav" aria-label="Primary">
        <a class="y2k-brand" href="/">jwstn.dev</a>
        {
          nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
        {
          SOCIALS.map((s) => (
            <a class="y2k-nav-external" href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label} ↗
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="y2k-footer">
      <div class="y2k-card y2k-footer-inner">
        <p class="y2k-footer-copy">&copy; {year} jwstn — Cologne, Germany</p>
        <ul class="y2k-footer-links">
          {
            SOCIALS.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="y2k-footer-status" aria-hidden="true">
          <span class="y2k-status-label">signal</span>
          <div class="y2k-bar">
            <div class="y2k-bar-fill" style="width: 100%"></div>
          </div>
          <span class="y2k-status-value">excellent ✦</span>
        </div>
      </div>
    </footer>

    <ThemeSwitcher />
  </body>
</html>
