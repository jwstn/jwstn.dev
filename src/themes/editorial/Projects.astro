---
// editorial — Projects.astro
// Index page: numbered entries with hanging indents, hairline separators.
import FormattedDate from "#/components/FormattedDate.astro";
import Layout from "./Layout.astro";
import type { ProjectsProps } from "#/themes/types";

const { projects } = Astro.props as ProjectsProps;
const pad = (n: number) => String(n).padStart(2, "0");
---

<Layout title="Projects | jwstn.dev" description="Things JW has built — works in progress, indexed.">
  <div class="ed-page">
  <header>
    <p class="ed-kicker ed-anim-rise" style="--ed-i: 0">
      <span class="ed-kicker-no">№01</span>
      <span>The Index — Works in Progress</span>
      <span class="ed-kicker-right" aria-hidden="true">Page 02</span>
    </p>
    <h1 class="ed-display ed-display-page ed-anim-rise" style="--ed-i: 1">The Projects.</h1>
    <p class="ed-standfirst ed-anim-rise" style="--ed-i: 2">
      Everything on the desk, in order of filing — four entries. Some are nearly set; some are
      still in proofs.
    </p>
  </header>

  <ol class="ed-index">
    {
      projects.map((project, i) => (
        <li class="ed-index-row ed-anim-rise" style={`--ed-i: ${i + 3}`}>
          <a class="ed-index-link" href={`/projects/${project.id}/`}>
            <span class="ed-index-no" aria-hidden="true">
              {pad(i + 1)}
            </span>
            <span>
              <span class="ed-index-title">{project.data.title}</span>
              <span class="ed-index-desc">{project.data.description}</span>
              <span class="ed-index-tags">{project.data.tags.join(" · ")}</span>
            </span>
            <span class="ed-index-date">
              <FormattedDate date={project.data.pubDate} />
            </span>
          </a>
        </li>
      ))
    }
  </ol>
  </div>
</Layout>
