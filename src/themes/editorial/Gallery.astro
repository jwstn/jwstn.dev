---
// editorial — Gallery.astro
// Contact sheets: each album is a row with a numbered entry and a strip of
// frames, like a film contact sheet on a light table.
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import Layout from "./Layout.astro";
import type { GalleryProps } from "#/themes/types";

const { albums } = Astro.props as GalleryProps;
const pad = (n: number) => String(n).padStart(2, "0");
---

<Layout title="Gallery | jwstn.dev" description="Pictures JW took with a camera bought in Japan.">
  <div class="ed-page">
  <header>
    <p class="ed-kicker ed-anim-rise" style="--ed-i: 0">
      <span class="ed-kicker-no">№03</span>
      <span>Contact Sheets</span>
      <span class="ed-kicker-right" aria-hidden="true">Page 04</span>
    </p>
    <h1 class="ed-display ed-display-page ed-anim-rise" style="--ed-i: 1">The Gallery.</h1>
    <p class="ed-standfirst ed-anim-rise" style="--ed-i: 2">
      In March 2026, somewhere mid-trip in Japan, the camera finally got bought — years of wanting
      one, no more excuses. What came home is filed here, frame by frame.
    </p>
  </header>

  <ol class="ed-index">
    {
      albums.map((album, i) => (
        <li class="ed-index-row ed-anim-rise" style={`--ed-i: ${i + 3}`}>
          <a class="ed-index-link" href={`/gallery/${album.data.slug}/`}>
            <span class="ed-index-no" aria-hidden="true">
              {pad(i + 1)}
            </span>
            <span>
              <span class="ed-index-title">{album.data.title}</span>
              <span class="ed-index-tags">
                {album.data.photos.length} frames · filed{" "}
                <FormattedDate date={album.data.pubDate} />
              </span>
            </span>
            <span class="ed-contact">
              {album.data.photos.slice(0, 6).map((photo) => (
                <Image
                  class="ed-contact-frame"
                  src={photo.image}
                  alt={photo.title}
                  widths={[96, 160, 240]}
                  sizes="(min-width: 40rem) 3.4rem, 2.2rem"
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
  </div>
</Layout>
