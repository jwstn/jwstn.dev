---
// editorial — Post.astro
// A single dispatch. Unreachable for now (the blog collection is empty) but
// built to the same standard: kicker, headline, standfirst, dateline,
// optional hero plate, prose with drop cap, back link.
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import Layout from "./Layout.astro";
import type { PostProps } from "#/themes/types";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <div class="ed-page">
  <article>
    <header>
      <p class="ed-kicker ed-anim-rise" style="--ed-i: 0">
        <span class="ed-kicker-no">№02</span>
        <span>The Back Pages — Dispatch</span>
        <span class="ed-kicker-right" aria-hidden="true">Page 03</span>
      </p>

      <h1 class="ed-display ed-display-page ed-anim-rise" style="--ed-i: 1">{title}</h1>

      <p class="ed-standfirst ed-anim-rise" style="--ed-i: 2">{description}</p>

      <div class="ed-credit ed-anim-rise" style="--ed-i: 3">
        <span>Filed <FormattedDate date={pubDate} /></span>
        {updatedDate && <span>Amended <FormattedDate date={updatedDate} /></span>}
        <span>By JW</span>
      </div>
    </header>

    {
      heroImage && (
        <figure class="ed-hero ed-anim-rise" style="--ed-i: 4">
          <Image
            src={heroImage}
            alt={title}
            widths={[800, 1200, 1600]}
            sizes="(min-width: 76rem) 70rem, 94vw"
            loading="eager"
          />
        </figure>
      )
    }

    <div class="ed-prose ed-anim-rise" style="--ed-i: 5">
      <Content />
    </div>

    <div class="ed-rule ed-anim-rule"></div>
    <a class="ed-backlink" href="/blog/">← Back to The Back Pages</a>
  </article>
  </div>
</Layout>
