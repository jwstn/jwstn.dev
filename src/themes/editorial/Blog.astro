---
// editorial — Blog.astro
// The Back Pages: currently an empty section — the empty state is the design.
// List markup below is ready for real posts.
import FormattedDate from "#/components/FormattedDate.astro";
import Layout from "./Layout.astro";
import type { BlogProps } from "#/themes/types";

const { posts } = Astro.props as BlogProps;
const pad = (n: number) => String(n).padStart(2, "0");
const today = new Date().toLocaleDateString("en-us", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title="Blog | jwstn.dev" description="Occasional writing by JW — The Back Pages.">
  <div class="ed-page">
  <header>
    <p class="ed-kicker ed-anim-rise" style="--ed-i: 0">
      <span class="ed-kicker-no">№02</span>
      <span>The Back Pages — Dispatches</span>
      <span class="ed-kicker-right" aria-hidden="true">Page 03</span>
    </p>
    <h1 class="ed-display ed-display-page ed-anim-rise" style="--ed-i: 1">Dispatches.</h1>
  </header>

  {
    posts.length === 0 ? (
      <section class="ed-empty ed-anim-rise" style="--ed-i: 2" aria-label="No entries yet">
        <p class="ed-empty-stamp">Reserved</p>
        <p class="ed-empty-title">Nothing filed yet.</p>
        <p class="ed-empty-text">
          The Back Pages are set aside for writing — when a piece is worth printing it will appear
          here: dated, typeset, and filed under its own headline. Until then, the desk stays clear
          and the notebook stays open.
        </p>
        <p class="ed-empty-meta">0 entries · last checked {today}</p>
      </section>
    ) : (
      <ol class="ed-index">
        {posts.map((post, i) => (
          <li class="ed-index-row ed-anim-rise" style={`--ed-i: ${i + 2}`}>
            <a class="ed-index-link" href={`/blog/${post.id}/`}>
              <span class="ed-index-no" aria-hidden="true">
                {pad(i + 1)}
              </span>
              <span>
                <span class="ed-index-title">{post.data.title}</span>
                <span class="ed-index-desc">{post.data.description}</span>
              </span>
              <span class="ed-index-date">
                <FormattedDate date={post.data.pubDate} />
              </span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
  </div>
</Layout>
