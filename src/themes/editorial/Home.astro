---
// editorial — Home.astro
// The cover: feature kicker, huge serif headline, italic lede with drop cap,
// and an "In this issue" table of contents.
import Layout from "./Layout.astro";
import type { HomeProps } from "#/themes/types";

const {} = Astro.props as HomeProps;
---

<Layout title="jwstn.dev" description="The portfolio of JW — full-stack developer in Cologne, Germany.">
  <div class="ed-page ed-cover">
  <header>
    <p class="ed-kicker ed-anim-rise" style="--ed-i: 0">
      <span class="ed-kicker-no">Feature</span>
      <span>The Developer — Full-Stack</span>
      <span class="ed-kicker-right" aria-hidden="true">Page 01</span>
    </p>

    <h1 class="ed-display ed-anim-rise" style="--ed-i: 1">
      Full-stack, Cologne. Building with <em>TanStack</em>, thinking in <em>Effect</em>.
    </h1>

    <p class="ed-standfirst ed-anim-rise" style="--ed-i: 2">
      JW is a full-stack developer working out of Cologne, Germany. The daily paper is web
      applications, set in <a href="https://tanstack.com/" target="_blank" rel="noopener noreferrer">TanStack</a> —
      it covers most of what a modern app needs, server actions and middleware included, which is
      precisely why <a href="https://hono.dev/" target="_blank" rel="noopener noreferrer">Hono</a> and
      <a href="https://elysiajs.com/" target="_blank" rel="noopener noreferrer">Elysia</a> are still on the
      reading list. What he did get around to is
      <a href="https://effect.website/" target="_blank" rel="noopener noreferrer">EffectTS</a> — amazing
      fun so far, and a genuinely new way to think about building programs.
    </p>
  </header>

  <div class="ed-rule ed-anim-rule" style="margin-top: 3.4rem"></div>

  <section class="ed-toc" aria-label="In this issue">
    <p class="ed-section-label ed-anim-rise" style="--ed-i: 3">In this issue</p>
    <ol class="ed-toc-list">
      <li>
        <a class="ed-toc-row ed-anim-rise" style="--ed-i: 4" href="/projects/">
          <span class="ed-toc-no" aria-hidden="true">01</span>
          <span>
            <span class="ed-toc-title">Projects</span>
            <span class="ed-toc-desc">
              Four works in progress, indexed — a vinyl forum, a personal note app, a terminal for
              Spotify, and an app for learning sign language.
            </span>
          </span>
          <span class="ed-toc-page" aria-hidden="true">p. 02</span>
        </a>
      </li>
      <li>
        <a class="ed-toc-row ed-anim-rise" style="--ed-i: 5" href="/blog/">
          <span class="ed-toc-no" aria-hidden="true">02</span>
          <span>
            <span class="ed-toc-title">The Back Pages</span>
            <span class="ed-toc-desc">
              Reserved for dispatches. Nothing filed yet — the desk is clear, the notebook is open.
            </span>
          </span>
          <span class="ed-toc-page" aria-hidden="true">p. 03</span>
        </a>
      </li>
      <li>
        <a class="ed-toc-row ed-anim-rise" style="--ed-i: 6" href="/gallery/">
          <span class="ed-toc-no" aria-hidden="true">03</span>
          <span>
            <span class="ed-toc-title">The Gallery</span>
            <span class="ed-toc-desc">
              Contact sheets from a camera bought on the Japan trip, March 2026 — cherry blossoms,
              highland cattle, and one very good dog.
            </span>
          </span>
          <span class="ed-toc-page" aria-hidden="true">p. 04</span>
        </a>
      </li>
    </ol>
  </section>
  </div>
</Layout>
