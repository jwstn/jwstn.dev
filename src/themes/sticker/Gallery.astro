---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import Blob from "./Blob.astro";
import Layout from "./Layout.astro";
import type { GalleryProps } from "#/themes/types";

const { albums } = Astro.props as GalleryProps;
---

<Layout
  title="Gallery | jwstn.dev"
  description="Photo stickers by JW — from Cologne walks to the camera that came home from Japan in 2026."
>
  <article>
    <p class="stk-kicker stk-pop">the photo sticker album</p>
    <h1 class="stk-page-title stk-pop d1">
      <span class="stk-blobhead">
        <Blob variant={1} class="stk-blob-bg c-mint" />
        <span>Photo stickers!</span>
      </span>
    </h1>
    <p class="stk-page-lede stk-pop d2">
      I bought a camera on my Japan trip in March 2026 and it hasn't left my bag since. These are the
      sticker sheets it earned.
    </p>

    <ul class="stk-albums">
      {
        albums.map((album) => (
          <li class="stk-album">
            <a href={`/gallery/${album.data.slug}/`}>
              <span class="stk-album-cover">
                <Image
                  src={album.data.photos[0].image}
                  alt={`${album.data.title} cover photo: ${album.data.photos[0].title}`}
                  widths={[480, 800]}
                  sizes="(min-width: 64rem) 20rem, 90vw"
                  loading="lazy"
                />
              </span>
              <span>
                <span class="stk-album-title">{album.data.title}</span>
                <span class="stk-album-sub">
                  <FormattedDate date={album.data.pubDate} /> ·{" "}
                  {album.data.photos.length} photo stickers
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </article>
</Layout>
