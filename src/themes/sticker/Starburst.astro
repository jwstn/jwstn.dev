---
// Starburst sticker badge (SVG burst + centered label).
interface Props {
  text: string;
  class?: string;
}

const { text, class: className = "" } = Astro.props;

const POINTS = 28;
const pts = Array.from({ length: POINTS }, (_, i) => {
  const angle = (Math.PI * 2 * i) / POINTS - Math.PI / 2;
  const radius = i % 2 === 0 ? 58 : 45;
  return `${(60 + radius * Math.cos(angle)).toFixed(1)} ${(60 + radius * Math.sin(angle)).toFixed(1)}`;
}).join(" ");
---

<svg viewBox="0 0 120 120" class={`stk-burst ${className}`} role="img" aria-label={text}>
  <polygon points={pts}></polygon>
  <text x="60" y="61" text-anchor="middle" dominant-baseline="central">{text}</text>
</svg>
