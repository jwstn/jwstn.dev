---
import FormattedDate from "#/components/FormattedDate.astro";
import Blob from "./Blob.astro";
import Layout from "./Layout.astro";
import Starburst from "./Starburst.astro";
import type { BlogProps } from "#/themes/types";

const { posts } = Astro.props as BlogProps;
---

<Layout
  title="Blog | jwstn.dev"
  description="Occasional writing by JW — or, for now, a beautifully empty sticker sheet."
>
  {posts.length === 0 ? (
    <section class="stk-empty" aria-labelledby="stk-empty-heading">
      <div class="stk-empty-head stk-pop">
        <Starburst text="EMPTY!" class="stk-empty-burst" />
        <p class="stk-kicker">the blog section</p>
        <h1 id="stk-empty-heading" class="stk-empty-title">
          <span class="stk-blobhead">
            <Blob variant={2} class="stk-blob-bg c-blue" />
            <span>This page is still in shrink-wrap!</span>
          </span>
        </h1>
      </div>

      <p class="stk-empty-lede stk-pop d1">
        JW hasn't written any posts yet. The sticker sheet is printed, the glue is ready — the words just
        haven't shown up. Check back later and this page will be covered in stickers.
      </p>

      <div class="stk-sheet stk-pop d2" aria-hidden="true">
        <span class="stk-slot"></span>
        <span class="stk-slot"></span>
        <span class="stk-slot stk-slot-ghost">reserved for post №01</span>
        <span class="stk-slot"></span>
        <span class="stk-slot"></span>
        <span class="stk-slot"></span>
      </div>

      <p class="stk-hand stk-pop d3">
        between us: the first post is still somewhere between JW's head and the keyboard.
      </p>

      <div class="stk-empty-actions stk-pop d3">
        <a class="stk-btn" href="/projects">flip through the trading cards</a>
        <a class="stk-btn stk-btn-pink" href="/gallery">or browse photo stickers</a>
      </div>
    </section>
  ) : (
    <article>
      <p class="stk-kicker stk-pop">fresh from the pen</p>
      <h1 class="stk-page-title stk-pop d1">
        <span class="stk-blobhead">
          <Blob variant={1} class="stk-blob-bg c-blue" />
          <span>Blog stickers!</span>
        </span>
      </h1>
      <p class="stk-page-lede stk-pop d2">Words, peeled off JW's desk one post at a time.</p>
      <ul class="stk-posts">
        {
          posts.map((post) => (
            <li>
              <h2>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="stk-meta">
                <FormattedDate date={post.data.pubDate} />
                {post.data.updatedDate && (
                  <span>
                    {" "}
                    — updated <FormattedDate date={post.data.updatedDate} />
                  </span>
                )}
              </p>
              <p class="stk-post-desc">{post.data.description}</p>
            </li>
          ))
        }
      </ul>
    </article>
  )}
</Layout>
