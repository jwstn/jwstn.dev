---
// Wobbly SVG blob used behind headings (candy fill via a `c-*` color class).
interface Props {
  variant?: 1 | 2 | 3;
  class?: string;
}

const { variant = 1, class: className = "" } = Astro.props;

const paths: Record<number, string> = {
  1: "M18,62 C14,28 52,8 98,12 C146,16 186,26 184,58 C182,92 148,110 98,108 C50,106 22,96 18,62 Z",
  2: "M25,55 C10,20 70,5 105,15 C150,27 195,20 192,60 C189,98 150,112 105,105 C60,98 38,90 25,55 Z",
  3: "M15,70 C5,30 60,15 100,10 C150,4 195,35 190,65 C185,100 140,115 95,110 C50,105 25,105 15,70 Z",
};
---

<svg
  viewBox="0 0 200 120"
  preserveAspectRatio="none"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[variant]}></path>
</svg>
