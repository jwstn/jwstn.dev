---
import FormattedDate from "#/components/FormattedDate.astro";
import Blob from "./Blob.astro";
import Layout from "./Layout.astro";
import type { ProjectProps } from "#/themes/types";

const { project, Content } = Astro.props as ProjectProps;
const { title, description, pubDate, href, tags } = project.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <article class="stk-article">
    <a class="stk-back" href="/projects">← back to the binder</a>

    <header>
      <p class="stk-kicker">trading card · story mode</p>
      <h1 class="stk-article-title">
        <span class="stk-blobhead">
          <Blob variant={1} class="stk-blob-bg c-peach" />
          <span>{title}</span>
        </span>
      </h1>
      <div class="stk-article-meta">
        <span class="stk-datepill">
          <FormattedDate date={pubDate} />
        </span>
        <ul class="stk-chips" aria-label="Tags">
          {tags.map((tag) => (
            <li class="stk-chip">{tag}</li>
          ))}
        </ul>
      </div>
      <p class="stk-lede">{description}</p>
      <a class="stk-btn" href={href} target="_blank" rel="noopener noreferrer">
        visit the real thing <span aria-hidden="true">↗</span>
      </a>
    </header>

    <div class="stk-prose">
      <Content />
    </div>

    <p class="stk-fin">end of card</p>
  </article>
</Layout>
