---
import type { HomeProps } from "#/themes/types";
import Layout from "./Layout.astro";

const {} = Astro.props as HomeProps;
---

<Layout
  title="Welcome | jwstn.dev"
  description="JW's personal site — full-stack projects from Cologne, the odd transmission, and photos from the Japan 2026 camera trip."
>
  <main class="sw-main">
    <section class="sw-hero">
      <p class="sw-kicker sw-rise" style="--d: 0s">
        <span class="sw-live" aria-hidden="true"></span> ON AIR &middot; COLOGNE, DE
      </p>
      <h1 class="sw-hero-title">
        <span class="sw-rise" style="--d: 0.08s">Full-stack,</span>
        <span class="sw-chrome sw-rise" style="--d: 0.16s">in stereo.</span>
      </h1>
      <p class="sw-hero-sub sw-rise" style="--d: 0.24s">
        I&rsquo;m JW. I build web applications with
        <a href="https://tanstack.com/" target="_blank" rel="noopener noreferrer">TanStack</a>. On the test bench
        right now: <a href="https://effect.website/" target="_blank" rel="noopener noreferrer">Effect</a> &mdash;
        amazing fun, and proof there&rsquo;s more than one way to wire a program. Still queued for a ride:
        <a href="https://hono.dev/" target="_blank" rel="noopener noreferrer">Hono</a> and
        <a href="https://elysiajs.com/" target="_blank" rel="noopener noreferrer">Elysia</a>. When the console dims,
        I&rsquo;m behind a camera picked up in Japan in March 2026 &mdash; the frames land in the gallery.
      </p>
      <p class="sw-status sw-rise" style="--d: 0.32s">
        <span>NOW PLAYING</span>
        <span class="sw-hot">4 PROJECTS ON THE GRID</span>
        <span>BLOG: OFF AIR</span>
        <span>REELS: LOADED</span>
      </p>

      <ul class="sw-card-grid sw-rise" style="--d: 0.4s">
        <li>
          <a class="sw-panel" href="/projects/">
            <span class="sw-num">A1</span>
            <h2 class="sw-card-title">Projects</h2>
            <p class="sw-card-blurb">
              The catalog &mdash; four builds cut and pressed: a vinyl forum, a terminal jukebox, a note app with
              real history, and an ASL trainer.
            </p>
            <span class="sw-cta">Drop the needle &rarr;</span>
          </a>
        </li>
        <li>
          <a class="sw-panel" href="/gallery/">
            <span class="sw-num">A2</span>
            <h2 class="sw-card-title">Gallery</h2>
            <p class="sw-card-blurb">
              Frames from the camera I bought in Japan in March 2026 &mdash; cherry blossoms, highland cows, and
              the best boy.
            </p>
            <span class="sw-cta">Roll film &rarr;</span>
          </a>
        </li>
        <li>
          <a class="sw-panel" href="/blog/">
            <span class="sw-num">B1</span>
            <h2 class="sw-card-title">Blog</h2>
            <p class="sw-card-blurb">
              The transmission archive is empty &mdash; no tapes recorded yet. The deck is warm; the first
              broadcast lands here.
            </p>
            <span class="sw-cta">Check the deck &rarr;</span>
          </a>
        </li>
      </ul>
    </section>
  </main>
</Layout>
