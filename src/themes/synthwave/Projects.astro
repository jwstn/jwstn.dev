---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectsProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { projects } = Astro.props as ProjectsProps;
const side = (i: number) => `A${i + 1}`;
---

<Layout title="Projects | jwstn.dev" description="Projects JW has built.">
  <main class="sw-main">
    <header class="sw-page-head">
      <p class="sw-kicker sw-rise" style="--d: 0s">SIDE A &middot; THE CATALOG</p>
      <h1 class="sw-page-title sw-rise" style="--d: 0.08s">Projects</h1>
      <p class="sw-page-lede sw-rise" style="--d: 0.16s">
        Four tracks pressed in Cologne &mdash; from a vinyl forum to a terminal jukebox. Every plate spins with
        full liner notes on the flip side.
      </p>
      <div class="sw-beam" aria-hidden="true"></div>
    </header>

    <ul class="sw-project-grid">
      {
        projects.map((project, index) => (
          <li>
            <a class="sw-panel" href={`/projects/${project.id}/`}>
              <span class="sw-num">{side(index)}</span>
              <h2 class="sw-card-title">{project.data.title}</h2>
              <p class="sw-project-desc">{project.data.description}</p>
              <ul class="sw-chips">
                {project.data.tags.map((tag) => (
                  <li class="sw-chip">{tag}</li>
                ))}
              </ul>
              <p class="sw-trackline">
                <FormattedDate date={project.data.pubDate} />
                <span class="sw-leader" aria-hidden="true" />
                <span class="sw-cta">Liner notes &rarr;</span>
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
