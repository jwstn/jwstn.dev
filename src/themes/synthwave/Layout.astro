---
import { SOCIALS } from "#/lib/content";
import MetaTags from "#/themes/shared/MetaTags.astro";
import ThemeSwitcher from "#/themes/shared/ThemeSwitcher.astro";
import type { LayoutProps } from "#/themes/types";
import "./theme.css";

// Rendered by the route dispatchers: <T.Layout title=... description=...>
// The page components are fragments that land in the <slot />.
const { title, description } = Astro.props as LayoutProps;
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<html lang="en" class="theme-synthwave">
  <head>
    <MetaTags title={title} description={description} />
  </head>
  <body class="sw-body">
    <!-- fixed sky: gradient wash + stars, no grid lines — never under text -->
    <div class="sw-sky" aria-hidden="true"></div>

    <header class="sw-header">
      <div class="sw-header-inner">
        <a class="sw-brand" href="/">jwstn<span class="sw-brand-tld">.dev</span></a>
        <nav class="sw-nav" aria-label="Primary">
          <a class="sw-nav-link" href="/projects/" aria-current={isActive("/projects/") ? "page" : undefined}>
            Projects
          </a>
          <a class="sw-nav-link" href="/blog/" aria-current={isActive("/blog/") ? "page" : undefined}>Blog</a>
          <a class="sw-nav-link" href="/gallery/" aria-current={isActive("/gallery/") ? "page" : undefined}>
            Gallery
          </a>
          {
            SOCIALS.map((s) => (
              <a
                class="sw-nav-link sw-nav-social"
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {s.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <slot />

    <!-- the scene: scanline sun + perspective grid, always the last stretch of
         the page — decoration only, it can never sit under readable content -->
    <div class="sw-scene" aria-hidden="true">
      <div class="sw-scene-sun"></div>
      <div class="sw-scene-floor">
        <div class="sw-plane"></div>
        <div class="sw-horizon"></div>
      </div>
    </div>

    <footer class="sw-footer">
      <div class="sw-beam" aria-hidden="true"></div>
      <div class="sw-footer-inner">
        <p>&copy; {year} jwstn &mdash; broadcasting from Cologne, DE</p>
        <p class="sw-footer-links">
          {
            SOCIALS.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            ))
          }
        </p>
      </div>
    </footer>

    <ThemeSwitcher />
  </body>
</html>
