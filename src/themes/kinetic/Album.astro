---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { AlbumProps } from "#/themes/types";
import Layout from "./Layout.astro";
import Marquee from "./Marquee.astro";

const { album } = Astro.props as AlbumProps;
const { title, pubDate, photos } = album.data;
const frames = String(photos.length).padStart(2, "0");
---

<Layout title={`${title} | jwstn.dev`} description={`${title} — ${photos.length} photographs by JW.`}>
  <section class="kn-hero kn-hero--page">
    <p class="kn-kicker">Camera roll — {frames} frames</p>
    <h1 class="kn-hl kn-hl--page">
      <span class="kn-line kn-line--slide"><span>{title}</span></span>
    </h1>
    <p class="kn-meta">
      <span class="kn-date">
        <FormattedDate date={pubDate} />
      </span>
      <span class="kn-date">{frames} frames</span>
    </p>
  </section>

  <Marquee text={`${title} /// ${frames} frames /// shot by jwstn`} variant="fill" speed={26} />

  <section class="kn-section">
    <div class="kn-photo-grid">
      {
        photos.map((photo, i) => {
          const ratio = photo.image.width / photo.image.height;
          const isWide = ratio > 1.6;
          const isPortrait = ratio < 0.9;
          return (
            <figure
              class:list={["kn-photo", "kn-reveal", isWide && "kn-photo--wide", isPortrait && "kn-photo--tall"]}
            >
              <Image
                src={photo.image}
                alt={photo.title}
                widths={[480, 800, 1200, 1600]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <span class="kn-photo-num">F.{String(i + 1).padStart(2, "0")}</span>
                <span class="kn-photo-cap">
                  {photo.title}
                  {photo.caption && <span class="kn-photo-note"> — {photo.caption}</span>}
                </span>
              </figcaption>
            </figure>
          );
        })
      }
    </div>
  </section>

  <div class="kn-section">
    <ol class="kn-rows">
      <li>
        <a class="kn-row" href="/gallery/">
          <span class="kn-back-mark" aria-hidden="true">←</span>
          <span class="kn-row-body">
            <span class="kn-row-title">Back to the roll</span>
            <span class="kn-row-sub">Every album, one long lens.</span>
          </span>
          <span class="kn-row-side"><span class="kn-arrow" aria-hidden="true">→</span></span>
        </a>
      </li>
    </ol>
  </div>

  <Marquee text={`${title} /// JWSTN.DEV`} variant="fill" speed={32} />
</Layout>
