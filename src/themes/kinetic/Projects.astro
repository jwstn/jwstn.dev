---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectsProps } from "#/themes/types";
import Layout from "./Layout.astro";
import Marquee from "./Marquee.astro";

const { projects } = Astro.props as ProjectsProps;
const count = String(projects.length).padStart(2, "0");
const tags = [...new Set(projects.flatMap((project) => project.data.tags))];
---

<Layout title="Projects | jwstn.dev" description="Things JW has built — or is loudly still building.">
  <section class="kn-hero kn-hero--page">
    <p class="kn-kicker">The archive — {count} entries</p>
    <h1 class="kn-hl kn-hl--page">
      <span class="kn-line kn-line--slide"><span>Work.</span></span>
    </h1>
    <p class="kn-lede">
      Everything I've shipped — or am loudly still shipping. Terminal UIs, a vinyl forum, an app for
      sign language, and one note app that simply had to exist.
    </p>
  </section>

  <Marquee text={tags.join(" /// ")} speed={40} />

  <section class="kn-section">
    <ol class="kn-rows">
      {
        projects.map((project, i) => (
          <li class="kn-reveal">
            <a class="kn-row" href={`/projects/${project.id}/`}>
              <span class="kn-num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="kn-row-body">
                <span class="kn-row-title">{project.data.title}</span>
                <span class="kn-row-sub">{project.data.description}</span>
                <span class="kn-tags">
                  {project.data.tags.map((tag) => (
                    <span class="kn-tag">{tag}</span>
                  ))}
                </span>
              </span>
              <span class="kn-row-side">
                <span class="kn-date">
                  <FormattedDate date={project.data.pubDate} />
                </span>
                <span class="kn-arrow" aria-hidden="true">
                  →
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <Marquee text="End of the archive /// more on GitHub" variant="fill" speed={28} />
</Layout>
