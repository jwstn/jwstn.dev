---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectProps } from "#/themes/types";
import Layout from "./Layout.astro";
import Marquee from "./Marquee.astro";

const { project, Content } = Astro.props as ProjectProps;
const { title, description, pubDate, href, tags } = project.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <article>
    <header class="kn-hero kn-hero--page">
      <p class="kn-kicker">From the archive — project</p>
      <h1 class="kn-hl kn-hl--page">
        <span class="kn-line kn-line--slide"><span>{title}</span></span>
      </h1>
      <p class="kn-lede">{description}</p>
      <p class="kn-meta">
        <span class="kn-date">Logged <FormattedDate date={pubDate} /></span>
        <span class="kn-tags">
          {tags.map((tag) => (
            <span class="kn-tag">{tag}</span>
          ))}
        </span>
      </p>
      <div class="kn-ctas">
        {
          href && (
            <a class="kn-cta" href={href} target="_blank" rel="noopener noreferrer">
              Open project <span class="kn-ext" aria-hidden="true">↗</span>
            </a>
          )
        }
        <a class="kn-cta kn-cta--ghost" href="/projects/">All work</a>
      </div>
    </header>

    <div class="kn-section kn-prose kn-reveal">
      <Content />
    </div>

    <Marquee text={`${title} /// ${tags.join(" /// ")}`} variant="fill" speed={32} />

    <div class="kn-section">
      <ol class="kn-rows">
        <li>
          <a class="kn-row" href="/projects/">
            <span class="kn-back-mark" aria-hidden="true">←</span>
            <span class="kn-row-body">
              <span class="kn-row-title">Back to the archive</span>
              <span class="kn-row-sub">Every entry, zero filler.</span>
            </span>
            <span class="kn-row-side"><span class="kn-arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
      </ol>
    </div>
  </article>
</Layout>
