---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Layout from "./Layout.astro";
import Marquee from "./Marquee.astro";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <article>
    <header class="kn-hero kn-hero--page">
      <p class="kn-kicker">The blog — dispatch</p>
      <h1 class="kn-hl kn-hl--page">
        <span class="kn-line kn-line--slide"><span>{title}</span></span>
      </h1>
      <p class="kn-lede">{description}</p>
      <p class="kn-meta">
        <span class="kn-date">
          <FormattedDate date={pubDate} />
        </span>
        {
          updatedDate && (
            <span class="kn-date">
              Updated <FormattedDate date={updatedDate} />
            </span>
          )
        }
      </p>
    </header>

    {
      heroImage && (
        <div class="kn-heroimg">
          <Image
            src={heroImage}
            alt={title}
            widths={[800, 1024, 1600]}
            sizes="(min-width: 64rem) 62rem, 100vw"
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    <div class="kn-section kn-prose kn-reveal">
      <Content />
    </div>

    <Marquee text={`${title} /// words by jwstn`} variant="fill" speed={30} />

    <div class="kn-section">
      <ol class="kn-rows">
        <li>
          <a class="kn-row" href="/blog/">
            <span class="kn-back-mark" aria-hidden="true">←</span>
            <span class="kn-row-body">
              <span class="kn-row-title">Back to the blog</span>
              <span class="kn-row-sub">Every dispatch, once the presses cooperate.</span>
            </span>
            <span class="kn-row-side"><span class="kn-arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
      </ol>
    </div>
  </article>
</Layout>
