---
import { SOCIALS } from "#/lib/content";
import MetaTags from "#/themes/shared/MetaTags.astro";
import ThemeSwitcher from "#/themes/shared/ThemeSwitcher.astro";
import type { LayoutProps } from "#/themes/types";
import Marquee from "./Marquee.astro";
import "./theme.css";

const { title, description } = Astro.props as LayoutProps;
const year = new Date().getFullYear();
const path = Astro.url.pathname;

const navLinks = [
  { href: "/projects/", label: "Projects" },
  { href: "/blog/", label: "Blog" },
  { href: "/gallery/", label: "Gallery" },
];
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<html lang="en" class="theme-kinetic">
  <head>
    <MetaTags title={title} description={description} transitions={false} />
  </head>
  <body>
    <a class="kn-skip" href="#kn-main">Skip to content</a>

    <header class="kn-header">
      <a class="kn-logo" href="/" aria-label="jwstn.dev — home">JWSTN<span class="kn-logo-accent">.DEV</span></a>
      <nav class="kn-nav" aria-label="Primary">
        {
          navLinks.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          ))
        }
        {
          SOCIALS.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label}
              <span class="kn-ext" aria-hidden="true">↗</span>
            </a>
          ))
        }
      </nav>
    </header>

    <main id="kn-main">
      <slot />
    </main>

    <footer class="kn-footerwrap">
      <Marquee text={`© ${year} jwstn — Cologne /// full-stack /// code in motion`} speed={30} />
      <div class="kn-footer">
        <p class="kn-foot-note">© {year} jwstn — Cologne, Germany</p>
        <p class="kn-foot-soc">
          {
            SOCIALS.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
                <span class="kn-ext" aria-hidden="true">↗</span>
              </a>
            ))
          }
        </p>
      </div>
    </footer>

    <ThemeSwitcher />
  </body>
</html>
