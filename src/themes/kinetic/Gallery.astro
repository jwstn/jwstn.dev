---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { GalleryProps } from "#/themes/types";
import Layout from "./Layout.astro";
import Marquee from "./Marquee.astro";

const { albums } = Astro.props as GalleryProps;
const count = String(albums.length).padStart(2, "0");
---

<Layout title="Gallery | jwstn.dev" description="Pictures JW took with a camera bought in Japan.">
  <section class="kn-hero kn-hero--page">
    <p class="kn-kicker">The gallery — {count} albums</p>
    <h1 class="kn-hl kn-hl--page">
      <span class="kn-line kn-line--slide"><span>Camera roll.</span></span>
    </h1>
    <p class="kn-lede">
      In March 2026 I went to Japan and came home with a camera. These are the frames since — cherry
      blossoms, highland cows, my dog, and a lot of light I liked.
    </p>
  </section>

  <Marquee text={albums.map((album) => album.data.title).join(" /// ")} variant="fill" speed={28} />

  <section class="kn-section">
    <ol class="kn-albums">
      {
        albums.map((album, i) => {
          const cover = album.data.photos[0];
          return (
            <li class="kn-reveal">
              <a class="kn-album" href={`/gallery/${album.data.slug}/`}>
                {cover && (
                  <span class="kn-album-media">
                    <Image
                      src={cover.image}
                      alt={`${album.data.title} — cover photo: ${cover.title}`}
                      widths={[480, 800, 1200]}
                      sizes="(min-width: 768px) 55vw, 100vw"
                      loading={i === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </span>
                )}
                <span class="kn-album-info">
                  <span class="kn-album-top">
                    <span class="kn-num" aria-hidden="true">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span class="kn-album-frames">
                      {String(album.data.photos.length).padStart(2, "0")} frames
                    </span>
                  </span>
                  <span class="kn-album-title">{album.data.title}</span>
                  <span class="kn-album-meta">
                    <FormattedDate date={album.data.pubDate} /> — open album{" "}
                    <span class="kn-ext" aria-hidden="true">
                      →
                    </span>
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>

  <Marquee text="Shot by jwstn /// Cologne and beyond" speed={26} />
</Layout>
