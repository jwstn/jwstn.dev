---
import Layout from "./Layout.astro";
import Marquee from "./Marquee.astro";
---

<Layout
  title="Welcome | jwstn.dev"
  description="Full-stack developer from Cologne. Web apps with TanStack, experiments with Effect — and a camera that came home from Japan."
>
  <section class="kn-hero">
    <p class="kn-kicker">Full-stack developer — Cologne, Germany</p>
    <h1 class="kn-hl kn-hl--hero">
      <span class="kn-line kn-line--slide"><span>JWSTN</span></span>
      <span class="kn-line"><span style="--kn-i: 1">Code in</span></span>
      <span class="kn-line"><span style="--kn-i: 2"><em>Motion.</em></span></span>
    </h1>
    <p class="kn-lede">
      I build web applications with <strong>TanStack</strong>, keep an eye on <strong>Hono</strong> and
      <strong>Elysia</strong>, and have an unreasonable amount of fun with <strong>Effect</strong>. In
      March 2026 I went to Japan and came home with a camera — the frames haven't stopped since.
    </p>
    <div class="kn-ctas">
      <a class="kn-cta" href="/projects/">See the work <span class="kn-ext" aria-hidden="true">→</span></a>
      <a class="kn-cta kn-cta--ghost" href="/gallery/">Camera roll <span class="kn-ext" aria-hidden="true">→</span></a>
    </div>
  </section>

  <Marquee
    text="TanStack /// Effect /// Hono /// Elysia /// Rust /// GPUI /// Cologne /// built in motion"
    variant="fill"
    speed={30}
  />

  <section class="kn-section">
    <div class="kn-section-head">
      <h2 class="kn-hl kn-hl--section">The short version</h2>
      <span class="kn-count">01</span>
    </div>
    <p class="kn-bigtext kn-reveal">
      Web apps with <strong>TanStack Start</strong>. Type-level experiments with <strong>Effect</strong>.
      TUIs nobody asked for and a forum for vinyl people. When something should move, I make it move —
      and when it shouldn't, I leave it alone.
    </p>
  </section>

  <Marquee text="Projects /// Blog /// Gallery /// pick a door" speed={22} />

  <section class="kn-section">
    <div class="kn-section-head">
      <h2 class="kn-hl kn-hl--section">Go deeper</h2>
      <span class="kn-count">02</span>
    </div>
    <ol class="kn-rows">
      <li class="kn-reveal">
        <a class="kn-row" href="/projects/">
          <span class="kn-num" aria-hidden="true">01</span>
          <span class="kn-row-body">
            <span class="kn-row-title">Projects</span>
            <span class="kn-row-sub">
              TUIs, a vinyl forum, an app for my hands' second language — half of it still loudly WIP.
            </span>
          </span>
          <span class="kn-row-side"><span class="kn-arrow" aria-hidden="true">→</span></span>
        </a>
      </li>
      <li class="kn-reveal">
        <a class="kn-row" href="/blog/">
          <span class="kn-num" aria-hidden="true">02</span>
          <span class="kn-row-body">
            <span class="kn-row-title">Blog</span>
            <span class="kn-row-sub">Zero posts, full ink. The first dispatch is at the printers.</span>
          </span>
          <span class="kn-row-side"><span class="kn-arrow" aria-hidden="true">→</span></span>
        </a>
      </li>
      <li class="kn-reveal">
        <a class="kn-row" href="/gallery/">
          <span class="kn-num" aria-hidden="true">03</span>
          <span class="kn-row-body">
            <span class="kn-row-title">Gallery</span>
            <span class="kn-row-sub">Japan, spring and summer through a camera that came home with me.</span>
          </span>
          <span class="kn-row-side"><span class="kn-arrow" aria-hidden="true">→</span></span>
        </a>
      </li>
    </ol>
  </section>

  <Marquee text="JWSTN.DEV /// Cologne /// code in motion" variant="fill" speed={34} />
</Layout>
