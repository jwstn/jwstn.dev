---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { AlbumProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { album } = Astro.props as AlbumProps;
const { title, photos, pubDate } = album.data;
---

<Layout
  title={`${title} | jwstn.dev`}
  description={`${title} — ${photos.length} photos by JW.`}
>
  <div class="brut-bar">
    <div class="brut-bar-inner">
      <h1 class="brut-bar-title">{title}</h1>
      <div class="brut-bar-side">
        <span class="brut-bar-meta">{photos.length} shots</span>
        <a class="brut-bar-back brut-press" href="/gallery/">← All films</a>
      </div>
    </div>
  </div>

  <section class="brut-shell brut-stack" aria-label="Photos">
    <p class="brut-album-meta">
      <FormattedDate date={pubDate} />
    </p>
    <div class="brut-photos">
      {
        photos.map((photo) => {
          const ratio = photo.image.width / photo.image.height;
          const isWide = ratio >= 1.6;
          return (
            <figure class:list={["brut-photo", isWide && "brut-photo-wide"]}>
              <Image
                src={photo.image}
                alt={photo.title}
                widths={[480, 800, 1200]}
                sizes="(min-width: 72rem) 34rem, (min-width: 40rem) 44vw, 92vw"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="brut-photo-cap">
                <span class="brut-photo-title">{photo.title}</span>
                {photo.caption && <span>{photo.caption}</span>}
              </figcaption>
            </figure>
          );
        })
      }
    </div>
    <p class="brut-album-back">
      <a class="brut-btn brut-btn-ghost brut-press" href="/gallery/">← Back to the gallery</a>
    </p>
  </section>
</Layout>
