---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { project, Content } = Astro.props as ProjectProps;
const { title, description, pubDate, href, tags } = project.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <div class="brut-bar">
    <div class="brut-bar-inner">
      <h1 class="brut-bar-title">Project file</h1>
      <a class="brut-bar-back brut-press" href="/projects/">← All projects</a>
    </div>
  </div>

  <article class="brut-shell brut-article">
    <header>
      <h2 class="brut-article-title">{title}</h2>
      <div class="brut-meta-row">
        <span class="brut-meta-chip">
          <FormattedDate date={pubDate} />
        </span>
        <a class="brut-btn brut-press" href={href} target="_blank" rel="noopener noreferrer">Live site ↗</a>
      </div>
      {
        tags.length > 0 && (
          <ul class="brut-tags" aria-label="Technologies used">
            {tags.map((tag) => (
              <li class="brut-sticker">{tag}</li>
            ))}
          </ul>
        )
      }
      {description && <p class="brut-lede">{description}</p>}
    </header>

    <div class="brut-prose">
      <Content />
    </div>

    <p class="brut-album-back">
      <a class="brut-btn brut-btn-ghost brut-press" href="/projects/">← Back to the stack</a>
    </p>
  </article>
</Layout>
