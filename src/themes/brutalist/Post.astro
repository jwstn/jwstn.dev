---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <div class="brut-bar">
    <div class="brut-bar-inner">
      <h1 class="brut-bar-title">Blog</h1>
      <a class="brut-bar-back brut-press" href="/blog/">← All posts</a>
    </div>
  </div>

  <article class="brut-shell brut-article">
    <header>
      <p class="brut-empty-stickers">
        <span class="brut-sticker">Post</span>
      </p>
      <h2 class="brut-article-title">{title}</h2>
      <div class="brut-meta-row">
        <span class="brut-meta-chip">
          <FormattedDate date={pubDate} />
        </span>
        {
          updatedDate && (
            <span class="brut-meta-chip">
              Updated <FormattedDate date={updatedDate} />
            </span>
          )
        }
      </div>
      {description && <p class="brut-lede">{description}</p>}
    </header>

    {
      heroImage && (
        <Image
          class="brut-heroimg"
          src={heroImage}
          alt={`Cover image for ${title}`}
          widths={[800, 1024, 1280]}
          sizes="(min-width: 72rem) 68rem, 92vw"
        />
      )
    }

    <div class="brut-prose">
      <Content />
    </div>

    <p class="brut-album-back">
      <a class="brut-btn brut-btn-ghost brut-press" href="/blog/">← Back to the blog</a>
    </p>
  </article>
</Layout>
