---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { GalleryProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { albums } = Astro.props as GalleryProps;
---

<Layout
  title="Gallery | jwstn.dev"
  description="Photos by JW — the Japan 2026 camera trip and everything it started."
>
  <div class="brut-bar">
    <div class="brut-bar-inner">
      <h1 class="brut-bar-title">Gallery</h1>
      <span class="brut-bar-meta">{albums.length} films — no filters</span>
    </div>
  </div>

  <section class="brut-shell brut-stack" aria-label="Photo albums">
    <p class="brut-lede-text">
      In March 2026 I went to Japan and bought a camera. It hasn't been idle since — flowers, dogs, bridges, and
      anything else that stands still long enough.
    </p>
    <div class="brut-albums">
      {
        albums.map((album) => (
          <a class="brut-album brut-card brut-press" href={`/gallery/${album.data.slug}/`}>
            <div class="brut-album-strip">
              {album.data.photos.slice(0, 4).map((photo) => (
                <Image
                  src={photo.image}
                  alt={photo.title}
                  widths={[160, 320]}
                  sizes="(min-width: 40rem) 9rem, 21vw"
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </div>
            <div class="brut-album-info">
              <h2 class="brut-album-title">{album.data.title}</h2>
              <p class="brut-muted">
                <FormattedDate date={album.data.pubDate} /> — {album.data.photos.length} shots
              </p>
              <span class="brut-album-cta">Open the album →</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
