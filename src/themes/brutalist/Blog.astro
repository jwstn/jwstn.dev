---
import FormattedDate from "#/components/FormattedDate.astro";
import type { BlogProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { posts } = Astro.props as BlogProps;
---

<Layout
  title="Blog | jwstn.dev"
  description="Words by JW — occasionally, loudly, when the drafts stop fighting back."
>
  <div class="brut-bar">
    <div class="brut-bar-inner">
      <h1 class="brut-bar-title">Blog</h1>
      <span class="brut-bar-meta">{posts.length} posts — {posts.length === 0 ? "pending" : "shipped"}</span>
    </div>
  </div>

  <section class="brut-shell brut-stack" aria-label="Posts">
    {
      posts.length === 0 ? (
        <div class="brut-empty brut-card">
          <p class="brut-empty-stickers">
            <span class="brut-sticker">Status: empty</span>
            <span class="brut-sticker">Deliberately</span>
          </p>
          <h2 class="brut-empty-title">Zero posts.</h2>
          <p class="brut-empty-sub">The blog is a construction site.</p>
          <p class="brut-empty-text">
            No words published yet — the drafts are too stubborn to ship. When something is worth saying, it lands here
            first, unedited and in caps if it has to be. Until then: read the code, or look at the pictures.
          </p>
          <div class="brut-barcode" aria-hidden="true" />
          <div class="brut-empty-actions">
            <a class="brut-btn brut-press" href="/projects/">
              Read code instead →
            </a>
            <a class="brut-btn brut-btn-pink brut-press" href="/gallery/">
              Or look at pictures →
            </a>
          </div>
        </div>
      ) : (
        <ul class="brut-postlist">
          {posts.map((post) => (
            <li class="brut-card brut-press">
              <a class="brut-postlist-link" href={`/blog/${post.id}/`}>
                <h2 class="brut-postlist-title">{post.data.title}</h2>
                <p class="brut-muted">
                  <FormattedDate date={post.data.pubDate} /> — {post.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
