---
import { SOCIALS } from "#/lib/content";
import MetaTags from "#/themes/shared/MetaTags.astro";
import ThemeSwitcher from "#/themes/shared/ThemeSwitcher.astro";
import type { LayoutProps } from "#/themes/types";
import "./theme.css";

const { title, description } = Astro.props as LayoutProps;
const year = new Date().getFullYear();
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const navItems = [
  { label: "Projects", href: "/projects" },
  { label: "Blog", href: "/blog" },
  { label: "Gallery", href: "/gallery" },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<html lang="en" class="theme-brutalist">
  <head>
    <MetaTags title={title} description={description} />
  </head>
  <body class="bg-background text-foreground font-body">
    <a class="brut-skip" href="#brut-main">Skip to content</a>

    <header class="brut-header">
      <div class="brut-header-inner">
        <a class="brut-logo brut-press" href="/" aria-current={path === "/" ? "page" : undefined}>
          jwstn.dev
        </a>
        <nav class="brut-nav" aria-label="Main navigation">
          {
            navItems.map((item) => (
              <a
                class="brut-nav-link brut-press"
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          {
            SOCIALS.map((s) => (
              <a
                class="brut-nav-link brut-nav-link-social brut-press"
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {s.label} ↗
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="brut-main" class="brut-main">
      <slot />
    </main>

    <footer class="brut-footer">
      <div class="brut-shell brut-footer-inner">
        <p class="brut-footer-copy">© {year} jwstn — built loud in Cologne.</p>
        <nav class="brut-footer-socials" aria-label="Social links">
          {
            SOCIALS.map((s) => (
              <a class="brut-footer-link brut-press" href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label} ↗
              </a>
            ))
          }
        </nav>
      </div>
    </footer>

    <ThemeSwitcher />
  </body>
</html>
