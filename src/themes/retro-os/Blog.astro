---
import FormattedDate from "#/components/FormattedDate.astro";
import type { BlogProps } from "#/themes/types";
import Layout from "./Layout.astro";
import PixelIcon from "./PixelIcon.astro";
import Win95Window from "./Win95Window.astro";

const { posts } = Astro.props as BlogProps;
---

<Layout
  title="Blog | jwstn.dev"
  description="Occasional writing by JW. The folder is empty for now — no files found in C:\blog."
>
  <Win95Window title="Exploring — C:\blog">
    <div class="os-toolbar">
      <span class="os-toolbar-label">Address</span>
      <span class="os-address">
        <PixelIcon name="folder" size={18} />
        C:\blog
      </span>
    </div>
    <div class="os-content">
      <div class="os-content-head">
        <h1 class="os-h1">Blog</h1>
        <p class="os-sub">{posts.length} object(s) — words, when they are worth the disk space.</p>
      </div>

      {
        posts.length === 0 ? (
          <>
            <div class="os-empty-folder">
              <PixelIcon name="folder" size={48} />
              <span>This folder is empty.</span>
            </div>

            <div class="os-dialog-wrap">
              <Win95Window title="jwstn.dev" inactive>
                <div class="os-dialog-body">
                  <PixelIcon name="warn" size={32} />
                  <div class="os-dialog-text">
                    <p class="os-dialog-title">No files found.</p>
                    <p>
                      C:\blog contains 0 objects. Nothing has been written to disk yet — no posts, no notes, no
                      trip reports. When the words are ready, they'll be filed here.
                    </p>
                  </div>
                </div>
                <div class="os-dialog-actions">
                  <a class="os-btn" href="/">OK</a>
                  <a class="os-btn" href="/projects/">Browse C:\projects</a>
                </div>
              </Win95Window>
            </div>
          </>
        ) : (
          <ul class="os-list">
            {posts.map((post) => (
              <li>
                <a class="os-row" href={`/blog/${post.id}/`}>
                  <span class="os-row-icon">
                    <PixelIcon name="note" size={28} />
                  </span>
                  <span class="os-row-main">
                    <span class="os-row-name">{post.data.title}</span>
                    <span class="os-row-desc">{post.data.description}</span>
                  </span>
                  <span class="os-row-date">
                    <FormattedDate date={post.data.pubDate} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="os-statusbar">
      <span class="os-panel os-panel-grow">{posts.length} object(s)</span>
      <span class="os-panel">C:\blog</span>
    </div>
  </Win95Window>
</Layout>
