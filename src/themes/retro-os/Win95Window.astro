---
// A Win95-style window shell rebuilt with 8bitcn/ui chrome patterns:
// radius-0, 2px ink borders, a hard offset shadow, and rect-grid pixel
// window controls (min/max/close — decorative only). Pages compose
// their own menubar / toolbar / content / status bar inside the frame.
import PixelIcon from "./PixelIcon.astro";

interface Props {
  title: string;
  /** Flat "inactive" title bar (dialogs, secondary windows). */
  inactive?: boolean;
}

const { title, inactive = false } = Astro.props;
---

<section class:list={["os-window", inactive && "is-inactive"]} aria-label={title}>
  <div class="os-titlebar">
    <span class="os-titlebar-text">{title}</span>
    <span class="os-titlebar-btns" aria-hidden="true">
      <span class="os-tbtn"><PixelIcon name="win-min" size={10} /></span>
      <span class="os-tbtn"><PixelIcon name="win-max" size={10} /></span>
      <span class="os-tbtn"><PixelIcon name="win-close" size={10} /></span>
    </span>
  </div>
  <div class="os-window-frame">
    <slot />
  </div>
</section>
