---
import { SOCIALS } from "#/lib/content";
import Layout from "./Layout.astro";
import PixelIcon from "./PixelIcon.astro";
import Win95Window from "./Win95Window.astro";

const socialIcon: Record<string, "globe" | "cloud"> = {
  GitHub: "globe",
  Bluesky: "cloud",
};
---

<Layout
  title="jwstn.dev — full-stack developer, Cologne"
  description="JW's desktop: TanStack apps, Effect experiments, and photos from the Japan 2026 camera trip. Now booting from Cologne, Germany."
>
  <div class="os-desktop-icons" aria-label="Site shortcuts">
    <a class="os-dicon" href="/projects/">
      <PixelIcon name="folder" size={40} />
      <span class="os-dicon-label">Projects</span>
    </a>
    <a class="os-dicon" href="/blog/">
      <PixelIcon name="note" size={40} />
      <span class="os-dicon-label">Blog</span>
    </a>
    <a class="os-dicon" href="/gallery/">
      <PixelIcon name="image" size={40} />
      <span class="os-dicon-label">Gallery</span>
    </a>
    {
      SOCIALS.map((s) => (
        <a class="os-dicon" href={s.href} target="_blank" rel="noopener noreferrer">
          <PixelIcon name={socialIcon[s.label] ?? "globe"} size={40} />
          <span class="os-dicon-label">{s.label}</span>
        </a>
      ))
    }
  </div>

  <Win95Window title="welcome.txt — Notepad">
    <div class="os-menubar" aria-hidden="true">
      <span>File</span><span>Edit</span><span>Search</span><span>Help</span>
    </div>
    <div class="os-content">
      <h1 class="os-h1">Hey, I'm JW.</h1>
      <p class="os-sub">Full-stack developer — Cologne, Germany</p>
      <div class="os-prose">
        <p>
          I'm focusing on building web applications with{" "}
          <a href="https://tanstack.com/" target="_blank" rel="noopener noreferrer">TanStack</a>. It ships most of
          the features you need to build a web app — server actions, middleware, even the more complex ones — so
          backend frameworks like <a href="https://hono.dev/" target="_blank" rel="noopener noreferrer">Hono</a>{" "}
          or <a href="https://elysiajs.com/" target="_blank" rel="noopener noreferrer">Elysia</a> are still queued
          for install. What I did get around to is{" "}
          <a href="https://effect.website/" target="_blank" rel="noopener noreferrer">EffectTS</a> — amazing fun so
          far, and a great opportunity to learn a new way of programming.
        </p>
      </div>
      <div class="os-actions">
        <a class="os-btn" href="/projects/">Open C:\projects</a>
        <a class="os-btn" href="/gallery/">Open C:\gallery</a>
      </div>
    </div>
    <div class="os-statusbar">
      <span class="os-panel os-panel-grow">C:\jwstn\welcome.txt</span>
      <span class="os-panel">Ready</span>
    </div>
  </Win95Window>

  <Win95Window title="System Properties" inactive>
    <div class="os-group">
      <span class="os-group-label">About this machine</span>
      <dl class="os-sys">
        <dt>System</dt>
        <dd>Full-stack developer</dd>
        <dt>Location</dt>
        <dd>Cologne, Germany</dd>
        <dt>Daily driver</dt>
        <dd>TanStack</dd>
        <dt>Recently installed</dt>
        <dd>EffectTS — amazing fun so far</dd>
        <dt>Queued for install</dt>
        <dd>Hono, Elysia</dd>
        <dt>Camera roll</dt>
        <dd>
          Japan 2026 camera trip — <a href="/gallery/">see C:\gallery</a>
        </dd>
      </dl>
    </div>
    <div class="os-statusbar">
      <span class="os-panel os-panel-grow">jwstn.dev — no service packs required</span>
      <span class="os-panel">&copy; {new Date().getFullYear()}</span>
    </div>
  </Win95Window>
</Layout>
