---
import FormattedDate from "#/components/FormattedDate.astro";
import type { GalleryProps } from "#/themes/types";
import Layout from "./Layout.astro";
import PixelIcon from "./PixelIcon.astro";
import Win95Window from "./Win95Window.astro";

const { albums } = Astro.props as GalleryProps;
---

<Layout
  title="Gallery | jwstn.dev"
  description="C:\gallery — photo albums by JW: Cologne springs and summers, plus the Japan 2026 camera trip."
>
  <Win95Window title="Exploring — C:\gallery">
    <div class="os-toolbar">
      <span class="os-toolbar-label">Address</span>
      <span class="os-address">
        <PixelIcon name="folder" size={18} />
        C:\gallery
      </span>
    </div>
    <div class="os-content">
      <div class="os-content-head">
        <h1 class="os-h1">Gallery</h1>
        <p class="os-sub">{albums.length} folder(s) — open one to view the objects inside.</p>
      </div>
      <ul class="os-folders">
        {
          albums.map((album) => (
            <li>
              <a class="os-folder" href={`/gallery/${album.data.slug}/`}>
                <PixelIcon name="folder" size={44} />
                <span class="os-folder-main">
                  <span class="os-folder-name">{album.data.title}</span>
                  <span class="os-folder-meta">
                    <FormattedDate date={album.data.pubDate} /> — {album.data.photos.length} object(s)
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="os-statusbar">
      <span class="os-panel os-panel-grow">{albums.length} folder(s)</span>
      <span class="os-panel">C:\gallery</span>
    </div>
  </Win95Window>
</Layout>
