---
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Layout from "./Layout.astro";
import Win95Window from "./Win95Window.astro";

// Unreachable for now (the blog collection is empty), but complete:
// a Notepad window for a single post, with the same chrome as Project.
const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate } = post.data;
const updated = post.data.updatedDate as Date | undefined;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <Win95Window title={`${title} — Notepad`}>
    <div class="os-menubar" aria-hidden="true">
      <span>File</span><span>Edit</span><span>Search</span><span>Help</span>
    </div>
    <div class="os-content">
      <p><a class="os-up" href="/blog/">&larr; Up one level — C:\blog</a></p>
      <h1 class="os-h1">{title}</h1>
      <p class="os-meta">
        <span>Written <FormattedDate date={pubDate} /></span>
        {updated && <span>Updated <FormattedDate date={updated} /></span>}
      </p>
      <div class="os-prose">
        <Content />
      </div>
      <div class="os-actions">
        <a class="os-btn" href="/blog/">Up one level</a>
        <a class="os-btn" href="/">Back to desktop</a>
      </div>
    </div>
    <div class="os-statusbar">
      <span class="os-panel os-panel-grow">C:\blog\{post.id}.txt</span>
      <span class="os-panel">Ready</span>
    </div>
  </Win95Window>
</Layout>
