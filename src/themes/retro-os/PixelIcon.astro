---
// Decorative pixel-flavored icons for the retro-os desktop.
// Pure inline SVG, drawn with crisp edges — no external assets.
// The win-* window controls port the rect-grid glyph pattern from
// 8bitcn/ui's dialog.tsx (MIT); they inherit currentColor.
interface Props {
  name:
    | "folder"
    | "note"
    | "image"
    | "computer"
    | "warn"
    | "globe"
    | "cloud"
    | "win-min"
    | "win-max"
    | "win-close"
    | "arrow-left"
    | "arrow-ext";
  size?: number;
  class?: string;
}

const { name, size = 32, class: cls } = Astro.props;

const icons: Record<string, string> = {
  folder: `<svg viewBox="0 0 16 16" width="${size}" height="${size}" shape-rendering="crispEdges"><path d="M1 2h5l2 2h7v10H1z" fill="#f7d354" stroke="#0a0a0a" stroke-width="1"/><path d="M1.5 6.5h13" stroke="#c9a227" stroke-width="1.5"/></svg>`,
  note: `<svg viewBox="0 0 16 16" width="${size}" height="${size}" shape-rendering="crispEdges"><rect x="2.5" y="1.5" width="11" height="13" fill="#ffffff" stroke="#0a0a0a" stroke-width="1"/><path d="M2.5 4.5h11" stroke="#808080" stroke-width="1"/><path d="M4.5 7h7M4.5 9h7M4.5 11h5" stroke="#9aa0a6" stroke-width="1" fill="none"/></svg>`,
  image: `<svg viewBox="0 0 16 16" width="${size}" height="${size}" shape-rendering="crispEdges"><rect x="1.5" y="2.5" width="13" height="11" fill="#ffffff" stroke="#0a0a0a" stroke-width="1"/><circle cx="5.5" cy="6.5" r="1.6" fill="#f7d354" stroke="#0a0a0a" stroke-width="1"/><path d="M2.5 12.5l4-4.5 3 3.5 2.5-2.5 3.5 3.5" fill="none" stroke="#2a7fbf" stroke-width="1.5"/></svg>`,
  computer: `<svg viewBox="0 0 16 16" width="${size}" height="${size}" shape-rendering="crispEdges"><rect x="1.5" y="1.5" width="13" height="9.5" fill="#c0c0c0" stroke="#0a0a0a" stroke-width="1"/><rect x="3" y="3" width="10" height="6.5" fill="#008080" stroke="#0a0a0a" stroke-width="1"/><rect x="5.5" y="12" width="5" height="2" fill="#c0c0c0" stroke="#0a0a0a" stroke-width="1"/><rect x="3.5" y="13.5" width="9" height="1.5" fill="#c0c0c0" stroke="#0a0a0a" stroke-width="1"/></svg>`,
  warn: `<svg viewBox="0 0 16 16" width="${size}" height="${size}" shape-rendering="crispEdges"><path d="M8 1.5l7.5 13H.5z" fill="#f7d354" stroke="#0a0a0a" stroke-width="1" stroke-linejoin="round"/><rect x="7.3" y="5.5" width="1.4" height="5" fill="#0a0a0a"/><rect x="7.3" y="12" width="1.4" height="1.4" fill="#0a0a0a"/></svg>`,
  globe: `<svg viewBox="0 0 16 16" width="${size}" height="${size}" shape-rendering="crispEdges"><circle cx="8" cy="8" r="6.5" fill="#c8d2da" stroke="#0a0a0a" stroke-width="1"/><path d="M1.5 8h13M8 1.5c3.2 3.6 3.2 9.4 0 13M8 1.5c-3.2 3.6-3.2 9.4 0 13" fill="none" stroke="#0a0a0a" stroke-width="1"/></svg>`,
  cloud: `<svg viewBox="0 0 16 16" width="${size}" height="${size}" shape-rendering="crispEdges"><path d="M4.2 12h7.6a2.8 2.8 0 0 0 .4-5.57A4.2 4.2 0 0 0 4.9 4.6 3.4 3.4 0 0 0 4.2 12z" fill="#e8f0f8" stroke="#0a0a0a" stroke-width="1" stroke-linejoin="round"/></svg>`,
  // 8bitcn-style rect-grid window controls (currentColor)
  "win-min": `<svg viewBox="0 0 16 16" width="${size}" height="${size}" shape-rendering="crispEdges"><rect x="3" y="11" width="10" height="2" fill="currentColor"/></svg>`,
  "win-max": `<svg viewBox="0 0 16 16" width="${size}" height="${size}" shape-rendering="crispEdges"><rect x="4" y="4" width="8" height="8" fill="none" stroke="currentColor" stroke-width="2"/></svg>`,
  "win-close": `<svg viewBox="0 0 16 16" width="${size}" height="${size}" shape-rendering="crispEdges" fill="currentColor"><rect x="4" y="4" width="2" height="2"/><rect x="6" y="6" width="2" height="2"/><rect x="8" y="8" width="2" height="2"/><rect x="10" y="10" width="2" height="2"/><rect x="12" y="12" width="2" height="2"/><rect x="12" y="4" width="2" height="2"/><rect x="10" y="6" width="2" height="2"/><rect x="6" y="10" width="2" height="2"/><rect x="4" y="12" width="2" height="2"/></svg>`,
  // pixel arrows — VT323/PS2P ship no arrow glyphs, so links use these instead
  "arrow-left": `<svg viewBox="0 0 16 16" width="${size}" height="${size}" shape-rendering="crispEdges" fill="currentColor"><path d="M2 8l6-6v12z"/><rect x="8" y="7" width="6" height="2"/></svg>`,
  "arrow-ext": `<svg viewBox="0 0 16 16" width="${size}" height="${size}" shape-rendering="crispEdges" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12L12 4"/><path d="M6 4h8v8"/></svg>`,
};
---

<span class:list={["os-icon", cls]} aria-hidden="true" set:html={icons[name] ?? ""} />
