---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectProps } from "#/themes/types";
import Layout from "./Layout.astro";
import Sparkle from "./Sparkle.astro";

const { project, Content } = Astro.props as ProjectProps;
---

<Layout
  title={`${project.data.title} — jwstn.dev`}
  description={project.data.description}
>
  <section class="mx-band c-red zz-b" aria-labelledby="mx-project-title">
    <Sparkle class="mx-corner p-a" />
    <Sparkle class="mx-corner p-b" />
    <div class="mx-band-inner">
      <a class="mx-btn b-ghost" href="/projects/">← All the projects!</a>
      <p class="mx-eyebrow">
        <Sparkle /> Exhibit № {project.id} <Sparkle />
      </p>
      <h1 id="mx-project-title" class="mx-band-title">{project.data.title}</h1>
      <p class="mx-band-serif">— the story behind it, told at a completely reasonable volume —</p>
      <div class="mx-meta-row">
        <span class="mx-meta-chip">Started <FormattedDate date={project.data.pubDate} /></span>
        {project.data.title.includes("(WIP)") && <span class="mx-meta-chip">Work in progress!</span>}
      </div>
      <ul class="mx-tags" aria-label="Technologies used">
        {project.data.tags.map((tag) => (
          <li class="mx-tag">{tag}!</li>
        ))}
      </ul>
    </div>
  </section>

  <article class="mx-article">
    <p class="mx-lede">{project.data.description}</p>
    <div class="mx-meta-row">
      <a class="mx-btn b-yellow" href={project.data.href} target="_blank" rel="noopener noreferrer">
        Visit it live ↗
      </a>
      <a class="mx-btn b-violet" href="/gallery/">Or look at photos instead →</a>
    </div>
    <div class="mx-prose">
      <Content />
    </div>
    <p class="mx-hand" style="rotate: -1.4deg">
      ← that was the whole story. there are three more in the index!
    </p>
    <div class="mx-meta-row">
      <a class="mx-btn b-ghost" href="/projects/">← Back to the grand index</a>
    </div>
  </article>
</Layout>
