---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { AlbumProps } from "#/themes/types";
import Layout from "./Layout.astro";
import Sparkle from "./Sparkle.astro";
import Starburst from "./Starburst.astro";

const { album } = Astro.props as AlbumProps;

// every album gets its own carnival accent (decorative only)
const accents = ["red", "yellow", "blue", "green", "violet", "pink"] as const;
const accent = accents[album.data.slug.length % accents.length];
---

<Layout
  title={`${album.data.title} — jwstn.dev`}
  description={`${album.data.title}: ${album.data.photos.length} photos from JW's camera — flowers, trips, dogs and everything in between.`}
>
  <section class:list={["mx-band zz-t zz-b", `c-${accent}`]} aria-labelledby="mx-album-title">
    <Sparkle class="mx-corner p-a" />
    <Sparkle class="mx-corner p-b" />
    <Sparkle class="mx-corner p-c" />
    <div class="mx-band-inner">
      <a class="mx-btn b-ghost" href="/gallery/">← All the albums!</a>
      <p class="mx-eyebrow">
        <Sparkle /> Now showing <Sparkle />
      </p>
      <h1 id="mx-album-title" class="mx-band-title">{album.data.title}!</h1>
      <p class="mx-band-serif">— {album.data.photos.length} frames, hung slightly crooked on purpose —</p>
      <div class="mx-meta-row">
        <span class="mx-meta-chip">
          <FormattedDate date={album.data.pubDate} />
        </span>
        <span class="mx-meta-chip">{album.data.photos.length} photos!</span>
      </div>
    </div>
  </section>

  <section class="mx-photos" aria-label={`Photos from ${album.data.title}`}>
    {
      album.data.photos.map((photo) => {
        const ratio = photo.image.width / photo.image.height;
        const isWide = ratio > 1.6;
        return (
          <figure class:list={["mx-photo", isWide && "mx-photo-wide"]}>
            <Image
              src={photo.image}
              alt={photo.title}
              widths={[480, 800, 1200]}
              sizes="(min-width: 80rem) 36rem, (min-width: 48rem) 33vw, 100vw"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="mx-photo-cap">
              <p class="mx-photo-title">{photo.title}</p>
              {photo.caption && <p class="mx-photo-caption">{photo.caption}</p>}
            </figcaption>
          </figure>
        );
      })
    }
  </section>

  <div class="mx-empty">
    <div class="mx-empty-bursts" aria-hidden="true">
      <Starburst class="sm mx-burst-violet" />
      <Starburst text="More!" class="mx-burst-yellow sm" />
    </div>
    <h2 class="mx-empty-title">That was the whole roll!</h2>
    <p class="mx-band-serif">— every frame developed, nothing left in the darkroom —</p>
    <div class="mx-empty-actions">
      <a class="mx-btn b-pink" href="/gallery/">Back to the photo palace →</a>
      <a class="mx-btn b-red" href="/projects/">
        Or the projects wing →
      </a>
    </div>
    <p class="mx-hand mx-hand-note">thanks for looking at every single one of them!</p>
  </div>
</Layout>
