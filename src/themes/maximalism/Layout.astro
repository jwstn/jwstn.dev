---
import { SOCIALS } from "#/lib/content";
import MetaTags from "#/themes/shared/MetaTags.astro";
import ThemeSwitcher from "#/themes/shared/ThemeSwitcher.astro";
import type { LayoutProps } from "#/themes/types";
import Sparkle from "./Sparkle.astro";
import "./theme.css";

const { title, description } = Astro.props as LayoutProps;
const year = new Date().getFullYear();
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const navItems = [
  { label: "Projects!", href: "/projects", chip: "c-blue" },
  { label: "Blog!", href: "/blog", chip: "c-green" },
  { label: "Gallery!", href: "/gallery", chip: "c-violet" },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const socialChips = [
  { label: "GitHub", href: SOCIALS[0].href, chip: "c-pink" },
  { label: "Bluesky", href: SOCIALS[1].href, chip: "c-card" },
];

const toplineItems = [
  "MORE IS MORE",
  "JOY IS A DESIGN SYSTEM",
  "BUILT LOUD IN COLOGNE",
  "TANSTACK + EFFECT + RUST",
  "CAMERA ALWAYS CHARGED",
  "RIBBONS ON EVERYTHING",
];
// each run is identical so the -50% loop is seamless
const toplineRun = [...toplineItems, ...toplineItems, ...toplineItems];
---

<html lang="en" class="theme-maximalism">
  <head>
    <MetaTags title={title} description={description} />
  </head>
  <body class="bg-background text-foreground font-body">
    <a class="mx-skip" href="#mx-main">Skip to content</a>

    <div class="mx-topline" aria-hidden="true">
      <div class="mx-topline-track">
        <div class="mx-topline-run">
          {toplineRun.map((item) => (
            <>
              <span>{item}</span>
              <Sparkle class="mx-topline-sep" />
            </>
          ))}
        </div>
        <div class="mx-topline-run">
          {toplineRun.map((item) => (
            <>
              <span>{item}</span>
              <Sparkle class="mx-topline-sep" />
            </>
          ))}
        </div>
      </div>
    </div>

    <header class="mx-band c-yellow zz-b">
      <div class="mx-header-inner">
        <a class="mx-logo" href="/" aria-current={path === "/" ? "page" : undefined}>
          <Sparkle class="mx-logo-spark" />
          jwstn.dev
        </a>
        <nav class="mx-nav" aria-label="Main navigation">
          {
            navItems.map((item) => (
              <a
                class:list={["mx-chip", item.chip]}
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          {
            socialChips.map((s) => (
              <a class:list={["mx-chip", s.chip]} href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label} ↗
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="mx-main" class="mx-main">
      <slot />
    </main>

    <footer class="mx-band c-violet zz-t">
      <Sparkle class="mx-corner p-a" />
      <Sparkle class="mx-corner p-b" />
      <Sparkle class="mx-corner p-c" />
      <Sparkle class="mx-corner p-d" />
      <div class="mx-footer-inner">
        <h2 class="mx-footer-title">
          <Sparkle />
          That's everything (for now!)
          <Sparkle />
        </h2>
        <p class="mx-footer-copy">© {year} jwstn — built loud in Cologne with a completely reasonable number of colors.</p>
        <nav class="mx-footer-socials" aria-label="Social links">
          <a class="mx-chip c-yellow" href={SOCIALS[0].href} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a class="mx-chip c-pink" href={SOCIALS[1].href} target="_blank" rel="noopener noreferrer">Bluesky ↗</a>
        </nav>
        <p class="mx-hand mx-footer-hand">you scrolled all the way down here — the confetti appreciates you!</p>
      </div>
    </footer>

    <ThemeSwitcher />
  </body>
</html>
