---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { GalleryProps } from "#/themes/types";
import Layout from "./Layout.astro";
import Sparkle from "./Sparkle.astro";

const { albums } = Astro.props as GalleryProps;

const albumNotes: Record<string, string> = {
  "japan-2026": "cherry blossoms, a Godzilla sighting, and a camera that barely cooled down",
  "spring-2026": "flowers, a very good dog, and bridges worth walking to",
  "summer-2026": "forests, radiotowers, and sunsets over very german fields",
};
---

<Layout
  title="Gallery — jwstn.dev"
  description="The photo palace of jwstn.dev: spring flowers, summer forests, and a Japan 2026 trip that filled an entire memory card."
>
  <section class="mx-band c-pink zz-t zz-b" aria-labelledby="mx-gallery-title">
    <Sparkle class="mx-corner p-a" />
    <Sparkle class="mx-corner p-b" />
    <Sparkle class="mx-corner p-c" />
    <div class="mx-band-inner">
      <p class="mx-eyebrow">
        <Sparkle /> Welcome to the photo palace <Sparkle />
      </p>
      <h1 id="mx-gallery-title" class="mx-band-title">Gallery!</h1>
      <p class="mx-band-serif">
        — albums from walks, forests, a very good dog, and a 2026 Japan trip that filled a memory card —
      </p>
      <div class="mx-meta-row">
        <span class="mx-meta-chip">! {String(albums.length).padStart(2, "0")} albums and counting !</span>
      </div>
    </div>
  </section>

  <ul class="mx-albums">
    {
      albums.map((album) => {
        const strip = album.data.photos.slice(0, 4);
        const rest = album.data.photos.length - strip.length;
        return (
          <li>
            <a
              class="mx-card mx-hover mx-album"
              href={`/gallery/${album.data.slug}/`}
              aria-label={`${album.data.title} — ${album.data.photos.length} photos`}
            >
              <div class="mx-album-strip">
                {strip.map((photo) => (
                  <Image
                    src={photo.image}
                    alt=""
                    widths={[240, 480]}
                    sizes="(min-width: 60rem) 8rem, 22vw"
                    loading="lazy"
                    decoding="async"
                  />
                ))}
              </div>
              <div class="mx-album-info">
                <h2 class="mx-album-title">{album.data.title}!</h2>
                <p class="mx-album-note">
                  {albumNotes[album.id as string] ?? "pressed flowers of the digital kind"}
                </p>
                <div class="mx-meta-row">
                  <span class="mx-meta-chip">
                    <FormattedDate date={album.data.pubDate} />
                  </span>
                  <span class="mx-meta-chip">{album.data.photos.length} photos!</span>
                  {rest > 0 && <span class="mx-meta-chip">+{rest} more inside!</span>}
                </div>
                <span class="mx-door-cta">Open the whole album →</span>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>
</Layout>
