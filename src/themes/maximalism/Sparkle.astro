---
// Giant emoji-free sparkle: a four-point star, used as ornament everywhere.
// Color follows `currentColor` — set `color` on the element or a parent class.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={["mx-sparkle", className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path
    d="M12 0c.9 6.2 4.9 10.7 12 12-7.1 1.3-11.1 5.8-12 12-.9-6.2-4.9-10.7-12-12C7.1 10.7 11.1 6.2 12 0Z"
    fill="currentColor"
  ></path>
</svg>
