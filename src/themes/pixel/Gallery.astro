---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { GalleryProps } from "#/themes/types";
import Layout from "./Layout.astro";
import PixelIcon from "./PixelIcon.astro";

const { albums } = Astro.props as GalleryProps;
---

<Layout
  title="Item Bag | jwstn.dev"
  description="JW's item bag — photo sets collected on walks, trips and the Japan 2026 expedition. Open an item to inspect it."
>
  <div class="px-shell px-stack">
    <section class="px-window">
      <div class="px-window-title">
        <span>ITEM BAG</span>
        <span class="px-title-right">{albums.length} ITEM {albums.length === 1 ? "SET" : "SETS"}</span>
      </div>
      <div class="px-window-body">
        <h1 class="px-h1">Item Bag</h1>
        <p class="px-sub">
          Loot collected on walks, trips and expeditions. Select an item to inspect its contents.
        </p>
        <ul class="px-inv">
          {
            albums.map((album) => (
              <li>
                <a class="px-item" href={`/gallery/${album.data.slug}/`}>
                  <span class="px-item-cover">
                    <Image
                      src={album.data.photos[0].image}
                      widths={[160, 320]}
                      sizes="(min-width: 68rem) 13rem, 45vw"
                      width={160}
                      height={160}
                      alt={`Cover photo of ${album.data.title}: ${album.data.photos[0].title}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="px-item-body">
                    <span class="px-item-name">{album.data.title}</span>
                    <span class="px-item-meta">
                      &times;{album.data.photos.length} PHOTOS · <FormattedDate date={album.data.pubDate} />
                    </span>
                    <span class="px-item-inspect">
                      Inspect
                      <PixelIcon name="cursor" size={10} />
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</Layout>
