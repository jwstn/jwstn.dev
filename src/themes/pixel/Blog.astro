---
import FormattedDate from "#/components/FormattedDate.astro";
import type { BlogProps } from "#/themes/types";
import Layout from "./Layout.astro";
import PixelIcon from "./PixelIcon.astro";

const { posts } = Astro.props as BlogProps;
---

<Layout
  title="Save Files | jwstn.dev"
  description="JW's save files — the blog. The cart is blank for now: no entries recorded yet."
>
  <div class="px-shell px-stack">
    <section class="px-window">
      <div class="px-window-title">
        <span>SAVE FILES</span>
        <span class="px-title-right">MEMORY CART 1/1</span>
      </div>
      <div class="px-window-body">
        <h1 class="px-h1">Save Files</h1>
        <p class="px-sub">
          {posts.length === 0
            ? "The cart is blank — no entries have been recorded yet. Pick a slot and stay ready."
            : `${posts.length} recorded ${posts.length === 1 ? "entry" : "entries"} — select one to load it.`}
        </p>

        {
          posts.length === 0 ? (
            <>
              <div class="px-slots">
                <div class="px-slot">
                  <div class="px-slot-head">
                    <span class="px-label">FILE 01</span>
                    <span class="px-slot-tag">NO DATA</span>
                  </div>
                  <div class="px-slot-body">
                    <span class="px-slot-name">EMPTY FILE</span>
                    <p class="px-slot-line">
                      A blank save. The first recorded entry will be written here.
                      <span class="px-caret" aria-hidden="true"></span>
                    </p>
                  </div>
                </div>
                <div class="px-slot">
                  <div class="px-slot-head">
                    <span class="px-label">FILE 02</span>
                    <span class="px-slot-tag">NO DATA</span>
                  </div>
                  <div class="px-slot-body">
                    <span class="px-slot-name">EMPTY FILE</span>
                    <p class="px-slot-line">
                      Nothing recorded yet — the ink is still drying.
                      <span class="px-caret" aria-hidden="true"></span>
                    </p>
                  </div>
                </div>
                <div class="px-slot">
                  <div class="px-slot-head">
                    <span class="px-label">FILE 03</span>
                    <span class="px-slot-tag">RESERVED</span>
                  </div>
                  <div class="px-slot-body">
                    <span class="px-slot-name">RESERVED</span>
                    <p class="px-slot-line">
                      Held for field notes from the Japan 2026 expedition — the film is still developing.
                      <span class="px-caret" aria-hidden="true"></span>
                    </p>
                  </div>
                </div>
              </div>
              <div class="px-alert" role="note">
                <span class="px-alert-arrow" aria-hidden="true">
                  <PixelIcon name="cursor" size={12} />
                </span>
                <p>
                  A new entry appears here the moment JW presses save. Until then, the
                  <a href="/projects/">quest log</a> and the <a href="/gallery/">item bag</a> are fully
                  explored.
                </p>
              </div>
              <div class="px-h1-actions px-actions-top">
                <a class="px-btn" href="/">
                  <PixelIcon name="back" size={10} />
                  Return to title screen
                </a>
              </div>
            </>
          ) : (
            <ul class="px-posts">
              {posts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    <span class="px-post-title">{post.data.title}</span>
                    <span class="px-post-meta">
                      RECORDED <FormattedDate date={post.data.pubDate} />
                    </span>
                    {post.data.description && <span class="px-post-desc">{post.data.description}</span>}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>
  </div>
</Layout>
