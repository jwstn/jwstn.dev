---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Layout from "./Layout.astro";
import PixelIcon from "./PixelIcon.astro";

const { post, Content } = Astro.props as PostProps;
---

<Layout title={`${post.data.title} | jwstn.dev`} description={post.data.description}>
  <div class="px-shell px-stack">
    <section class="px-window">
      <div class="px-window-title">
        <span>SAVE FILE — RECORDED ENTRY</span>
        <span class="px-title-right">MEMORY CART 1/1</span>
      </div>
      <div class="px-window-body">
        <h1 class="px-h1">{post.data.title}</h1>
        <p class="px-meta">
          RECORDED <FormattedDate date={post.data.pubDate} />
          {post.data.updatedDate && (
            <>
              {" "}· UPDATED <FormattedDate date={post.data.updatedDate} />
            </>
          )}
        </p>

        {post.data.heroImage && (
          <div class="px-hero">
            <Image src={post.data.heroImage} widths={[640, 900, 1200]} sizes="(min-width: 68rem) 65rem, 100vw" alt="" loading="eager" />
          </div>
        )}

        <div class="px-prose">
          <Content />
        </div>
      </div>
      <div class="px-window-foot">
        <a class="px-btn px-btn--ghost" href="/blog/">
          <PixelIcon name="back" size={10} />
          Save files
        </a>
      </div>
    </section>
  </div>
</Layout>
