---
import { SOCIALS } from "#/lib/content";
import Layout from "./Layout.astro";
import PixelIcon from "./PixelIcon.astro";
---

<Layout
  title="jwstn.dev — JW's 8-bit quest log"
  description="JW — full-stack developer from Cologne, Germany. Character sheet, quest log, save files and item bag from an 8-bit career in web development."
>
  <div class="px-shell px-stack">
    <!-- overworld day / dungeon cave strip -->
    <div class="px-scene" aria-hidden="true">
      <span class="px-sun"></span>
      <span class="px-cloud px-cloud--a"></span>
      <span class="px-cloud px-cloud--b"></span>
      <span class="px-stars px-stars--a"></span>
      <span class="px-stars px-stars--b"></span>
      <span class="px-torch px-torch--a"><span class="px-flame"></span><span class="px-stick"></span></span>
      <span class="px-torch px-torch--b"><span class="px-flame"></span><span class="px-stick"></span></span>
      <span class="px-scene-ground"></span>
    </div>

    <!-- character sheet -->
    <section class="px-window" aria-labelledby="px-char-name">
      <div class="px-window-title">
        <span>PLAYER 1 — STATUS</span>
        <span class="px-hearts" role="img" aria-label="3 of 3 hearts">
          <i class="px-heart"></i><i class="px-heart"></i><i class="px-heart"></i>
        </span>
      </div>
      <div class="px-window-body px-char">
        <div>
          <h1 id="px-char-name" class="px-char-name">JW</h1>
          <p class="px-char-class">CLASS: FULL-STACK DEVELOPER — GUILD: COLOGNE, GERMANY</p>
        </div>
        <div class="px-bars">
          <div class="px-bar-line">
            <span class="px-label">HP</span>
            <span class="px-bar" aria-hidden="true"><span class="px-bar-fill px-fill-hp" style="--px-fill:96%"></span></span>
            <span class="px-bar-cap">96/99</span>
          </div>
          <div class="px-bar-line">
            <span class="px-label">MP</span>
            <span class="px-bar" aria-hidden="true"><span class="px-bar-fill px-fill-mp" style="--px-fill:42%"></span></span>
            <span class="px-bar-cap">42/99</span>
          </div>
        </div>
      </div>
    </section>

    <!-- dialogue box -->
    <section class="px-window" aria-label="Introduction">
      <div class="px-window-title"><span>JW SAYS:</span></div>
      <div class="px-dialogue">
        <p>
          I'm focusing on building web applications with
          <a href="https://tanstack.com/" target="_blank" rel="noopener noreferrer">TanStack</a>. It ships most of
          the features a web app needs — even the complex ones, like server actions and middleware — so backend
          frameworks like <a href="https://hono.dev/" target="_blank" rel="noopener noreferrer">Hono</a> or
          <a href="https://elysiajs.com/" target="_blank" rel="noopener noreferrer">Elysia</a> are still waiting in
          the quest queue.
        </p>
        <p>
          What I did unlock is
          <a href="https://effect.website/" target="_blank" rel="noopener noreferrer">EffectTS</a> — amazing fun so
          far, and a great chance to learn a whole new way of programming.
        </p>
        <span class="px-dlg-cursor" aria-hidden="true"></span>
      </div>
    </section>

    <div class="px-cols">
      <!-- equipment & quests -->
      <section class="px-window" aria-labelledby="px-equip-title">
        <div class="px-window-title"><span id="px-equip-title">EQUIPMENT &amp; QUESTS</span></div>
        <div class="px-window-body">
          <dl class="px-stats">
            <div><dt>Main hand</dt><dd>TanStack</dd></div>
            <div><dt>Off hand</dt><dd>EffectTS</dd></div>
            <div><dt>In storage</dt><dd>Hono, Elysia — queued for install</dd></div>
            <div>
              <dt>Side quest</dt>
              <dd>
                <a href="/gallery/">Japan 2026 camera expedition — the loot so far</a>
              </dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- main menu -->
      <nav class="px-window" aria-label="Main menu">
        <div class="px-window-title"><span>MAIN MENU</span></div>
        <ul class="px-menu">
          <li>
            <a href="/projects/">
              <span class="px-menu-cursor" aria-hidden="true"><PixelIcon name="cursor" size={12} /></span>
              <span class="px-menu-label">Quest log</span>
              <span class="px-menu-note">briefings &amp; builds</span>
            </a>
          </li>
          <li>
            <a href="/blog/">
              <span class="px-menu-cursor" aria-hidden="true"><PixelIcon name="cursor" size={12} /></span>
              <span class="px-menu-label">Save files</span>
              <span class="px-menu-note">no entries recorded yet</span>
            </a>
          </li>
          <li>
            <a href="/gallery/">
              <span class="px-menu-cursor" aria-hidden="true"><PixelIcon name="cursor" size={12} /></span>
              <span class="px-menu-label">Item bag</span>
              <span class="px-menu-note">photo loot</span>
            </a>
          </li>
          {
            SOCIALS.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  <span class="px-menu-cursor" aria-hidden="true">
                    <PixelIcon name="cursor" size={12} />
                  </span>
                  <span class="px-menu-label">Party link: {s.label}</span>
                  <span class="px-menu-note">
                    <PixelIcon name="ext" size={10} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</Layout>
