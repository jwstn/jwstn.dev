---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectsProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { projects } = Astro.props as ProjectsProps;

const roman = (n: number) => ["I", "II", "III", "IV", "V", "VI"][n - 1];
---

<Layout
  title="Projects — jwstn.dev"
  description="Four selected works by JW — a vinyl collectors' forum, a terminal Spotify client, a sign-language trainer, and a very personal note app."
>
  <header class="luxe-fade">
    <p class="luxe-kicker">The Index</p>
    <h1 class="luxe-display">Projects</h1>
    <p class="luxe-lede">
      Four works, kept close: a collectors' forum, a terminal client, a language trainer, and one
      very personal note app. All in progress; all in earnest.
    </p>
  </header>

  <div class="luxe-orn" aria-hidden="true"><span class="luxe-orn-diamond"></span></div>

  <ol class="luxe-toc luxe-index luxe-fade luxe-fade-2">
    {
      projects.map((project, i) => (
        <li>
          <a class="luxe-toc-row" href={`/projects/${project.id}/`}>
            <span class="luxe-toc-num" aria-hidden="true">
              {roman(i + 1)}
            </span>
            <span class="luxe-toc-title">{project.data.title}</span>
            <span class="luxe-leader" aria-hidden="true" />
            <span class="luxe-toc-note">
              <FormattedDate date={project.data.pubDate} />
            </span>
          </a>
          <p class="luxe-index-desc">{project.data.description}</p>
          {project.data.tags.length > 0 && (
            <p class="luxe-index-tags">{project.data.tags.join("  ·  ")}</p>
          )}
        </li>
      ))
    }
  </ol>
</Layout>
