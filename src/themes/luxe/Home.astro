---
import type { HomeProps } from "#/themes/types";
import Layout from "./Layout.astro";

Astro.props as HomeProps;

const contents = [
  {
    href: "/projects",
    title: "Projects",
    note: "Four works, kept in progress",
  },
  {
    href: "/blog",
    title: "Journal",
    note: "Forthcoming — written only when worth keeping",
  },
  {
    href: "/gallery",
    title: "Gallery",
    note: "Japan 2026, a German summer, spring at home",
  },
];

const roman = (n: number) => ["I", "II", "III", "IV", "V"][n - 1];
---

<Layout
  title="jwstn.dev — JW, full-stack developer in Cologne"
  description="JW builds web applications with TanStack, experiments with Effect, and takes his camera everywhere — most recently to Japan."
>
  <section class="luxe-hero luxe-fade">
    <p class="luxe-kicker">JW — Full-Stack Developer — Cologne</p>
    <h1 class="luxe-display">
      Software with intention.<br />
      <em>Photographs with patience.</em>
    </h1>
    <p class="luxe-hero-copy">
      Most of my days go into web applications with
      <a href="https://tanstack.com/" target="_blank" rel="noopener noreferrer">TanStack</a> — it
      covers so much of what a modern app needs that
      <a href="https://hono.dev/" target="_blank" rel="noopener noreferrer">Hono</a> and
      <a href="https://elysiajs.com/" target="_blank" rel="noopener noreferrer">Elysia</a> are still
      waiting their turn on the shelf. What I did make time for is
      <a href="https://effect.website/" target="_blank" rel="noopener noreferrer">Effect</a> — the
      most fun I've had in a while, relearning how a program can be written. When the keyboard
      rests, the camera comes out: in 2026 it travelled to Japan, and it has not really been put
      down since.
    </p>
  </section>

  <div class="luxe-orn" aria-hidden="true"><span class="luxe-orn-diamond"></span></div>

  <section class="luxe-fade luxe-fade-2" aria-labelledby="luxe-contents-h">
    <h2 id="luxe-contents-h" class="luxe-kicker">Contents</h2>
    <ol class="luxe-toc">
      {
        contents.map((c, i) => (
          <li>
            <a class="luxe-toc-row" href={c.href}>
              <span class="luxe-toc-num" aria-hidden="true">
                {roman(i + 1)}
              </span>
              <span class="luxe-toc-title">{c.title}</span>
              <span class="luxe-leader" aria-hidden="true" />
              <span class="luxe-toc-note">{c.note}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>
