---
import { SOCIALS } from "#/lib/content";
import MetaTags from "#/themes/shared/MetaTags.astro";
import ThemeSwitcher from "#/themes/shared/ThemeSwitcher.astro";
import type { LayoutProps } from "#/themes/types";
import "./theme.css";

const { title, description } = Astro.props as LayoutProps;
const year = new Date().getFullYear();

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" || path === "" : path.startsWith(href));

const nav: { href: string; label: string; external?: boolean }[] = [
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/gallery", label: "Gallery" },
];

const socials = SOCIALS.map((s) => ({ href: s.href, label: s.label, external: true }));
const items = [...nav, ...socials];
---

<html lang="en" class="theme-luxe">
  <head>
    <MetaTags title={title} description={description} />
  </head>
  <body>
    <div class="luxe-toprule" aria-hidden="true"></div>

    <header class="luxe-header">
      <a class="luxe-brand" href="/">jwstn.dev</a>
      <nav class="luxe-nav" aria-label="Primary">
        {
          items.map((item, i) => (
            <Fragment>
              {i > 0 && <span class="luxe-nav-sep" aria-hidden="true">·</span>}
              <a
                class="luxe-nav-link"
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
              >
                {item.label}
              </a>
            </Fragment>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="luxe-footer">
      <div class="luxe-footer-rule" aria-hidden="true"></div>
      <p class="luxe-footer-copy">&copy; {year} jwstn — Cologne</p>
      <p class="luxe-footer-socials">
        {
          SOCIALS.map((s, i) => (
            <Fragment>
              {i > 0 && <span class="luxe-nav-sep" aria-hidden="true">·</span>}
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </Fragment>
          ))
        }
      </p>
    </footer>

    <ThemeSwitcher />
  </body>
</html>
