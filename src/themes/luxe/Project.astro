---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { project, Content } = Astro.props as ProjectProps;
const { title, description, pubDate, href, tags } = project.data;
---

<Layout title={`${title} — jwstn.dev`} description={description}>
  <article class="luxe-article">
    <p class="luxe-backrow luxe-fade">
      <a class="luxe-back" href="/projects">&larr; Index</a>
    </p>

    <header class="luxe-fade">
      <p class="luxe-kicker">The Work</p>
      <h1 class="luxe-article-title">{title}</h1>
      <p class="luxe-meta">
        <FormattedDate date={pubDate} />
        <span aria-hidden="true"> · </span>
        <a href={href} target="_blank" rel="noopener noreferrer">Visit the work</a>
      </p>
    </header>

    <div class="luxe-orn" aria-hidden="true"><span class="luxe-orn-diamond"></span></div>

    <div class="luxe-prose luxe-fade luxe-fade-2">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <p class="luxe-index-tags luxe-tags-end">{tags.join("  ·  ")}</p>
      )
    }
  </article>
</Layout>
