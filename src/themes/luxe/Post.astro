---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} — jwstn.dev`} description={description}>
  <article class="luxe-article">
    <p class="luxe-backrow luxe-fade">
      <a class="luxe-back" href="/blog">&larr; Journal</a>
    </p>

    <header class="luxe-fade">
      <p class="luxe-kicker">Essay</p>
      <h1 class="luxe-article-title">{title}</h1>
      <p class="luxe-meta">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <span>
              <span aria-hidden="true"> · </span>Revised <FormattedDate date={updatedDate} />
            </span>
          )
        }
      </p>
    </header>

    {
      heroImage && (
        <figure class="luxe-heroimg luxe-fade luxe-fade-2">
          <Image src={heroImage} alt="" width={1020} height={510} />
        </figure>
      )
    }

    <div class="luxe-prose luxe-fade luxe-fade-2">
      <Content />
    </div>
  </article>
</Layout>
