---
import { Image } from "astro:assets";
import type { GalleryProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { albums } = Astro.props as GalleryProps;
---

<Layout title="Gallery | jwstn.dev" description="Pictures by JW.">
  <h1>Pictures of JW</h1>
  <p class="stub-muted">
    On my trip to Japan in March 2026 I bought a camera — here are some pictures I took with it.
  </p>
  <ul class="stub-list">
    {
      albums.map((album) => (
        <li>
          <a href={`/gallery/${album.data.slug}/`}>
            <strong>{album.data.title}</strong>
          </a>
          <div class="stub-grid">
            {album.data.photos.slice(0, 4).map((photo) => (
              <img src={photo.image.src} alt={photo.title} loading="lazy" />
            ))}
          </div>
        </li>
      ))
    }
  </ul>
</Layout>
