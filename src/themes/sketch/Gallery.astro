---
import type { GalleryProps } from "#/themes/types";
import Doodle from "./Doodle.astro";
import RefPrint from "./RefPrint.astro";
import Layout from "./Layout.astro";

const { albums } = Astro.props as GalleryProps;
---
<Layout
  title="Gallery | jwstn.dev"
  description="Reference prints from Cologne walks, spring blossoms and a Japan 2026 camera trip — taped into the sketchbook as the film comes back."
>
  <article>
    <header class="sk-page-head">
      <p class="sk-kicker">sheet 04 · the camera roll</p>
      <h1 class="sk-title">
        Reference prints
        <Doodle name="underline" draw class="sk-doodle-underline" />
      </h1>
      <p class="sk-hand sk-page-hand">
        cologne walks, blossoms, and a japan 2026 roll — printed and taped in as they develop.
      </p>
    </header>

    <ul class="sk-albums">
      {
        albums.map((album, i) => {
          const cover = album.data.photos[0];
          return (
            <li>
              <a class="sk-album-link" href={`/gallery/${album.data.slug}/`}>
                {cover ? (
                  <RefPrint
                    image={cover.image}
                    alt={`Cover of the album "${album.data.title}" — ${cover.title}`}
                    refLabel={`ALBUM ${String(i + 1).padStart(2, "0")}`}
                    title={album.data.title}
                    caption={`${album.data.photos.length} prints inside`}
                    tape={i % 2 === 0}
                    widths={[480, 800]}
                    sizes="(min-width: 72rem) 22rem, (min-width: 40rem) 42vw, 88vw"
                  />
                ) : (
                  <span class="sk-hand sk-hand-red">{album.data.title} — an empty mat, for now</span>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </article>
</Layout>
