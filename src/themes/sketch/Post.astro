---
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Doodle from "./Doodle.astro";
import RefPrint from "./RefPrint.astro";
import Layout from "./Layout.astro";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---
<Layout title={`${title} | jwstn.dev`} description={description}>
  <article class="sk-article">
    <a class="sk-back" href="/blog">← back to the pin board</a>

    <header class="sk-article-head sk-woobble">
      <p class="sk-margin-note" aria-hidden="true">first pass — be gentle</p>
      <p class="sk-kicker">notebook sheet</p>
      <h1 class="sk-title">
        {title}
        <Doodle name="underline" draw class="sk-doodle-underline" />
      </h1>
      <p class="sk-article-lede">{description}</p>

      <dl class="sk-titleblock">
        <div>
          <dt>pinned</dt>
          <dd><FormattedDate date={pubDate} /></dd>
        </div>
        {updatedDate && (
          <div>
            <dt>re-sketched</dt>
            <dd>
              <FormattedDate date={updatedDate} />
            </dd>
          </div>
        )}
      </dl>
    </header>

    {
      heroImage && (
        <RefPrint
          image={heroImage}
          alt={title}
          refLabel="REF 00"
          loading="eager"
          widths={[480, 800, 1200]}
          sizes="(min-width: 48rem) 40rem, 92vw"
        />
      )
    }

    <div class="sk-article-body sk-woobble sk-ruled sk-prose">
      <Content />
    </div>

    <p class="sk-fin">— pinned. that's the whole note.</p>
  </article>
</Layout>
