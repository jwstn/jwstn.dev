---
import { SOCIALS } from "#/lib/content";
import MetaTags from "#/themes/shared/MetaTags.astro";
import ThemeSwitcher from "#/themes/shared/ThemeSwitcher.astro";
import type { LayoutProps } from "#/themes/types";
import "./theme.css";

const { title, description } = Astro.props as LayoutProps;
const year = new Date().getFullYear();

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const nav = [
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/gallery", label: "Gallery" },
];
---
<html lang="en" class="theme-sketch">
  <head>
    <MetaTags title={title} description={description} />
  </head>
  <body>
    <a class="sk-skip" href="#sk-main">Skip to content</a>

    <header class="sk-header">
      <a class="sk-logo" href="/">jwstn.dev</a>
      <nav class="sk-nav" aria-label="Main">
        {
          nav.map((item) => (
            <a
              class="sk-nav-link"
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
        {
          SOCIALS.map((s) => (
            <a class="sk-nav-link sk-nav-social" href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="sk-main" id="sk-main">
      <slot />
    </main>

    <footer class="sk-footer">
      <div class="sk-footer-block sk-woobble">
        <p class="sk-footer-copy">
          © {year} jwstn
          <span class="sk-footer-hand">— drawn, hatched &amp; taped in cologne.</span>
        </p>
        <ul class="sk-footer-list">
          {
            SOCIALS.map((s) => (
              <li>
                <a class="sk-footer-link" href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="sk-footer-rev">REV A · SHEETS 01–04 · NOT TO SCALE</p>
      </div>
    </footer>

    <ThemeSwitcher />
  </body>
</html>
