---
import FormattedDate from "#/components/FormattedDate.astro";
import type { BlogProps } from "#/themes/types";
import Doodle from "./Doodle.astro";
import Layout from "./Layout.astro";

const { posts } = Astro.props as BlogProps;
---
<Layout
  title="Blog | jwstn.dev"
  description="JW's pin board — notes and post ideas, still being sketched. Nothing pinned to the board yet."
>
  <article>
    <header class="sk-page-head">
      <p class="sk-kicker">sheet 03 · the pin board</p>
      <h1 class="sk-title">
        Notes
        <Doodle name="underline" draw class="sk-doodle-underline" />
      </h1>
      <p class="sk-hand sk-page-hand">
        ideas get sketched here before they're allowed anywhere near production.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <section class="sk-empty sk-woobble sk-woobble-dashed" aria-labelledby="sk-empty-title">
          <span class="sk-empty-corners" aria-hidden="true" />
          <p class="sk-kicker">reserved — sheet pending</p>
          <h2 id="sk-empty-title" class="sk-empty-title">
            To be drawn.
          </h2>
          <p class="sk-hand sk-hand-red sk-empty-hand">
            nothing pinned to this board yet. the first post exists, technically — as a rough sketch on a
            napkin somewhere in this flat.
          </p>
          <Doodle name="scribble" class="sk-doodle-scribble sk-empty-scribble" />
        </section>
      ) : (
        <ol class="sk-posts">
          {posts.map((post) => (
            <li>
              <article class="sk-postcard">
                <h2>
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p class="sk-postcard-meta">
                  <span class="sk-meta">
                    <FormattedDate date={post.data.pubDate} />
                  </span>
                  {post.data.updatedDate && (
                    <span class="sk-meta">re-sketched <FormattedDate date={post.data.updatedDate} /></span>
                  )}
                </p>
                <p class="sk-postcard-desc">{post.data.description}</p>
              </article>
            </li>
          ))}
        </ol>
      )
    }
  </article>
</Layout>
