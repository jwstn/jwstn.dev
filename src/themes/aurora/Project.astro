---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { project, Content } = Astro.props as ProjectProps;
const { title, description, pubDate, href, tags } = project.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <article class="aurora-article">
    <a class="aurora-back" href="/projects" aria-label="Back to all projects">← All projects</a>

    <div class="glass aurora-panel rise d1">
      <p class="aurora-kicker">Project</p>
      <h1 class="aurora-h1">{title}</h1>
      <p class="aurora-lede">{description}</p>
      <p class="aurora-meta">
        <FormattedDate date={pubDate} />
        <a href={href} target="_blank" rel="noopener noreferrer">Visit the project ↗</a>
      </p>
      <ul class="aurora-chips">
        {tags.map((tag) => (
          <li class="aurora-chip">{tag}</li>
        ))}
      </ul>
      <hr class="aurora-prose-hr" />
      <div class="aurora-prose">
        <Content />
      </div>
    </div>
  </article>
</Layout>
