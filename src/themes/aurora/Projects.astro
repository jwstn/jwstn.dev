---
import FormattedDate from "#/components/FormattedDate.astro";
import type { ProjectsProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { projects } = Astro.props as ProjectsProps;
---

<Layout
  title="Projects | jwstn.dev"
  description="Things JW has built — web apps, a terminal UI and desktop experiments."
>
  <section class="aurora-article">
    <p class="aurora-kicker rise d1">Work</p>
    <h1 class="aurora-h1 rise d2">Projects</h1>
    <p class="aurora-lede rise d3">
      Four builds, each one a different kind of weather. Some are finished enough to share, some are
      still very much in motion — all of them taught me something.
    </p>
  </section>

  <ul class="aurora-grid">
    {
      projects.map((project, i) => (
        <li class="glass lift aurora-card rise" class:list={["d1", "d2", "d3", "d4"][i % 4]}>
          <h2>
            <a class="aurora-card-link" href={`/projects/${project.id}/`}>
              {project.data.title}
            </a>
          </h2>
          <p class="aurora-card-desc">{project.data.description}</p>
          <p class="aurora-meta">
            <FormattedDate date={project.data.pubDate} />
            <a href={project.data.href} target="_blank" rel="noopener noreferrer">
              Visit ↗
            </a>
          </p>
          <ul class="aurora-chips">
            {project.data.tags.map((tag) => (
              <li class="aurora-chip">{tag}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</Layout>
