---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { GalleryProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { albums } = Astro.props as GalleryProps;
---

<Layout
  title="Gallery | jwstn.dev"
  description="Photographs by JW — from a Japan trip in 2026 to the seasons back home in Germany."
>
  <section class="aurora-article">
    <p class="aurora-kicker rise d1">Pictures</p>
    <h1 class="aurora-h1 rise d2">Gallery</h1>
    <p class="aurora-lede rise d3">
      In March 2026 I travelled to Japan and came home with a camera. It hasn't really been put down
      since — these albums are what the lens has been up to.
    </p>
  </section>

  <ul class="aurora-grid">
    {
      albums.map((album, i) => (
        <li class="glass lift aurora-card rise" class:list={["d1", "d2", "d3"][i % 3]}>
          {album.data.photos[0] && (
            <div class="aurora-cover-frame">
              <Image
                src={album.data.photos[0].image}
                alt=""
                widths={[480, 800, 1200]}
                sizes="(min-width: 66rem) 20rem, (min-width: 40rem) 42vw, 90vw"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <h2>
            <a class="aurora-card-link" href={`/gallery/${album.data.slug}/`}>
              {album.data.title}
            </a>
          </h2>
          <p class="aurora-meta">
            <FormattedDate date={album.data.pubDate} />
            <span>
              {album.data.photos.length} photograph{album.data.photos.length === 1 ? "" : "s"}
            </span>
          </p>
        </li>
      ))
    }
  </ul>
</Layout>
