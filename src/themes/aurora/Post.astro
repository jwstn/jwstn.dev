---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <article class="aurora-article">
    <a class="aurora-back" href="/blog" aria-label="Back to all posts">← All posts</a>

    <div class="glass aurora-panel rise d1">
      <p class="aurora-kicker">Blog</p>
      <h1 class="aurora-h1">{title}</h1>
      <p class="aurora-meta">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <span>
              — last updated <FormattedDate date={updatedDate} />
            </span>
          )
        }
      </p>
      {
        heroImage && (
          <div class="glass aurora-heroimg">
            <Image src={heroImage} alt="" width={1020} height={510} decoding="async" />
          </div>
        )
      }
      <div class="aurora-prose">
        <Content />
      </div>
    </div>
  </article>
</Layout>
