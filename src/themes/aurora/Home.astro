---
import type { HomeProps } from "#/themes/types";
import Layout from "./Layout.astro";

Astro.props as HomeProps;

const links = [
  {
    href: "/projects",
    title: "Projects",
    desc: "Four builds, all alive in one way or another — a vinyl collectors' forum, a terminal Spotify client, a sign-language trainer, and one very personal note app.",
  },
  {
    href: "/blog",
    title: "Blog",
    desc: "The quiet channel. Nothing published yet — the first notes are still drifting in over the horizon.",
  },
  {
    href: "/gallery",
    title: "Gallery",
    desc: "Japan 2026, a German summer, and a spring full of blossoms — photographs kept behind glass.",
  },
];
---

<Layout
  title="jwstn.dev — JW, full-stack developer in Cologne"
  description="JW builds web applications with TanStack, experiments with Effect, and takes his camera everywhere — most recently to Japan."
>
  <section class="aurora-hero">
    <p class="aurora-kicker rise d1">JW · full-stack developer · Cologne</p>
    <h1 class="aurora-h1 rise d2">Hi, I'm JW. I build calm software under changing skies.</h1>
    <p class="aurora-hero-text rise d3">
      Most of my days go into web applications with
      <a href="https://tanstack.com/" target="_blank" rel="noopener noreferrer">TanStack</a> — it covers
      so much of what a modern app needs that backend frameworks like
      <a href="https://hono.dev/" target="_blank" rel="noopener noreferrer">Hono</a> and
      <a href="https://elysiajs.com/" target="_blank" rel="noopener noreferrer">Elysia</a> are still
      waiting their turn on my shelf. What I did get around to is
      <a href="https://effect.website/" target="_blank" rel="noopener noreferrer">Effect</a> — and it's
      been the most fun I've had in a while relearning how a program can be written. When the keyboard
      rests, the camera comes out: in March 2026 I took one to Japan and came home with far too many
      photographs and no regrets.
    </p>
    <div class="aurora-actions rise d4">
      <a class="aurora-btn aurora-btn-primary" href="/projects">Explore projects</a>
      <a class="aurora-btn" href="/gallery">Browse the gallery</a>
    </div>
  </section>

  <section aria-label="Explore the site">
    <ul class="aurora-grid">
      {
        links.map((link, i) => (
          <li class="glass lift aurora-card rise" class:list={["d1", "d2", "d3"][i]}>
            <h2>
              <a class="aurora-card-link" href={link.href}>
                {link.title}
              </a>
            </h2>
            <p class="aurora-card-desc">{link.desc}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
