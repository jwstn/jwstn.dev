---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <div class="sur-shell sur-stack">
    <p class="sur-backrow sur-rise">
      <a class="sur-btn sur-btn--ghost" href="/blog/">← The empty room</a>
    </p>

    <article class="sur-article">
      <header class="sur-article-header">
        <p class="sur-kicker sur-rise">Wing II <em>— a recovered manuscript</em></p>
        <h1 class="sur-article-title sur-rise sur-rise--2">{title}</h1>
        <div class="sur-meta-row sur-rise sur-rise--3">
          <span class="sur-plate">Recovered <FormattedDate date={pubDate} /></span>
          {
            updatedDate && (
              <span class="sur-plate">
                Dreamed again <FormattedDate date={updatedDate} />
              </span>
            )
          }
        </div>
        {
          description && (
            <p class="sur-note sur-rise sur-rise--3">
              <strong>Abstract, as remembered</strong>
              {description}
            </p>
          )
        }
      </header>

      {
        heroImage && (
          <div class="sur-heroimg-frame sur-rise sur-rise--3">
            <Image
              src={heroImage}
              alt={`Cover image for ${title}`}
              widths={[800, 1024, 1280]}
              sizes="(min-width: 72rem) 46rem, 92vw"
              loading="lazy"
              decoding="async"
            />
          </div>
        )
      }

      <div class="sur-prose sur-rise sur-rise--4">
        <Content />
      </div>

      <div class="sur-actions">
        <a class="sur-btn sur-btn--ghost" href="/blog/">← Back to the room</a>
      </div>
    </article>
  </div>
</Layout>
