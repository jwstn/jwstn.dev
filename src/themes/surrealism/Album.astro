---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { AlbumProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { album } = Astro.props as AlbumProps;
const { title, photos, pubDate } = album.data;
const plateNo = (i: number) =>
  `Plate ${["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"][i] ?? String(i + 1)}`;
---

<Layout
  title={`${title} | jwstn.dev`}
  description={`${title} — ${photos.length} windows cut by JW's camera, hung together on one wall.`}
>
  <div class="sur-shell sur-stack">
    <p class="sur-backrow sur-rise">
      <a class="sur-btn sur-btn--ghost" href="/gallery/">← Back to the wing</a>
    </p>

    <div class="sur-pagehead sur-rise sur-rise--2">
      <p class="sur-kicker">Wing III <em>— a single wall of windows</em></p>
      <h1 class="sur-pagehead-title">{title}</h1>
      <p class="sur-pagehead-meta">
        Hung <FormattedDate date={pubDate} /> · {photos.length}
        {photos.length === 1 ? "window" : "windows"} · each frame straightens when you look at it
        directly
      </p>
    </div>

    <ul class="sur-wall" aria-label="Photographs">
      {
        photos.map((photo, i) => {
          const ratio = photo.image.width / photo.image.height;
          const isWide = ratio >= 1.6;
          return (
            <li class:list={[isWide && "sur-frame--wide"]}>
              <figure class:list={["sur-frame", "sur-rise", i % 3 === 1 && "sur-rise--2", i % 3 === 2 && "sur-rise--3"]}>
                <div class="sur-mat">
                  <Image
                    src={photo.image}
                    alt={photo.title}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 64rem) 28rem, (min-width: 40rem) 40vw, 88vw"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption class="sur-frameplate">
                  <span class="sur-frameplate-ref">{plateNo(i)}</span>
                  <span class="sur-frameplate-title">{photo.title}</span>
                  {photo.caption && <span class="sur-frameplate-note">{photo.caption}</span>}
                </figcaption>
              </figure>
            </li>
          );
        })
      }
    </ul>

    <p class="sur-backrow">
      <a class="sur-btn sur-btn--ghost" href="/gallery/">← The windows close behind you</a>
    </p>
  </div>
</Layout>
