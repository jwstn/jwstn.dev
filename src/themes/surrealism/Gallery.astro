---
import FormattedDate from "#/components/FormattedDate.astro";
import type { GalleryProps } from "#/themes/types";
import Layout from "./Layout.astro";

const { albums } = Astro.props as GalleryProps;
---

<Layout
  title="Gallery | jwstn.dev"
  description="Wing III of the museum — the open windows. Photographs by JW: Japan 2026, a German summer, and a spring full of blossoms."
>
  <div class="sur-shell sur-stack">
    <div class="sur-pagehead sur-rise">
      <p class="sur-kicker">Wing III <em>— the open windows</em></p>
      <h1 class="sur-pagehead-title">Gallery</h1>
      <p class="sur-pagehead-meta">
        {albums.length}
        {albums.length === 1 ? "window" : "windows"} hung on the wall
      </p>
    </div>

    <p class="sur-lede sur-rise sur-rise--2">
      In March 2026 I went to Japan with a camera, and it never quite came home the same. These are
      the windows it has cut in the walls since — Cologne parks, German summers, and the occasional
      very good boy.
    </p>

    <section aria-label="Albums">
      <ul class="sur-albums">
        {
          albums.map((album, i) => (
            <li class:list={["sur-rise", i === 1 && "sur-rise--2", i === 2 && "sur-rise--3"]}>
              <a class="sur-album" href={`/gallery/${album.data.slug}/`}>
                <div class="sur-strip" aria-hidden="true">
                  {album.data.photos.slice(0, 4).map((photo) => (
                    <img
                      src={photo.image.src}
                      alt={photo.title}
                      width={photo.image.width}
                      height={photo.image.height}
                      loading="lazy"
                      decoding="async"
                    />
                  ))}
                </div>
                <div class="sur-album-info">
                  <span class="sur-plate">{album.data.photos.length} windows</span>
                  <h2 class="sur-album-title">{album.data.title}</h2>
                  <p class="sur-album-meta">
                    Hung <FormattedDate date={album.data.pubDate} />
                  </p>
                  <span class="sur-album-cta">Step through →</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
