---
import type { HomeProps } from "#/themes/types";
import Layout from "./Layout.astro";

Astro.props as HomeProps;

const rooms = [
  {
    href: "/projects/",
    wing: "Wing I",
    title: "The Exhibits",
    desc: "Four constructions, still humming softly behind the glass — a vinyl collectors' forum, a terminal Spotify client, a sign-language trainer, and one very personal note app.",
    cta: "Enter the wing →",
  },
  {
    href: "/blog/",
    wing: "Wing II",
    title: "The Empty Room",
    desc: "Nothing has been hung here yet. The words are still drying somewhere between two dreams. When one wakes up fully, it appears here first.",
    cta: "Stand in the echo →",
  },
  {
    href: "/gallery/",
    wing: "Wing III",
    title: "The Open Windows",
    desc: "Japan 2026, a German summer, and a spring full of blossoms — photographs that insist, quietly, that they are windows.",
    cta: "Look through →",
  },
];
---

<Layout
  title="jwstn.dev — JW, full-stack developer in Cologne"
  description="A small museum of JW's work: full-stack web applications built with TanStack in Cologne, experiments with Effect, and photographs carried home from Japan — arranged according to dream logic."
>
  <div class="sur-shell sur-stack">
    <section class="sur-hero" aria-label="Introduction">
      <div class="sur-sky" aria-hidden="true">
        <div class="sur-obj sur-obj--cloud">
          <div class="sur-cloud-body sur-drift" style="--dur: 14s"></div>
        </div>
        <div class="sur-obj sur-obj--disc">
          <div class="sur-skydisc-body"></div>
        </div>
        <div class="sur-obj sur-obj--eye">
          <div class="sur-eye-body sur-drift" style="--dur: 11s; --delay: 2s">
            <span class="sur-eye-iris"><span class="sur-eye-pupil"></span></span>
          </div>
        </div>
      </div>

      <div class="sur-hero-inner">
        <p class="sur-kicker sur-rise">
          The Museum of Small Impossibilities <em>— Cologne wing, open while you look</em>
        </p>
        <h1 class="sur-h1 sur-rise sur-rise--2">
          <span class="sur-word sur-word--a">i build</span>
          <span class="sur-word sur-word--b">web applications</span>
          <span class="sur-word sur-word--c">in Cologne</span>
          <span class="sur-word sur-word--d">and other</span>
          <span class="sur-word sur-word--e">impossible</span>
          <span class="sur-word sur-word--f">places.</span>
        </h1>
        <p class="sur-hero-copy sur-rise sur-rise--3">
          Full-stack developer from Cologne, Germany. Most of my waking hours go into web applications
          with <a href="https://tanstack.com/" target="_blank" rel="noopener noreferrer">TanStack</a> —
          a toolbox so complete that backend frameworks like
          <a href="https://hono.dev/" target="_blank" rel="noopener noreferrer">Hono</a> and
          <a href="https://elysiajs.com/" target="_blank" rel="noopener noreferrer">Elysia</a> are
          still waiting patiently in the corridor. The experiment that quietly rearranged the
          furniture of my mind is
          <a href="https://effect.website/" target="_blank" rel="noopener noreferrer">Effect</a> —
          the most fun I've had in a while re-imagining how a program can be written. And in March
          2026 I carried a camera through Japan; it came back changed, and the photographs now hang
          in the gallery below. Look around. The exits are marked, but no one has ever used them.
        </p>
        <div class="sur-actions sur-rise sur-rise--4">
          <a class="sur-btn" href="/projects/">Wander the exhibits →</a>
          <a class="sur-btn sur-btn--ghost" href="/gallery/">Step through the door →</a>
        </div>
      </div>

      <div class="sur-ground" aria-hidden="true">
        <div class="sur-horizon sur-horizon--gapped"></div>
        <div class="sur-horizon sur-horizon--tilt"></div>
        <div class="sur-obj sur-obj--door">
          <div class="sur-door-body sur-drift" style="--dur: 12s; --delay: 1s">
            <span class="sur-door-knob"></span>
          </div>
        </div>
        <div class="sur-obj sur-obj--fish">
          <div class="sur-fish-body sur-drift" style="--dur: 9s; --delay: 3s"></div>
        </div>
      </div>
    </section>

    <section aria-label="Wings of the museum">
      <h2 class="sur-sectionlabel">Three wings, one corridor</h2>
      <ul class="sur-rooms" style="margin-top: 1.4rem">
        {
          rooms.map((room, i) => (
            <li class:list={["sur-rise", i === 1 && "sur-rise--2", i === 2 && "sur-rise--3"]}>
              <a class="sur-room" href={room.href}>
                <span class="sur-plate sur-plate--accent">{room.wing}</span>
                <h3 class="sur-room-title">{room.title}</h3>
                <p class="sur-room-desc">{room.desc}</p>
                <span class="sur-room-cta">{room.cta}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
