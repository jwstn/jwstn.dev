---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { AlbumProps } from "#/themes/types";
import Fleuron from "./Fleuron.astro";
import Layout from "./Layout.astro";
import { roman } from "./numerals";

const { album } = Astro.props as AlbumProps;
const { title, pubDate, photos } = album.data;
---

<Layout
  title={`${title} — jwstn.dev`}
  description={`Plates from ${title} — photographs by JW, kept like an album of engravings.`}
>
  <header class="vic-pagehead">
    <p class="vic-label">Album of Plates</p>
    <h1 class="vic-display">{title}</h1>
    <p class="vic-entry-meta">
      Entered
      <span class="vic-meta-date">
        <FormattedDate date={pubDate} />
      </span>
      <span class="vic-meta-sep" aria-hidden="true">·</span>
      Comprising {roman(photos.length)} plate{photos.length === 1 ? "" : "s"}
    </p>
  </header>

  <Fleuron />

  <div class="vic-plates">
    {
      photos.map((photo, i) => (
        <figure class="vic-plate">
          <div class="vic-plate-img">
            <Image
              src={photo.image}
              alt={photo.title}
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 68rem) 66rem, (min-width: 40rem) 90vw, calc(100vw - 4.5rem)"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="vic-plate-caption">
            <span class="vic-plate-no">Plate {roman(i + 1)}.</span>
            <span class="vic-plate-title">{photo.title}</span>
            {photo.caption && <span class="vic-plate-note">{photo.caption}</span>}
          </figcaption>
        </figure>
      ))
    }
  </div>
</Layout>
