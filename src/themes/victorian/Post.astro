---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { PostProps } from "#/themes/types";
import Corners from "./Corners.astro";
import Fleuron from "./Fleuron.astro";
import Layout from "./Layout.astro";

const { post, Content } = Astro.props as PostProps;
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} — jwstn.dev`} description={description}>
  <article class="vic-frame vic-article">
    <Corners />

    <p class="vic-backrow">
      <a class="vic-back" href="/blog">&larr; Return to the Journal</a>
    </p>

    <header class="vic-article-head">
      <p class="vic-label">Journal Entry</p>
      <h1 class="vic-articletitle">{title}</h1>
      <p class="vic-entry-meta">
        Entered
        <span class="vic-meta-date">
          <FormattedDate date={pubDate} />
        </span>
        {
          updatedDate && (
            <Fragment>
              <span class="vic-meta-sep" aria-hidden="true">
                ·
              </span>
              Revised
              <span class="vic-meta-date">
                <FormattedDate date={updatedDate} />
              </span>
            </Fragment>
          )
        }
      </p>
    </header>

    {
      heroImage && (
        <figure class="vic-heroimg">
          <div class="vic-plate-img">
            <Image src={heroImage} alt="" width={1020} height={510} />
          </div>
        </figure>
      )
    }

    <div class="vic-prose">
      <Content />
    </div>

    <Fleuron class="vic-orn--end" />
  </article>
</Layout>
