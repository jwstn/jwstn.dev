---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import type { GalleryProps } from "#/themes/types";
import Fleuron from "./Fleuron.astro";
import Layout from "./Layout.astro";
import { roman } from "./numerals";

const { albums } = Astro.props as GalleryProps;
---

<Layout
  title="Gallery — jwstn.dev"
  description="Plates by JW — the Japan journey of 2026, a German summer, and the spring at home, kept like albums of engravings."
>
  <header class="vic-pagehead">
    <p class="vic-label">Third Series</p>
    <h1 class="vic-display">The Gallery of Plates</h1>
    <p class="vic-lede">
      In 2026 a camera travelled with me to Japan — and never truly went back in the bag.
      Three albums of plates follow: the journey itself, a German summer, and the spring
      that opened the year.
    </p>
  </header>

  <Fleuron />

  <ul class="vic-albums">
    {
      albums.map((album, i) => (
        <li class="vic-plate">
          <a class="vic-album-link" href={`/gallery/${album.data.slug}/`}>
            <figure>
              {album.data.photos[0] && (
                <div class="vic-plate-img vic-plate-cover">
                  <Image
                    src={album.data.photos[0].image}
                    alt={`Opening plate of the album ${album.data.title}`}
                    widths={[480, 800, 1200, 1600]}
                    sizes="(min-width: 56rem) 54rem, (min-width: 40rem) 90vw, calc(100vw - 3rem)"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <figcaption class="vic-plate-caption">
                <span class="vic-plate-no">Plate {roman(i + 1)}.</span>
                <span class="vic-plate-title">{album.data.title}</span>
                <span class="vic-plate-meta">
                  <FormattedDate date={album.data.pubDate} />
                  <span class="vic-meta-sep" aria-hidden="true">·</span>
                  Comprising {roman(album.data.photos.length)} plate
                  {album.data.photos.length === 1 ? "" : "s"}
                </span>
              </figcaption>
            </figure>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
