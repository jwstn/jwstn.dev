---
import { ArrowLeft } from "@lucide/astro";
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import Layout from "#/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

const slug = Astro.params.slug as string;
const post = (await getCollection("blog")).find((p) => p.id === slug);
if (!post) {
  return new Response("Not found", { status: 404 });
}
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <div class="iso-shell iso-stack">
    <p class="iso-backrow">
      <a class="iso-backlink" href="/blog/"><ArrowLeft size={14} /> Blog</a>
    </p>

    <article class="iso-article">
      <header>
        <p class="iso-kicker">Blog &mdash; sheet {post.id}</p>
        <h1 class="iso-article-title">{title}</h1>
        <div class="iso-meta-row">
          <span class="iso-chip">
            Plotted <FormattedDate date={pubDate} />
          </span>
          {
            updatedDate && (
              <span class="iso-chip">
                Revised <FormattedDate date={updatedDate} />
              </span>
            )
          }
        </div>
        {
          description && (
            <p class="iso-note iso-note--margin">
              <span class="iso-note-label">Abstract</span>
              {description}
            </p>
          )
        }
      </header>

      {
        heroImage && (
          <div class="iso-frame">
            <Image
              class="iso-heroimg"
              src={heroImage}
              alt={`Cover image for ${title}`}
              widths={[800, 1024, 1280]}
              sizes="(min-width: 72rem) 46rem, 92vw"
            />
          </div>
        )
      }

      <div class="iso-prose">
        <Content />
      </div>
    </article>
  </div>
</Layout>
