---
import { getPost, renderEntry } from "#/lib/content";
import { themeModule } from "#/themes/manifest";

const slug = Astro.params.slug as string;
const post = await getPost(slug);
if (!post) {
  return new Response("Not found", { status: 404 });
}
const { Content } = await renderEntry(post);
const T = themeModule(Astro.locals.theme);
---

<T.Layout title={`${post.data.title} | jwstn.dev`} description={post.data.description}>
  <T.Post post={post} Content={Content} />
</T.Layout>
