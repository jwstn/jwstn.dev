---
import Layout from "#/layouts/Layout.astro"
import { getCollection } from "astro:content"

import Card from "#/components/ui/card/index.astro"
import CardTitle from "#/components/ui/card/title.astro"
import CardHeader from "#/components/ui/card/header.astro"
import CardContent from "#/components/ui/card/content.astro"
import CardDescription from "#/components/ui/card/description.astro"
import CardFooter from "#/components/ui/card/footer.astro"

import FormattedDate from "#/components/FormattedDate.astro"
import type { length } from "astro:schema"
import { cn } from "#/lib/utils"

const projects = await getCollection("projects")
---

<Layout>
  <main class="typeset">
    <section class="space-y-8">
      {
        projects.map((project) => (
          <Card>
            <a href={`/projects/${project.id}/`} class="no-underline">
              <CardHeader>
                <CardTitle>{project.data.title}</CardTitle>
                <CardDescription>
                  <FormattedDate date={project.data.pubDate} />
                </CardDescription>
              </CardHeader>
              <CardContent>{project.data.description}</CardContent>
              <CardFooter class="flex-wrap">
                {project.data.tags.map((tag, index) => (
                  <p class="inline-flex items-center justify-center text-left mt-0 whitespace-normal">
                    {tag}
                    <span
                      class={cn("whitespace-break-spaces", {
                        hidden: index === project.data.tags.length - 1,
                      })}
                    >
                      {", "}
                    </span>
                  </p>
                ))}
              </CardFooter>
            </a>
          </Card>
        ))
      }
    </section>
  </main>
</Layout>
