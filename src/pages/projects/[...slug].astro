---
import { Icon } from "@lucide/astro";
import FormattedDate from "#/components/FormattedDate.astro";
import IsoButton from "#/components/isometric/IsoButton.astro";
import Layout from "#/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

const slug = Astro.params.slug as string;
const project = (await getCollection("projects")).find((p) => p.id === slug);
if (!project) {
  return new Response("Not found", { status: 404 });
}
const { Content } = await render(project);
const { title, description, pubDate, href, tags } = project.data;
---

<Layout title={`${title} | jwstn.dev`} description={description}>
  <div class="iso-shell iso-stack">
    <p class="iso-backrow">
      <a class="iso-backlink" href="/projects/"><Icon name="arrow-left" size={14} /> All assemblies</a>
    </p>

    <article class="iso-article">
      <header>
        <h1 class="iso-article-title">{title}</h1>
        <div class="iso-meta-row">
          <span class="iso-chip">
            <FormattedDate date={pubDate} />
          </span>
        </div>
        {
          tags.length > 0 && (
            <ul class="iso-stamps iso-meta-row" aria-label="Technologies used">
              {tags.map((tag) => (
                <li class="iso-stamp">{tag}</li>
              ))}
            </ul>
          )
        }
        {
          description && (
            <p class="iso-note iso-note--margin">
              <span class="iso-note-label">General note</span>
              {description}
            </p>
          )
        }
      </header>

      <div class="iso-prose">
        <Content />
      </div>

      <div class="iso-block-actions">
        <IsoButton href={href} external>View live assembly <Icon name="external-link" size={16} /></IsoButton>
        <a class="iso-backlink" href="/projects/"><Icon name="arrow-left" size={14} /> Back to the plan</a>
      </div>
    </article>
  </div>
</Layout>
