---
import { getProject, renderEntry } from "#/lib/content";
import { themeModule } from "#/themes/manifest";

const slug = Astro.params.slug as string;
const project = await getProject(slug);
if (!project) {
  return new Response("Not found", { status: 404 });
}
const { Content } = await renderEntry(project);
const T = themeModule(Astro.locals.theme);
---

<T.Project project={project} Content={Content} />
