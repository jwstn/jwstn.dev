---
import { Image } from "astro:assets";
import FormattedDate from "#/components/FormattedDate.astro";
import Layout from "#/layouts/Layout.astro";
import { getCollection } from "astro:content";

const albums = (await getCollection("gallery")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Gallery | jwstn.dev"
  description="Photographic plates by JW — Japan 2026, a German summer, and a spring full of blossoms."
>
  <div class="iso-shell iso-stack iso-gallery">
    <header class="iso-pagehead">
      <h1 class="iso-pagehead-title">Pictures of JW</h1>
    </header>

    <p class="iso-lede iso-rise iso-rise--2">
      On my trip to Japan in March 2026 I bought a camera since I wanted one for some years now. Here are some
      pictures I took with it.
    </p>

    <ul class="iso-albums" aria-label="Albums">
      {
        albums.map((album, i) => (
          <li class="iso-rise" class:list={[i === 1 && "iso-rise--2", i === 2 && "iso-rise--3"]}>
            <a class="iso-slab iso-album" href={`/gallery/${album.data.slug}/`}>
              <div class="iso-strip" aria-hidden="true">
                {album.data.photos.slice(0, 4).map((photo) => (
                  <Image
                    src={photo.image}
                    alt={photo.title}
                    widths={[96, 128, 160]}
                    sizes="(min-width: 48rem) 10rem, 22vw"
                    loading="lazy"
                    decoding="async"
                  />
                ))}
              </div>
              <div class="iso-album-info">
                <h2 class="iso-album-title">{album.data.title}</h2>
                <p class="iso-album-meta">
                  <FormattedDate date={album.data.pubDate} /> · {album.data.photos.length} exposures
                </p>
                <span class="iso-album-cta">Open plate →</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
