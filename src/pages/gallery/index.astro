---
import Layout from "#/layouts/Layout.astro"
import { getCollection } from "astro:content"

const gallery = (await getCollection("gallery")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
---

<Layout>
  <main class="typeset w-full max-w-7xl">
    <h1 class="text-primary">Pictures of JW</h1>
    <h4>
      On my trip to Japan in March, 2026 I bought a camera since I wanted to for
      some years now. Here are some pictures I took with it.
    </h4>
    {
      gallery.map((entry) => (
        <section>
          <a class="no-underline" href={`/gallery/${entry.data.slug}/`}>
            <h2>{entry.data.title}</h2>
            <div class="space-y-8 flex flex-row flex-wrap flex-1 gap-4">
              <figure
                style="margin-block-start: unset;"
                class="max-w-sm max-h-8/12 h-auto"
              >
                <img
                  transition:name={entry.data.photos[0].title}
                  src={entry.data.photos[0].image.src}
                  alt={entry.data.photos[0].title}
                  class="w-full rounded-lg"
                />
                <figcaption>
                  <strong>{entry.data.photos[0].title}</strong>
                  {entry.data.photos[0].caption && (
                    <p>{entry.data.photos[0].caption}</p>
                  )}
                </figcaption>
              </figure>
            </div>
          </a>
        </section>
      ))
    }
  </main>
</Layout>
